ion_DragViewV","platforms":[{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"14.0","name":"iOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"14.0","name":"iPadOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"14.0","name":"Mac Catalyst"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"11.0","name":"macOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"14.0","name":"tvOS"},{"beta":false,"deprecated":false,"unavailable":false,"introducedAt":"7.0","name":"watchOS"}],"modules":[{"relatedModules":["SwiftUICore"],"name":"Swami"}]},"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/navigationTitle(_:)-1jqpp","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"text":"Inherited from ","type":"text"},{"type":"codeVoice","code":"View.navigationTitle(_:)"},{"text":".","type":"text"}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/swami\/interaction_dragview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"title":