":"Equatable","kind":"typeIdentifier","preciseIdentifier":"s:SQ"},{"text":"\n","kind":"text"}]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"]]},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/swami\/interaction_dragview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"title":"Interaction_DragView"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/symbolEffect(_:options:value:)":{"url":"\/documentation\/swami\/interaction_dragview\/symboleffect(_:options:value:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"symbolEffect"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"U"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":", "},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SymbolEffectOptions","pre