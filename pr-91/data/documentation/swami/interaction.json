 coordinate space,","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":" — discrete pulses."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the gesture for an output you actually request is attached — so a tap-only layer"},{"type":"text","text":" "},{"type":"text","text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag"],"title":"Helpers","generated":true,"anchor":"Helpers"}],"topicSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/body(content:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/ViewModifier-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"sections":[],"metadata":{"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}],"title":"Interaction","role":"symbol","externalID":"s:5Swami11InteractionV","navigatorTitle":[{"text":"Interaction","kind":"identifier"}],"modules":[{"name":"Swami"}],"roleHeading":"Structure"},"abstract":[{"text":"SwiftUI equivalent of Origami’s ","type":"text"},{"inlineContent":[{"text":"Interaction","type":"text"}],"type":"strong"},{"text":" patch.","type":"text"}],"references":{"doc://samatwork.Swami/documentation/Swami/Drag":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drag"}],"rol