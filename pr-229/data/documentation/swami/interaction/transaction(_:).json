matwork.Swami/documentation/Swami":{"kind":"symbol","type":"topic","title":"Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection","url":"\/documentation\/swami"},"doc://samatwork.Swami/documentation/Swami/Interaction":{"navigatorTitle":[{"text":"Interaction","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swami\/interaction","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"inlineContent":[{"type":"text","text":"Interaction"}],"type":"strong"},{"type":"text","text":" patch."}],"title":"Interaction","kind":"symbol"}}}