","type":"text"},{"text":"disambiguate with the module (","type":"text"},{"code":"OrigamiPatterns.Interaction","type":"codeVoice"},{"text":") if it ever collides. This one","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t clash with anything in SwiftUI.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"composes off them, matching the graph:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"down","type":"codeVoice"},{"type":"text","text":" — "},{"code":"true","type":"codeVoice"},{"type":"text","text":" while a finger is on the layer,"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"position"},{"type":"text","text":" — the touch point, in the layer’s coordinate space,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":" — discrete pulses."}]}]}]},{"inlineContent":[{"type":"text","text":"Only the gesture for an output you actually request is attached — so a tap-only layer"},{"type":"text","text":" "},{"type":"text","text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/samatwork.Swami\/s8SendableP","doc:\/\/samatwork.Swami\/7SwiftUI12ViewModifierP"],"type":"conformsTo","kind":"relationships"}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction/ViewModifier-Implementations":{"role":"collectionGroup","type":"topic","title":"ViewModifier Implementations","