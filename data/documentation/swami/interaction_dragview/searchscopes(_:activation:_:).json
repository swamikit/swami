ext":"View","preciseIdentifier":"s:7SwiftUI4ViewP"},{"kind":"text","text":"\n"}],"languages":["swift"]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/searchScopes(_:activation:_:)","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","type":"topic","url":"\/documentation\/swami\/interaction_dragview","title":"Interaction_DragView","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"role":"symbol","kind":"symbol","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/searchScopes(_:activation:_:)":{"role":"symbol","type":"topic","title":"searchScopes(_:activation:_:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/searchScopes(_:activation:_:)","kind":"symbol","url":"\/documentation\/swami\/interaction_dragview\/searchscopes(_:activation:_:)","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"searchScopes","kind":"identifier"},{"text":"<","kind":"text"},{"text":"V","kind":"genericParameter"},{"text":", ","kind"