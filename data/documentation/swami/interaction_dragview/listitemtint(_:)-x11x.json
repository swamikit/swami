DragView","kind":"identifier"}],"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/listItemTint(_:)-x11x":{"url":"\/documentation\/swami\/interaction_dragview\/listitemtint(_:)-x11x","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/listItemTint(_:)-x11x","kind":"symbol","role":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"listItemTint"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7SwiftUI5ColorV","kind":"typeIdentifier","text":"Color"},{"kind":"text","text":"?) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"title":"listItemTint(_:)"}}}