t":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"role":"symbol","title":"Interaction_DragView","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}]}}}