xt","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"title":"Interaction_DragView","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"url":"\/documentation\/swami\/interaction_dragview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/onHover(perform:)":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/onHover(perform:)","url":"\/documentation\/swami\/interaction_dragview\/onhover(perform:)","abstract":[],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onHover","kind":"identifier"},{"text":"(","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"type":"topic","title":"onHover(perform:)"}}}