tent","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"title":"sheet(item:onDismiss:content:)","roleHeading":"Instance Method","symbolKind":"method"},"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"View.sheet(item:onDismiss:content:)"},{"type":"text","text":"."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/sheet(item:onDismiss:content:)"},"kind":"symbol","references":{"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"topic","title":"Swami","url":"\/documentation\/swami","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/sheet(item:onDismiss:content:)":{"abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/sheet(item:onDismiss:content:)","role":"symbol","title":"sheet(item:onDismiss:content:)","kind":"symbol","url":"\/documentation\/swami\/interaction_dragview\/sheet(item:o