"kind":"symbol","variants":[{"paths":["\/documentation\/swami\/interaction_dragview\/accessibilitydragpoint(_:description:isenabled:)-2okgh"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"role":"symbol","url":"\/documentation\/swami\/interaction_dragview","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","kind":"symbol","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"type":"topic","title":"Interaction_DragView"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityDragPoint(_:description:isEnabled:)-2okgh":{"title":"accessibilityDragPoint(_:description:isEnabled:)","type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibilityDragPoint(_:description:isEnabled:)-2okgh","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityDragPoint","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"UnitPoint","preciseIdentifier":"s:7SwiftUI9UnitPointV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"description","kind":"e