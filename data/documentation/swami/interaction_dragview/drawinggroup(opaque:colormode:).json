"text"}],"title":"Interaction_DragView","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","role":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/swami\/interaction_dragview","type":"topic"}}}