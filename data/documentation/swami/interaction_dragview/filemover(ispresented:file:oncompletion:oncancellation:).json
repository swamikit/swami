xt":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"text":">) -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":", ","kind":"text"},{"text":"onCancellation","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/fileMover(isPresented:file:onCompletion:onCancellation:)","role":"symbol"},"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","type":"topic","url":"\/documentation\/swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"kind":"symbol","url":"\/documentation\/swami\/interaction_dragview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"type":"topic","role":"symbol"}}}