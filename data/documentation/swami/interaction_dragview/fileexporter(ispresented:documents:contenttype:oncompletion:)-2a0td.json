text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"kind":"symbol","title":"Interaction_DragView","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami":{"type":"topic","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"url":"\/documentation\/swami","role":"collection","title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/fileExporter(isPresented:documents:contentType:onCompletion:)-2a0td":{"url":"\/documentation\/swami\/interaction_dragview\/fileexporter(ispresented:documents:contenttype:oncompletion:)-2a0td","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/fileExporter(isPresented:documents:contentType:onCompletion:)-2a0td","title":"fileExporter(isPresented:documents:contentType:onCompletion:)","fr