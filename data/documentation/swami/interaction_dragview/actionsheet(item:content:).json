esenting::actions:)`instead."},{"deprecatedAt":"100000.0","introducedAt":"13.0","beta":false,"name":"tvOS","deprecated":false,"unavailable":false,"message":"use `confirmationDialog(title:isPresented:titleVisibility:presenting:actions:)`instead."},{"deprecatedAt":"100000.0","introducedAt":"1.0","beta":false,"name":"visionOS","deprecated":false,"unavailable":false,"message":"use `confirmationDialog(title:isPresented:titleVisibility:presenting:actions:)`instead."},{"deprecatedAt":"100000.0","introducedAt":"6.0","beta":false,"name":"watchOS","deprecated":false,"unavailable":false,"message":"use `confirmationDialog(title:isPresented:titleVisibility:presenting:actions:)`instead."}],"symbolKind":"method"},"references":{"doc://samatwork.Swami/documentation/Swami":{"role":"collection","kind":"symbol","title":"Swami","type":"topic","url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/actionSheet(item:content:)":{"url":"\/documentation\/swami\/interaction_dragview\/actionsheet(item:content:)","abstract":[],"kind":"symbol","deprecated":true,"role":"symbol","title":"actionSheet(item:cont