ack to its resting position.","type":"text"}],"url":"\/documentation\/swami\/interaction_dragview","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"title":"Interaction_DragView"}}}