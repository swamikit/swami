"card snaps back to its resting position.","type":"text"}],"url":"\/documentation\/swami\/interaction_dragview","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"title":"Interaction_DragView"}}}