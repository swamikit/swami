dentifier","text":"M"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"url":"\/documentation\/swami\/interaction_dragview\/confirmationdialog(_:ispresented:titlevisibility:presenting:actions:message:)-95uv4","title":"confirmationDialog(_:isPresented:titleVisibility:presenting:actions:message:)","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/confirmationDialog(_:isPresented:titleVisibility:presenting:actions:message:)-95uv4","abstract":[]},"doc://samatwork.Swami/documentation/Swami":{"title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol","role":"collection","type":"topic","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"url":"\/documentation\/swami\/interaction_dragview","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"title":"Interaction_DragView"}}}