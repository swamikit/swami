e four rules"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami"}]}],[{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Pure value patch (Add, Transition\/interpolate, logic)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"computed property \/ expression"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Interaction (Tap, Down\/press, Double Tap, Long Press)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"gesture + ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"@GestureState","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"origami.drag","type":"codeVoice"},{"text":" — Drag","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)"},{"type":"text","text":" (helper)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"State\/memory (Switch, Sample and Hold)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"@State"},{"text":" + update logic","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Animation (Classic Animation, Pop\/Spring)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"withAnimation","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".animation(.spring)","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"type":"codeVoice","code":"View"},{"type":"text","text":" body. Origami "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means"},{"type":"text","text":" "},{"type":"text","text":"interpolation (not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier — that’s a different concept)."}]},{"anchor":"Pure-value-patch-%E2%86%92-computed-property","level":3,"type":"heading","text":"Pure value patch → computed property"},{"type":"paragraph","inlineContent":[{"code":"Add","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Transition\/interpolate","type":"codeVoice"},{"text":", and other pure-function patches carry no state.","type":"text"},{"text":" ","type":"text"},{"text":"They fan an input through math and emit an output. In SwiftUI that’s a computed","type":"text"},{"text":" ","type":"text"},{"text":"property (or an inline expression) — no ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":", no side effect.","type":"text"}]},{"anchor":"Interaction-%E2%86%92-gesture-+-State","level":3,"type":"heading","text":"Interaction → gesture + `@State`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"type":"codeVoice","code":"down"},{"type":"text","text":", "},{"type":"codeVoice","code":"position"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"onTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" or fires a callback. The "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}]},{"anchor":"Statememory-%E2%86%92-State-+-update-logic","level":3,"type":"heading","text":"State\/memory → `@State` + update logic"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Switch"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Sample and Hold"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"type":"codeVoice","code":".onChange"},{"text":", or an assignment inside a ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" block)."}]},{"anchor":"Animation-%E2%86%92-withAnimation--animation","level":3,"type":"heading","text":"Animation → `withAnimation` \/ `.animation`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Pop Animation"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" or an ","type":"text"},{"type":"codeVoice","code":".animation(_:value:)"},{"text":" modifier on the animated property.","type":"text"},{"text":" ","type":"text"},{"text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged","type":"text"},{"text":" ","type":"text"},{"text":"by the parser — Swami won’t fake them.","type":"text"}]},{"anchor":"Flag-dont-fake","level":2,"type":"heading","text":"Flag, don’t fake"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,"},{"type":"text","text":" "},{"type":"text","text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over"},{"type":"text","text":" "},{"type":"text","text":"it. The current list: continuous-time springs, custom JavaScript patches,"},{"type":"text","text":" "},{"type":"text","text":"absolute-position layout."}]}]}],"sections":[],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","title":"Interaction","type":"topic","abstract":[{"text":"SwiftUI equivalent of Origami’s ","type":"text"},{"type":"strong","inlineContent":[{"text":"Interaction","type":"text"}]},{"text":" patch.","type":"text"}],"url":"\/documentation\/swami\/interaction"},"doc://samatwork.Swami/documentation/Swami/Beats":{"role":"article","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats","type":"topic","title":"Beats","kind":"article","url":"\/documentation\/swami\/beats","abstract":[{"type":"text","text":"The four-beat discipline that keeps the translator honest: one pattern per branch,"},{"type":"text","text":" "},{"type":"text","text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship"},{"type":"text","text":" "},{"type":"text","text":"only on Reviewer approval plus a human spot-check."}]},"doc://samatwork.Swami/documentation/Swami":{"url":"\/documentation\/swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that