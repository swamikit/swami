{"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph."}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"seeAlsoSections":[{"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"generated":true}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/origamimappings"]}],"metadata":{"modules":[{"name":"Swami"}],"title":"Origami → SwiftUI mappings","roleHeading":"Article","role":"article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI are both reactive dataflow, so the translator"},{"type":"text","text":" "},{"type":"text","text":"targets SwiftUI’s "},{"type":"emphasis","inlineContent":[{"text":"state graph","type":"text"}]},{"type":"text","text":" — computed properties, "},{"code":"@State","type":"codeVoice"},{"type":"text","text":", "},{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"not imperative functions. Each row below is a rule the codegen applies; the helper"},{"text":" ","type":"text"},{"text":"library (","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","isActive":true,"type":"reference"},{"text":", …) fills the gaps where a patch has no direct","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI equivalent.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"The-four-rules","type":"heading","text":"The four rules"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami"}]}],[{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Pure value patch (Add, Transition\/interpolate, logic)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"computed property \/ expression","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Interaction (Tap, Down\/press, Double Tap, Long Press)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"gesture + "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"@GestureState"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"origami.drag","type":"codeVoice"},{"type":"text","text":" — Drag"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)"},{"type":"text","text":" (helper)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"State\/memory (Switch, Sample and Hold)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"@State","type":"codeVoice"},{"text":" + update logic","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Animation (Classic Animation, Pop\/Spring)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".animation(.spring)"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"type":"codeVoice","code":"View"},{"type":"text","text":" body. Origami "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means"},{"type":"text","text":" "},{"type":"text","text":"interpolation (not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier — that’s a different concept)."}]},{"type":"heading","text":"Pure value patch → computed property","anchor":"Pure-value-patch-%E2%86%92-computed-property","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Add"},{"type":"text","text":", "},{"type":"codeVoice","code":"Transition\/interpolate"},{"type":"text","text":", and other pure-function patches carry no state."},{"type":"text","text":" "},{"type":"text","text":"They fan an input through math and emit an output. In SwiftUI that’s a computed"},{"type":"text","text":" "},{"type":"text","text":"property (or an inline expression) — no "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", no side effect."}]},{"type":"heading","text":"Interaction → gesture + `@State`","anchor":"Interaction-%E2%86%92-gesture-+-State","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"code":"down","type":"codeVoice"},{"type":"text","text":", "},{"code":"position","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"onTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onDoubleTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onLongPress","type":"codeVoice"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" or fires a callback. The "},{"isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference"},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}]},{"type":"heading","text":"State\/memory → `@State` + update logic","anchor":"Statememory-%E2%86%92-State-+-update-logic","level":3},{"type":"paragraph","inlineContent":[{"code":"Switch","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Sample and Hold","type":"codeVoice"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"code":".onChange","type":"codeVoice"},{"text":", or an assignment inside a ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" block).","type":"text"}]},{"type":"heading","text":"Animation → `withAnimation` \/ `.animation`","anchor":"Animation-%E2%86%92-withAnimation--animation","level":3},{"type":"paragraph","inlineContent":[{"code":"Classic Animation","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Pop Animation","type":"codeVoice"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" or an ","type":"text"},{"code":".animation(_:value:)","type":"codeVoice"},{"text":" modifier on the animated property.","type":"text"},{"text":" ","type":"text"},{"text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged","type":"text"},{"text":" ","type":"text"},{"text":"by the parser — Swami won’t fake them.","type":"text"}]},{"type":"heading","text":"Flag, don’t fake","anchor":"Flag-dont-fake","level":2},{"type":"paragraph","inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}]}],"kind":"content"}],"references":{"doc://samatwork.Swami/documentation/Swami":{"url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"role":"collection","title":"Swami","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction":{"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","navigatorTitle":[{"text":"Interaction","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"text":"SwiftUI equivalent of Origami’s ","type":"text"},{"inlineContent":[{"type":"text","text":"Interaction"}],"type":"strong"},{"text":" patch.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}],"url":"\/documentation\/swami\/interaction","title":"Interaction"},"doc://samatwork.Swami/documentation/Swami/Drag":{"title":"Drag","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","abstract":[{"text":"SwiftUI equivalent of Origami’s ","type":"text"},{"inlineContent":[{"text":"Drag","type":"text"}],"type":"strong"},{"text":" patch (","type"