property \/ expression"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interaction (Tap, Down\/press, Double Tap, Long Press)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"gesture + "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"@GestureState","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"State\/memory (Switch, Sample and Hold)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"@State","type":"codeVoice"},{"type":"text","text":" + update logic"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Animation (Classic Animation, Pop\/Spring)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".animation(.spring)"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"type":"codeVoice","code":"View"},{"type":"text","text":" body. Origami "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means"},{"type":"text","text":" "},{"type":"text","text":"interpolation (not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier — that’s a different concept)."}]},{"type":"heading","level":3,"anchor":"Pure-value-patch-%E2%86%92-computed-property","text":"Pure value patch → computed property"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Add"},{"type":"text","text":", "},{"type":"codeVoice","code":"Transition\/interpolate"},{"type":"text","text":", and other pure-function patches carry no state."},{"type":"text","text":" "},{"type":"text","text":"They fan an input through math and emit an output. In SwiftUI that’s a computed"},{"type":"text","text":" "},{"type":"text","text":"property (or an inline expression) — no "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", no side effect."}]},{"type":"heading","level":3,"anchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"code":"down","type":"codeVoice"},{"type":"text","text":", "},{"code":"position","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"onTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onDoubleTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onLongPress","type":"codeVoice"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" or fires a callback. The "},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true,"type":"reference"},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}]},{"type":"heading","level":3,"anchor":"Statememory-%E2%86%92-State-+-update-logic","text":"State\/memory → `@State` + update logic"},{"type":"paragraph","inlineContent":[{"code":"Switch","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Sample and Hold","type":"codeVoice"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"code":".onChange","type":"codeVoice"},{"text":", or an assignment inside a ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" block)."}]},{"level":3,"anchor":"Animation-%E2%86%92-withAnimation--animation","type":"heading","text":"Animation → `withAnimation` \/ `.animation`"},{"inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":", and other animation patches drive a value"},{"type":"text","text":" "},{"type":"text","text":"toward a target over time. In SwiftUI, that’s a state change wrapped in"},{"type":"text","text":" "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".animation(_:value:)"},{"type":"text","text":" modifier on the animated property."},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}],"type":"paragraph"},{"level":2,"anchor":"Flag-dont-fake","type":"heading","text":"Flag, don’t fake"},{"inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Article","modules":[{"name":"Swami"}],"role":"article","title":"Origami → SwiftUI mappings"},"kind":"article","seeAlsoSections":[{"generated":true,"title":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"anchor":"Reference"}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction":{"url":"\/documentation\/swami\/interaction","type":"topic","role":"symbol","kind":"symbol","title":"Interaction","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"text":"Interaction","type":"text"}]},{"type":"text","text":" patch."}],"navigatorTitle":[{"text":"Interaction","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Drag":{"url":"\/documentation\/swami\/drag","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"inlineContent":[{"text":"Drag","type":"text"}],"type":"strong"},{"type":"text","text":" patch ("},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":")."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drag","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Drag","kind":"identifier"}],"kind":"symbol","title":"Drag"},"doc://samatwork.Swami/documentation/Swami/Beats":{"title":"Beats","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats","url":"\/documentation\/swami\/beats","abstract":[{"type":"text","text":"The four-beat discipline that keeps the translator honest: one pattern per branch,"},{"type":"text","text":" "},{"type":"text","text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship"},{"type":"text","text":" "},{"type":"text","text":"only on Reviewer approval plus a human spot-check."}],"role":"article","kind":"article"},"doc://samatwork.Swami/documentation/Swami":{"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"title":"Swami","url":"\/documentation\/swami","role":"collection","kind":"symbol"}}}