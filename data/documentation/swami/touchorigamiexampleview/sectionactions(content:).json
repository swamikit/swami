amatwork.Swami/documentation/Swami":{"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"title":"Swami","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection","type":"topic","url":"\/documentation\/swami"},"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView":{"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TouchOrigamiExampleView","kind":"identifier"}],"title":"TouchOrigamiExampleView","url":"\/documentation\/swami\/touchorigamiexampleview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView","kind":"symbol","navigatorTitle":[{"text":"TouchOrigamiExampleView","kind":"identifier"}],"abstract":[{"type":"text","text":"Artboard 1 → Group (vertical stack of cards)."}]}}}