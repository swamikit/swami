"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Naming (ADR-0010): helpers are named after the Origami "},{"type":"emphasis","inlineContent":[{"text":"patch","type":"text"}]},{"type":"text","text":", bare (no prefix) —"},{"type":"text","text":" "},{"type":"text","text":"disambiguate with the module ("},{"type":"codeVoice","code":"OrigamiPatterns.Interaction"},{"type":"text","text":") if it ever collides. This one"},{"type":"text","text":" "},{"type":"text","text":"doesn’t clash with anything in SwiftUI."}],"type":"paragraph"},{"inlineContent":[{"text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"composes off them, matching the graph:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"down","type":"codeVoice"},{"text":" — ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" while a finger is on the layer,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"position","type":"codeVoice"},{"type":"text","text":" — the touch point, in the layer’s coordinate space,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onTap"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"onDoubleTap"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"onLongPress"},{"text":" — discrete pulses.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Only the gesture for an output you actually request is attached — so a tap-only layer"},{"type":"text","text":" "},{"type":"text","text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean."}],"type":"paragraph"}]}],"references":{"doc://samatwork.Swami/documentation/Swami/Drag":{"type":"topic","kind":"symbol","url":"\/documentation\/swami\/drag","role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","title":"Drag","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drag","kind":"identifier"}],"abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"inlineContent":[{"text":"Drag","type":"text"}],"type":"strong"},{"type":"text","text":" patch ("},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":")."}],"navigatorTitle":[{"text":"Drag","kind":"identifier"}]},"doc://samatwork.Swami/7SwiftUI12ViewModifierP":{"type":"unresolvable","title":"SwiftUICore.ViewModifier","identifier":"doc:\/\/samatwork.Swami\/7SwiftUI12ViewModifierP"},"doc://samatwork.Swami/documentation/Swami/Interaction/ViewModifier-Implementations":{"abstract":[],"title":"ViewModifier Implementations","type":"topic","kind":"article","url":"\/documentation\/swami\/interaction\/viewmodifier-implementations","role":"collectionGroup","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/ViewModifier-Implementations"},"doc://samatwork.Swami/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/samatwork.Swami\/s8SendableP"},"doc://samatwork.Swami/documentation/Swami/Interaction":{"url":"\/documentation\/swami\/interaction","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"inlineContent":[{"text":"Interaction","type":"text"}],"type":"strong"},{"type":"text","text":" patch."}],"role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","title":"Interaction","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction"}]},"doc://samatwork.Swami/documentation/Swami/Interaction/body(content:)":{"kind":"symbol","url":"\/documentation\/swami\/interaction\/body(content:)","role":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"body"},{"kind":"text","text":"("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI12ViewModifierP7Contenta","text":"Content"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"title":"body(content:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/body(content:)","type":"topic"},"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"title":"Swami","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection","type":"topic","url":"\/documentation\/swami"}}}