"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Naming (ADR-0010): helpers are named after the Origami "},{"type":"emphasis","inlineContent":[{"type":"text","text":"patch"}]},{"type":"text","text":", bare (no prefix) —"},{"type":"text","text":" "},{"type":"text","text":"disambiguate with the module ("},{"type":"codeVoice","code":"OrigamiPatterns.Interaction"},{"type":"text","text":") if it ever collides. This one"},{"type":"text","text":" "},{"type":"text","text":"doesn’t clash with anything in SwiftUI."}]},{"type":"paragraph","inlineContent":[{"text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"composes off them, matching the graph:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"down"},{"type":"text","text":" — "},{"type":"codeVoice","code":"true"},{"type":"text","text":" while a finger is on the layer,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"position"},{"type":"text","text":" — the touch point, in the layer’s coordinate space,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":" — discrete pulses."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the gesture for an output you actually request is attached — so a tap-only layer"},{"type":"text","text":" "},{"type":"text","text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean."}]}]}],"references":{"doc://samatwork.Swami/7SwiftUI12ViewModifierP":{"identifier":"doc:\/\/samatwork.Swami\/7SwiftUI12ViewModifierP","title":"SwiftUICore.ViewModifier","type":"unresolvab