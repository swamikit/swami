ew","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"kind":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibility(activationPoint:)-8r8b9":{"abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibility(activationPoint:)-8r8b9","type":"topic","role":"symbol","deprecated":true,"kind":"symbol","title":"accessibility(activationPoint:)","url":"\/documentation\/swami\/interaction_dragview\/accessibility(activationpoint:)-8r8b9","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibility","kind":"identifier"},{"text":"(","kind":"text"},{"text":"activationPoint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UnitPoint","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI9UnitPointV"},{"text":") -> ","kind":"text"},{"text":"ModifiedContent","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI15ModifiedContentV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AccessibilityAttachmentModifier","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI31AccessibilityAttachmentModifierV"},{"text":">","kind":"text"}]},"doc://samatwork.Swami/documentation/Swami":{"url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"role":"collection","type":"topic","title":"Swami"}}}