{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"metadata":{"modules":[{"name":"Swami"}],"role":"article","roleHeading":"Article","title":"Origami → SwiftUI reference"},"sections":[],"abstract":[{"text":"What each Origami patch becomes in SwiftUI, so you know which construct — or which","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","isActive":true,"type":"reference"},{"text":" helper — to reach for.","type":"text"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/origamimappings"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI both describe how values flow and change over"},{"type":"text","text":" "},{"type":"text","text":"time, so the translations map onto SwiftUI’s own tools: computed properties for"},{"type":"text","text":" "},{"type":"text","text":"pure math, gestures and "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" for interaction, "},{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" for motion. Most"},{"type":"text","text":" "},{"type":"text","text":"patches land on a native SwiftUI construct. A few need a helper from the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"},{"type":"text","text":" "},{"type":"text","text":"library, named after the patch it stands in for."}],"type":"paragraph"},{"text":"Patch → SwiftUI","anchor":"Patch-%E2%86%92-SwiftUI","type":"heading","level":2},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Origami patch"}],"type":"paragraph"}],[{"inlineContent":[{"text":"SwiftUI","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Pure value patch (Add, interpolate, logic)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"computed property \/ expression (native)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Interaction (Tap, Press, Double Tap, Long Press)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"gesture + ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" via ","type":"text"},{"code":"View\/interaction(down:position:onTap:onDoubleTap:onLongPress:)","type":"codeVoice"},{"text":" (helper)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"origami.Drag"},{"text":" — Drag","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)"},{"text":" (helper)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Magnification \/ Pinch","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MagnifyGesture"},{"text":" (native)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"origami.PopSwitch","type":"codeVoice"},{"text":" — Pop Switch","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"@State"},{"type":"text","text":" flipped on a threshold, "},{"type":"codeVoice","code":".spring"},{"type":"text","text":" pop (native)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"builtin.layer.shape"},{"type":"text","text":" — Shape (triangle)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/RoundedTriangle","isActive":true},{"type":"text","text":" (helper)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"State \/ memory (Switch, Sample and Hold)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"@State"},{"type":"text","text":" + update logic (native)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Animation (Classic Animation, Pop \/ Spring)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"withAnimation","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".animation(.spring)","type":"codeVoice"},{"text":" (native)","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"code":"View","type":"codeVoice"},{"type":"text","text":" body."}],"type":"paragraph"},{"text":"How the categories map","level":2,"type":"heading","anchor":"How-the-categories-map"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Pure value patches"}],"type":"strong"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"Add"},{"text":", interpolation, logic — carry no state. They run an","type":"text"},{"text":" ","type":"text"},{"text":"input through math and emit a result, which is exactly a computed property or an","type":"text"},{"text":" ","type":"text"},{"text":"inline expression.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Interaction","type":"text"}],"type":"strong"},{"text":" exposes discrete outputs: ","type":"text"},{"code":"down","type":"codeVoice"},{"text":", ","type":"text"},{"code":"position","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onTap","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":". Each becomes a SwiftUI gesture whose result lands in","type":"text"},{"text":" ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" or fires a callback. The ","type":"text"},{"code":".interaction(…)","type":"codeVoice"},{"text":" modifier attaches only the","type":"text"},{"text":" ","type":"text"},{"text":"recognizers you ask for, so gesture arbitration stays clean.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"State and memory","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"Switch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Sample and Hold","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Pop Switch","type":"codeVoice"},{"text":" — remember a value","type":"text"},{"text":" ","type":"text"},{"text":"between evaluations. That is what ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" is for; the update path is a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, an ","type":"text"},{"type":"codeVoice","code":".onChange"},{"text":", or an assignment.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Animation"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"Classic Animation","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Pop Animation","type":"codeVoice"},{"text":" — drives a value toward a","type":"text"},{"text":" ","type":"text"},{"text":"target over time, which is a state change wrapped in ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" or an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".animation(_:value:)"},{"type":"text","text":" modifier."}]},{"type":"paragraph","inlineContent":[{"text":"One naming note: Origami’s ","type":"text"},{"code":"Transition","type":"codeVoice"},{"text":" means ","type":"text"},{"inlineContent":[{"type":"text","text":"interpolation"}],"type":"emphasis"},{"text":" (mapping one range","type":"text"},{"text":" ","type":"text"},{"text":"onto another), not SwiftUI’s ","type":"text"},{"code":".transition()","type":"codeVoice"},{"text":" modifier for view insertion and","type":"text"},{"text":" ","type":"text"},{"text":"removal.","type":"text"}]},{"type":"heading","level":2,"anchor":"When-a-mapping-isnt-exact","text":"When a mapping isn’t exact"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some Origami semantics have no direct SwiftUI equivalent — continuous-time springs,"},{"type":"text","text":" "},{"type":"text","text":"custom JavaScript patches, absolute-position layout. Rather than approximate them"},{"type":"text","text":" "},{"type":"text","text":"silently, each translated view marks the gap with an inline "},{"type":"codeVoice","code":"TODO"},{"type":"text","text":" in its source,"},{"type":"text","text":" "},{"type":"text","text":"so the caveat travels with the code. The individual pattern pages link to the"},{"type":"text","text":" "},{"type":"text","text":"source where those notes live."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"text":"Origami patterns, rebuilt as SwiftUI you can read — each one a worked example of the","type":"text"},{"text":" ","type":"text"},{"text":"patches behind it, so you can see how a prototype’s behavior is written and reach for","type":"text"},{"text":" ","type":"text"},{"text":"the same patch on your own layers.","type":"text"}],"url":"\/documentation\/swami","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/RoundedTriangle":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RoundedTriangle"}],"navigatorTitle":[{"kind":"identifier","text":"RoundedTriangle"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/RoundedTriangle","abstract":[{"type":"text","text":"An upward-pointing triangle with uniformly rounded corners."}],"type":"topic","title":"RoundedTriangle","url":"\/documentation\/swami\/roundedtriangle"}}}