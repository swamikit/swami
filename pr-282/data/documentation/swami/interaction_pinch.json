{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"anchor":"Related-Documentation"},{"anchor":"Patterns","title":"Patterns","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"generated":true}],"metadata":{"modules":[{"name":"Swami"}],"title":"Interaction — Pinch","role":"sampleCode","roleHeading":"Sample Code"},"sampleCodeDownload":{"action":{"isActive":true,"overridingTitle":"Open in Origami","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","type":"reference"},"kind":"sampleDownload"},"sections":[],"abstract":[{"type":"text","text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a"},{"type":"text","text":" "},{"type":"text","text":"spring; pinch back in and it pops home."}],"kind":"article","identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Preview","text":"Preview","level":2},{"type":"paragraph","inlineContent":[]},{"type":"heading","anchor":"The-patch","text":"The patch","level":2},{"type":"paragraph","inlineContent":[{"text":"Origami drives this with an ","type":"text"},{"type":"codeVoice","code":"origami.PopSwitch"},{"text":" — a remembered on\/off state — flipped by","type":"text"},{"text":" ","type":"text"},{"text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight","type":"text"},{"text":" ","type":"text"},{"text":"onto native SwiftUI, which is the reusable idea worth taking away. A ","type":"text"},{"type":"codeVoice","code":"MagnifyGesture"},{"text":" ","type":"text"},{"text":"reads the pinch, a ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" flag flips at a threshold, and a ","type":"text"},{"type":"codeVoice","code":".spring"},{"text":" animates the","type":"text"},{"text":" ","type":"text"},{"text":"scale between the two states (see the State\/memory → ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" row in","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","type":"reference"},{"text":").","type":"text"}]},{"type":"codeListing","code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not"},{"type":"text","text":" "},{"type":"text","text":"a scale that tracks your fingers continuously."}]},{"type":"heading","anchor":"How-its-built","text":"How it’s built","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The full view sits the white rounded triangle on the magenta artboard and adds a live"},{"type":"text","text":" "},{"code":"@GestureState","type":"codeVoice"},{"type":"text","text":" so the shape follows your fingers mid-pinch before it settles on the"},{"type":"text","text":" "},{"type":"text","text":"popped state. Read the source (below) for the whole thing."}]},{"type":"heading","anchor":"Behavior","text":"Behavior","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pinch out on the shape to grow it; pinch in to shrink it."}]}]},{"content":[{"inlineContent":[{"text":"Cross the threshold and it snaps to the next size with a spring, rather than","type":"text"},{"text":" ","type":"text"},{"text":"tracking your fingers continuously.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The switch remembers its state, so a release between pinches holds the current size."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Downloads","text":"Downloads","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Swift sample"}],"type":"strong"},{"type":"text","text":" — "},{"identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","type":"reference","isActive":true},{"type":"text","text":" — the full source. Read it to see how the pop maps to "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" + a spring; paste it to run it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Origami source"}]},{"type":"text","text":" — "},{"isActive":true,"type":"reference","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami"},{"type":"text","text":" — the original prototype (opens in Origami Studio)."}]}]}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_pinch"]}],"references":{"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"text":"Origami patterns, rebuilt as SwiftUI you can read — each one a worked example of the","type":"text"},{"text":" ","type":"text"},{"text":"patches behind it, so you can see how a prototype’s behavior is written and reach for","type":"text"},{"text":" ","type":"text"},{"text":"the same patch on your own layers.","type":"text"}],"url":"\/documentation\/swami","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/OrigamiMappings":{"title":"Origami → SwiftUI reference","kind":"article","type":"topic","abstract":[{"text":"What each Origami patch becomes in SwiftUI, so you know which construct — or which","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","isActive":true,"type":"reference"},{"text":" helper — to reach for.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","role":"article","url":"\/documentation\/swami\/origamimappings"},"https://github.com/swamikit/swami/blob/development/app/Swami/Patterns/Interaction_Pinch.swift":{"type":"link","titleInlineContent":[{"code":"Interaction_Pinch.swift","type":"codeVoice"}],"title":"Interaction_Pinch.swift","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","url":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift"},"doc://samatwork.Swami/documentation/Swami/Interaction_Drag":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag","title":"Interaction — Drag","role":"sampleCode","url":"\/documentation\/swami\/interaction_drag","abstract":[{"text":"A card you can drag anywhere on screen. It carries momentum when you let go and","type":"text"},{"text":" ","type":"text"},{"text":"springs back from the edges.","type":"text"}],"kind":"article","type":"topic"},"https://origami.design/public/origami_files/patterns/Interaction_Pinch.origami":{"type":"download","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","checksum":null,"url":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami"}}}