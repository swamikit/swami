ntifier"}],"title":"defaultAdaptableTabBarPlacement(_:)","role":"symbol","roleHeading":"Instance Method","symbolKind":"method","extendedModule":"SwiftUICore","externalID":"s:7SwiftUI4ViewPAAE31defaultAdaptableTabBarPlacementyQrAA0efgH0VF::SYNTHESIZED::s:5Swami20Interaction_DragViewV"},"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/defaultAdaptableTabBarPlacement(_:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_dragview\/defaultadaptabletabbarplacement(_:)"]}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/defaultAdaptableTabBarPlacement(_:)":{"kind":"symbol","abstract":[],"title":"defaultAdaptableTabBarPlacement(_:)","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/defaultAdaptableTabBarPlacement(_:)","url":"\/documentation\/swami\/interaction_dragview\/defaultadaptabletabbarplacement(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultAdaptableTabBarPlacement","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7SwiftUI24AdaptableTabBarPlacementV","text":"AdaptableTabBarPlacement","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" to the layer’s transfor