d":"declarations"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/invalidatableContent(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_dragview\/invalidatablecontent(_:)"]}],"sections":[],"abstract":[{"type":"text","text":"Inherited from "},{"code":"View.invalidatableContent(_:)","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/invalidatableContent(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"invalidatableContent"},{"kind":"text","text":"("},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/invalidatableContent(_:)","role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/invalidatablecontent(_:)","kind":"symbol","type":"topic","abstract":[],"title":"invalidatableContent(_:)"},"doc://samatwork.Swami/documentation/Swami":{"url":"\/documentation\/swami","title":"Swami","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"role":"collection","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"url":"\/documentation\/swami\/interaction_dragview","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView","role":"symbol"}}}