umentation\/Swami\/Interaction_DragView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swami\/interaction_dragview","type":"topic"}}}