":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/alignmentGuide(_:computeValue:)-4ccvv":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"alignmentGuide","kind":"identifier"},{"text":"(","kind":"text"},{"text":"HorizontalAlignment","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI19HorizontalAlignmentV"},{"text":", ","kind":"text"},{"text":"computeValue","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"ViewDimensions","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI14ViewDimensionsV"},{"text":") -> ","kind":"text"},{"text":"CGFloat","kind":"typeIdentifier","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"title":"alignmentGuide(_:computeValue:)","type":"topic","kind":"symbol","url":"\/documentation\/swami\/interaction_dragview\/alignmentguide(_:computevalue:)-4ccvv","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/alignmentGuide(_:computeValue:)-4ccvv","abstract":[],"role":"symbol"},"doc://samatwork.Swami/documentation/Swami":{"role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic","kind":"symbol","url":"\/documentation\/swami","title":"Swami"}}}