":"text","text":" "},{"type":"text","text":"output "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/onKeyPress(_:phases:action:)":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/onKeyPress(_:phases:action:)","kind":"symbol","type":"topic","title":"onKeyPress(_:phases:action:)","abstract":[],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onKeyPress","kind":"identifier"},{"text":"(","kind":"text"},{"text":"KeyEquivalent","preciseIdentifier":"s:7SwiftUI13KeyEquivalentV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"phases","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"KeyPress","preciseIdentifier":"s:7SwiftUI8KeyPressV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Phases","preciseIdentifier":"s:7SwiftUI8KeyPressV6PhasesV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"action","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"KeyPress","preciseIdentifier":"s:7SwiftUI8KeyPressV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"KeyPress","preciseIdentifier":"s:7SwiftUI8KeyPressV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Result","preciseIdentifier":"s:7SwiftUI8KeyPressV6ResultO","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"url":"\/documentation\/swami\/interaction_dragview\/onkeypress(_:phases:action:)"}}}