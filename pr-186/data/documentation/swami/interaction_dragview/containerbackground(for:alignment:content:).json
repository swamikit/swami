"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/containerBackground(for:alignment:content:)"},"references":{"doc://samatwork.Swami/documentation/Swami":{"role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic","kind":"symbol","url":"\/documentation\/swami","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/containerBackground(for:alignment:content:)":{"type":"topic","kind":"symbol","title":"containerBackground(for:alignment:content:)","abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/containerBackground(for:alignment:content:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"containerBackground","kind":"identifier"},{"text":"<","kind":"text"},{"text":"V","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI28ContainerBackgroundPlacementV","text":"ContainerBackgroundPlacement","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"tex