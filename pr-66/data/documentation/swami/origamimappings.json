{"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/origamimappings"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"},"abstract":[{"text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"generated":true,"title":"Reference","anchor":"Reference"}],"metadata":{"role":"article","modules":[{"name":"Swami"}],"title":"Origami → SwiftUI mappings","roleHeading":"Article"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI are both reactive dataflow, so the translator"},{"type":"text","text":" "},{"type":"text","text":"targets SwiftUI’s "},{"type":"emphasis","inlineContent":[{"text":"state graph","type":"text"}]},{"type":"text","text":" — computed properties, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"not imperative functions. Each row below is a rule the codegen applies; the helper"},{"text":" ","type":"text"},{"text":"library (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag"},{"text":", …) fills the gaps where a patch has no direct","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI equivalent.","type":"text"}]},{"level":2,"type":"heading","anchor":"The-four-rules","text":"The four rules"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami"}]}],[{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Pure value patch (Add, Transition\/interpolate, logic)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"computed property \/ expression","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Interaction (Tap, Down\/press, Double Tap, Long Press)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"gesture + ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"@GestureState","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"State\/memory (Switch, Sample and Hold)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"@State","type":"codeVoice"},{"text":" + update logic","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Animation (Classic Animation, Pop\/Spring)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".animation(.spring)"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"The Origami layer tree becomes the SwiftUI ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" body. Origami ","type":"text"},{"code":"Transition","type":"codeVoice"},{"text":" means","type":"text"},{"text":" ","type":"text"},{"text":"interpolation (not SwiftUI’s ","type":"text"},{"code":".transition()","type":"codeVoice"},{"text":" modifier — that’s a different concept).","type":"text"}]},{"level":3,"type":"heading","anchor":"Pure-value-patch-%E2%86%92-computed-property","text":"Pure value patch → computed property"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Add"},{"type":"text","text":", "},{"type":"codeVoice","code":"Transition\/interpolate"},{"type":"text","text":", and other pure-function patches carry no state."},{"type":"text","text":" "},{"type":"text","text":"They fan an input through math and emit an output. In SwiftUI that’s a computed"},{"type":"text","text":" "},{"type":"text","text":"property (or an inline expression) — no "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", no side effect."}]},{"level":3,"type":"heading","anchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"type":"codeVoice","code":"down"},{"type":"text","text":", "},{"type":"codeVoice","code":"position"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"onTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" or fires a callback. The "},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference","isActive":true},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}]},{"level":3,"type":"heading","anchor":"Statememory-%E2%86%92-State-+-update-logic","text":"State\/memory → `@State` + update logic"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Switch"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Sample and Hold"},{"type":"text","text":" remember a value across evaluations. That’s what"},{"type":"text","text":" "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" is for. Codegen emits the state variable plus the update path (a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, a "},{"type":"codeVoice","code":".onChange"},{"type":"text","text":", or an assignment inside a "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" block)."}]},{"level":3,"type":"heading","anchor":"Animation-%E2%86%92-withAnimation--animation","text":"Animation → `withAnimation` \/ `.animation`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Pop Animation"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" or an ","type":"text"},{"type":"codeVoice","code":".animation(_:value:)"},{"text":" modifier on the animated property.","type":"text"},{"text":" ","type":"text"},{"text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged","type":"text"},{"text":" ","type":"text"},{"text":"by the parser — Swami won’t fake them.","type":"text"}]},{"level":2,"type":"heading","anchor":"Flag-dont-fake","text":"Flag, don’t fake"},{"type":"paragraph","inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}]}],"kind":"content"}],"references":{"doc://samatwork.Swami/documentation/Swami/Drag":{"navigatorTitle":[{"text":"Drag","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"text":"Drag","type":"text"}]},{"type":"text","text":" patch ("},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":")."}],"kind":"symbol","title":"Drag","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drag","kind":"identifier"}],"type":"topic","url":"\/documentation\/swami\/drag","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag"},"doc://samatwork.Swami/documentation/Swami/Interaction":{"kind":"symbol","abstract":[{"text":"SwiftUI equivalent of Origami’s ","type":"text"},{"inlineContent":[{"type":"text","text":"Interaction"}],"type":"strong"},{"text":" patch.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swami\/interaction","type":"topic","title":"Interaction","navigatorTitle":[{"text":"Interaction","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction"},"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","url":"\/documentation\/swami","title":"Swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Beats":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats","type":"topic","kind":"article","title":"Beats","role":"article","url":"\/documentation\/swami\/beats","abstract":[{"text":"The four-beat discipline that keeps the translator honest: one pattern per branch,","type":"text"},{"text":" ","type":"text"},{"text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship","type":"text"},{"text":" ","type":"text"},{"text":"only on Reviewer approval plus a human spot-check.","type":"text"}]}}}