twork.Swami\/documentation\/Swami","title":"Swami","url":"\/documentation\/swami","kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction":{"url":"\/documentation\/swami\/interaction","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Interaction"}],"kind":"symbol","title":"Interaction","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"inlineContent":[{"type":"text","text":"Interaction"}],"type":"strong"},{"type":"text","text":" patch."}]}}}