he Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"composes off them, matching the graph:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"down"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" while a finger is on the layer,","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"position","type":"codeVoice"},{"type":"text","text":" — the touch point, in the layer’s coordinate space,"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":" — discrete pulses."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Only the gesture for an output you actually request is attached — so a tap-only layer","type":"text"},{"text":" ","type":"text"},{"text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/samatwork.Swami\/s8SendableP","doc:\/\/samatwork.Swami\/7SwiftUI12ViewModifierP"],"title":"Conforms To"}],"seeAlsoSections":[{"generated":true,"anchor":"Helpers","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag"],"title":"Helpers"}],"sections":[],"abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Interaction"}]},{"type":"text","text":" patch."}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction/body(content:)":{"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/samatwork.Swami\/document