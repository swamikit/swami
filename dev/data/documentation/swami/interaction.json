rk.Swami/documentation/Swami":{"url":"\/documentation\/swami","title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection","type":"topic","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"kind":"symbol"},"doc://samatwork.Swami/7SwiftUI12ViewModifierP":{"title":"SwiftUICore.ViewModifier","type":"unresolvable","identifier":"doc:\/\/samatwork.Swami\/7SwiftUI12ViewModifierP"},"doc://samatwork.Swami/documentation/Swami/Interaction/ViewModifier-Implementations":{"role":"collectionGroup","abstract":[],"type":"topic","title":"ViewModifier Implementations","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/ViewModifier-Implementations","kind":"article","url":"\/documentation\/swami\/interaction\/viewmodifier-implementations"}}}