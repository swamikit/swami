\/swami\/touchorigamiexampleview\/toolbartitlemenu(content:)"},"doc://samatwork.Swami/documentation/Swami":{"role":"collection","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","type":"topic","kind":"symbol","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView":{"url":"\/documentation\/swami\/touchorigamiexampleview","abstract":[{"type":"text","text":"Artboard 1 → Group (vertical stack of cards)."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TouchOrigamiExampleView"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TouchOrigamiExampleView"}],"kind":"symbol","type":"topic","title":"TouchOrigamiExampleView","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView"}}}