tion/Swami":{"role":"collection","title":"Swami","kind":"symbol","type":"topic","url":"\/documentation\/swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"},"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TouchOrigamiExampleView","kind":"identifier"}],"navigatorTitle":[{"text":"TouchOrigamiExampleView","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/swami\/touchorigamiexampleview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView","title":"TouchOrigamiExampleView","abstract":[{"text":"Artboard 1 → Group (vertical stack of cards).","type":"text"}],"role":"symbol"}}}