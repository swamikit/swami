e"},{"text":" Transform Scale, and","type":"text"},{"text":" ","type":"text"},{"text":"the pop is animated with a spring. At rest a white rounded triangle sits at base","type":"text"},{"text":" ","type":"text"},{"text":"scale, centered on the magenta artboard.","type":"text"}],"type":"topic","url":"\/documentation\/swami\/interaction_pinchview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","title":"Interaction_PinchView","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}]}}}