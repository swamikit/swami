e":"origami.PopSwitch","type":"codeVoice"},{"text":" nodes that flip the shape between its base and an","type":"text"},{"text":" ","type":"text"},{"text":"enlarged state; the switch state feeds a ","type":"text"},{"code":"builtin.point3D","type":"codeVoice"},{"text":" Transform Scale, and","type":"text"},{"text":" ","type":"text"},{"text":"the pop is animated with a spring. At rest a white rounded triangle sits at base","type":"text"},{"text":" ","type":"text"},{"text":"scale, centered on the magenta artboard.","type":"text"}],"type":"topic","url":"\/documentation\/swami\/interaction_pinchview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","title":"Interaction_PinchView","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}]}}}