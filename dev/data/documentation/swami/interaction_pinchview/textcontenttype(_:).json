ntTypeyQrSo06UITexteF0aSgF::SYNTHESIZED::s:5Swami21Interaction_PinchViewV","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"textContentType"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@UITextContentType","text":"UITextContentType"},{"kind":"text","text":"?) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"roleHeading":"Instance Method"},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"type":"topic","url":"\/documentation\/swami\/interaction_pinchview","kind":"symbol","title":"Interaction_PinchView","abstract":[{"type":"text","text":"Pinch to scale a shape. A "},{"type":"codeVoice","code":"MagnifyGesture"},{"type":"text","text":" (Origami’s magnification\/pinch input)"},{"type":"text","text":" "},{"type":"text","text":"drives two "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" nodes that flip the shape between its base and an"},{"type":"text","text":" "},{"type":"text","text":"enlarged state; the switch state feeds a "},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":" Transform Scale, and"},{"type":"text","text":" "},{"type":"text","text":"the pop is animated with a spring. At rest a white rounded triangle sits at base"},{"type":"text","text":" "},{"type":"text","text":"scale, centered on the magenta artboard."}],"role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/textContentType(_:)":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/textContentType(_:)","kind":