terfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/touchorigamiexampleview"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView"},"sections":[],"kind":"symbol","references":{"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView/View-Implementations":{"url":"\/documentation\/swami\/touchorigamiexampleview\/view-implementations","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView\/View-Implementations","type":"topic","role":"collectionGroup","title":"View Implementations","abstract":[],"kind":"article"},"doc://samatwork.Swami/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/samatwork.Swami\/s8SendableP","type":"unresolvable"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"title":"Interaction_DragView","role":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","type":"topic","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"kind":"symbol","url":"\/documentation\/swami\/interaction_dragview"},"doc://samatwork.Swami/7SwiftUI4ViewP":{"title":"SwiftUICore.View","identifier":"doc:\/\/samatwork.Swami\/7SwiftUI4ViewP","type":"unresolvable"},"doc://samatwork