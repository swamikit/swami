{"abstract":[{"type":"text","text":"Touch outputs — down, position, tap, double-tap, long-press — wired straight into your"},{"type":"text","text":" "},{"type":"text","text":"view’s state. Origami’s "},{"type":"codeVoice","code":"origami.Interaction"},{"type":"text","text":" patch, as a SwiftUI modifier."}],"metadata":{"modules":[{"name":"Swami"}],"title":"Interaction","roleHeading":"Article","role":"article"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"code":".interaction(…)","type":"codeVoice"},{"type":"text","text":" attaches only the gesture for each output you pass, so a tap-only layer"},{"type":"text","text":" "},{"type":"text","text":"carries just a tap recognizer, with no stray drag to fight it. "},{"code":"down","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" while a"},{"type":"text","text":" "},{"type":"text","text":"finger is on the layer, "},{"code":"position","type":"codeVoice"},{"type":"text","text":" is the touch point in the layer’s own coordinate space,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"onTap","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"onDoubleTap","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"onLongPress","type":"codeVoice"},{"type":"text","text":" fire once on that gesture."}],"type":"paragraph"},{"type":"codeListing","code":["Circle()","    .interaction(down: $isPressed, position: $touch, onTap: { pop() })"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The full signature and every parameter live on the modifier itself:"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/interaction(down:position:onTap:onDoubleTap:onLongPress:)"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","variants":[{"paths":["\/documentation\/swami\/interactionpatc