{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Origami’s patch graph and SwiftUI both describe how values flow and change over","type":"text"},{"text":" ","type":"text"},{"text":"time, so the translations map onto SwiftUI’s own tools: computed properties for","type":"text"},{"text":" ","type":"text"},{"text":"pure math, gestures and ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" for interaction, ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" for motion. Most","type":"text"},{"text":" ","type":"text"},{"text":"patches land on a native SwiftUI construct. A few need a helper from the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"},{"text":" ","type":"text"},{"text":"library, named after the patch it stands in for.","type":"text"}]},{"anchor":"Patch-%E2%86%92-SwiftUI","text":"Patch → SwiftUI","type":"heading","level":2},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami patch"}]}],[{"inlineContent":[{"text":"SwiftUI","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Pure value patch (Add, interpolate, logic)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"computed property \/ expression (native)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Interaction (Tap, Press, Double Tap, Long Press)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"gesture + "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" via "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true},{"type":"text","text":" (helper)"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":" — Drag"}],"type":"paragraph"}],[{"