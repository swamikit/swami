e":"text"},{"type":"codeVoice","code":"@State"},{"type":"text","text":" is for; the update path is a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, an "},{"type":"codeVoice","code":".onChange"},{"type":"text","text":", or an assignment."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Animation"}]},{"text":" — ","type":"text"},{"type":"codeVoice","code":"Classic Animation"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Pop Animation"},{"text":" — drives a value toward a","type":"text"},{"text":" ","type":"text"},{"text":"target over time, which is a state change wrapped in ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" or an","type":"text"},{"text":" ","type":"text"},{"code":".animation(_:value:)","type":"codeVoice"},{"type":"text","text":" modifier."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"One naming note: Origami’s "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means "},{"type":"emphasis","inlineContent":[{"type":"text","text":"interpolation"}]},{"type":"text","text":" (mapping one range"},{"type":"text","text":" "},{"type":"text","text":"onto another), not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier for view insertion and"},{"type":"text","text":" "},{"type":"text","text":"removal."}],"type":"paragraph"},{"text":"When a mapping isn’t exact","anchor":"When-a-mapping-isnt-exact","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Some Origami semantics have no direct SwiftUI equivalent — continuous-time springs,"},{"type":"text","text":" "},{"type":"text","text":"custom JavaScript patches, absolute-position layout. Rather than approximate them"},{"type":"text","text":" "},{"type":"text","text":"silently, each translated view marks the gap with an inline "},{"type":"codeVoice","code":"TODO"},{"type":"text","text":" in its source,"},{"type":"text","text":" "},{"type":"text","text":"so the caveat travels with the code. The individual pattern pages link to the"},{"type":"text","text":" "},{"type":"text","text":"source where those notes live."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","modules":[{"name":"Swami"}],"title":"Origami to SwiftUI reference","roleHeading":"Article"},"kind":"article","sections":[],"references":{"doc://samatwork.Swami/documentation/Swami":{"url":"\/documentation\/swami","kind":"symbol","title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection","type":"topic","abstract":[{"type":"text","text":"Origami patterns, rebuilt as SwiftUI you can read — each one a worked example of the"},{"text":" ","type":"text"},{"text":"patches behind it, so you can see how a prototype’s behavior is written and reach for","type":"text"},{"text":" ","type":"text"},{"text":"the same patch on your own layers.","type":"text"}]},"doc://samatwork.Swami/documentation/Swami/RoundedTriangle":{"type":"topic","title":"RoundedTriangle","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/RoundedTriangle","abstract":[{"type":"text","text":"An upward-pointing triangle with uniformly rounded corners."}],"url":"\/documentation\/swami\/roundedtriangle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RoundedTriangle","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"RoundedTriangle","kind":"identifier"}]}}}