pe":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State and memory"}]},{"text":" — ","type":"text"},{"type":"codeVoice","code":"Switch"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Sample and Hold"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Pop Switch"},{"text":" — remember a value","type":"text"},{"text":" ","type":"text"},{"text":"between evaluations. That is what ","type":"text"},{"type":"codeVoice","code":"@State"},{"type":"text","text":" is for; the update path is a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, an "},{"code":".onChange","type":"codeVoice"},{"type":"text","text":", or an assignment."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Animation"}]},{"text":" — ","type":"text"},{"type":"codeVoice","code":"Classic Animation"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Pop Animation"},{"text":" — drives a value toward a","type":"text"},{"text":" ","type":"text"},{"text":"target over time, which is a state change wrapped in ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" or an","type":"text"},{"text":" ","type":"text"},{"code":".animation(_:value:)","type":"codeVoice"},{"text":" modifier.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One naming note: Origami’s "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means "},{"type":"emphasis","inlineContent":[{"type":"text","text":"interpolation"}]},{"type":"text","text":" (mapping one range"},{"type":"text","text":" "},{"type":"text","text":"onto another), not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier for view insertion and"},{"type":"text","text":" "},{"type":"text","text":"removal."}]},{"type":"heading","level":2,"anchor":"When-a-mapping-isnt-exact","text":"When a mapping isn’t exact"},{"type":"paragraph","inlineContent"