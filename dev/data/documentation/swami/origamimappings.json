type":"text","text":"gesture + "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"@GestureState","type":"codeVoice"}]}]],[[{"inlineContent":[{"code":"origami.drag","type":"codeVoice"},{"type":"text","text":" — Drag"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)"},{"type":"text","text":" (helper)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"State\/memory (Switch, Sample and Hold)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"@State"},{"type":"text","text":" + update logic"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Animation (Classic Animation, Pop\/Spring)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"withAnimation","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".animation(.spring)","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"The Origami layer tree becomes the SwiftUI ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" body. Origami ","type":"text"},{"code":"Transition","type":"codeVoice"},{"text":" means","type":"text"},{"text":" ","type":"text"},{"text":"interpolation (not SwiftUI’s ","type":"text"},{"code":".transition()","type":"codeVoice"},{"text":" modifier — that’s a different concept).","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Pure-value-patch-%E2%86%92-computed-property","level":3,"text":"Pure value patch → computed property"},{"type":"paragraph","inlineContent":[{"code":"Add","type":"codeVoice"},{"type":"text","text":", "},{"code":"Transition\/interpolate","type":"codeVoice"},{"type":"text","text":", and other pure-function patches carry no state."},{"type":"text","text":" "},{"type":"text","text":"They fan an input through math and emit an output. In SwiftUI that’s a computed"},{"type":"text","text":" "},{"type":"text","text":"property (or an inline expression) — no "},{"code":"@State","type":"codeVoice"},{"type":"text","text":", no side effect."}]},{"type":"heading","anchor":"Interaction-%E2%86%92-gesture-+-State","level":3,"text":"Interaction → gesture + `@State`"},{"type":"paragraph","inlineContent":[{"text":"Origami’s Interaction patch exposes discrete output ports: ","type":"text"},{"code":"down","type":"codeVoice"},{"text":", ","type":"text"},{"code":"position","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"onTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":". Each maps to a SwiftUI gesture recognizer","type":"text"},{"text":" ","type":"text"},{"text":"whose output lands in ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" or fires a callback. The ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true,"type":"reference"},{"text":" helper","type":"text"},{"text":" ","type":"text"},{"text":"attaches only the recognizer for each output the caller requests, which keeps","type":"text"},{"text":" ","type":"text"},{"text":"gesture arbitration clean.","type":"text"}]},{"type":"heading","anchor":"Statememory-%E2%86%92-State-+-update-logic","level":3,"text":"State\/memory → `@State` + update logic"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Switch"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Sample and Hold"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"type":"codeVoice","code":".onChange"},{"type":"text","text":", or an assignment inside a "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" block)."}]},{"type":"heading","anchor":"Animation-%E2%86%92-withAnimation--animation","level":3,"text":"Animation → `withAnimation` \/ `.animation`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":", and other animation patches drive a value"},{"type":"text","text":" "},{"type":"text","text":"toward a target over time. In SwiftUI, that’s a state change wrapped in"},{"type":"text","text":" "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".animation(_:value:)"},{"type":"text","text":" modifier on the animated property."},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}]},{"type":"heading","anchor":"Flag-dont-fake","level":2,"text":"Flag, don’t fake"},{"type":"paragraph","inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}]}],"kind":"content"}],"metadata":{"title":"Origami → SwiftUI mappings","roleHeading":"Article","role":"article","modules":[{"name":"Swami"}]},"seeAlsoSections":[{"anchor":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"generated":true,"title":"Reference"}],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"How Swami translates the four kinds