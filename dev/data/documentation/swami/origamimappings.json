{"variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Origami’s patch graph and SwiftUI are both reactive dataflow, so the translator","type":"text"},{"text":" ","type":"text"},{"text":"targets SwiftUI’s ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"state graph","type":"text"}]},{"text":" — computed properties, ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":", ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"not imperative functions. Each row below is a rule the codegen applies; the helper","type":"text"},{"type":"text","text":" "},{"type":"text","text":"library ("},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","isActive":true},{"type":"text","text":", …) fills the gaps where a patch has no direct"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI equivalent."}]},{"text":"The four rules","level":2,"type":"heading","anchor":"The-four-rules"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Pure value patch (Add, Transition\/interpolate, logic)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"computed property \/ expression","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interaction (Tap, Down\/press, Double Tap, Long Press)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"gesture + "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"@GestureState"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"origami.drag"},{"type":"text","text":" — Drag"}]}],[{"type":"paragraph","inlineContent":[{"code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)","type":"codeVoice"},{"text":" (helper)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"State\/memory (Switch, Sample and Hold)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@State"},{"type":"text","text":" + update logic"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Animation (Classic Animation, Pop\/Spring)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".animation(.spring)"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The Origami layer tree becomes the SwiftUI ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" body. Origami ","type":"text"},{"code":"Transition","type":"codeVoice"},{"text":" means","type":"text"},{"text":" ","type":"text"},{"text":"interpolation (not SwiftUI’s ","type":"text"},{"code":".transition()","type":"codeVoice"},{"text":" modifier — that’s a different concept).","type":"text"}]},{"text":"Pure value patch → computed property","level":3,"type":"heading","anchor":"Pure-value-patch-%E2%86%92-computed-property"},{"type":"paragraph","inlineContent":[{"code":"Add","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Transition\/interpolate","type":"codeVoice"},{"text":", and other pure-function patches carry no state.","type":"text"},{"text":" ","type":"text"},{"text":"They fan an input through math and emit an output. In SwiftUI that’s a computed","type":"text"},{"text":" ","type":"text"},{"text":"property (or an inline expression) — no ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":", no side effect.","type":"text"}]},{"text":"Interaction → gesture + `@State`","level":3,"type":"heading","anchor":"Interaction-%E2%86%92-gesture-+-State"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"type":"codeVoice","code":"down"},{"type":"text","text":", "},{"type":"codeVoice","code":"position"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"onTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" or fires a callback. The "},{"isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference"},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}]},{"text":"State\/memory → `@State` + update logic","level":3,"type":"heading","anchor":"Statememory-%E2%86%92-State-+-update-logic"},{"type":"paragraph","inlineContent":[{"code":"Switch","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Sample and Hold","type":"codeVoice"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"code":".onChange","type":"codeVoice"},{"text":", or an assignment inside a ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" block)."}]},{"level":3,"type":"heading","text":"Animation → `withAnimation` \/ `.animation`","anchor":"Animation-%E2%86%92-withAnimation--animation"},{"inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Pop Animation"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" or an ","type":"text"},{"type":"codeVoice","code":".animation(_:value:)"},{"text":" modifier on the animated property.","type":"text"},{"text":" ","type":"text"},{"text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged","type":"text"},{"text":" ","type":"text"},{"text":"by the parser — Swami won’t fake them.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Flag, don’t fake","anchor":"Flag-dont-fake"},{"inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","title":"Origami → SwiftUI mappings","modules":[{"name":"Swami"}]},"seeAlsoSections":[{"title":"Reference","generated":true,"anchor":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"]}],"abstract":[{"type":"text","text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph."}],"kind":"article","hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"references":{"doc://samatwork.Swami/documentation/Swami/Drag":{"url":"\/documentation\/swami\/drag","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drag"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Drag"}],"title":"Drag","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Drag"}]},{"type":"text","text":" patch ("},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":")."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","type":"topic"},"doc://samatwork.Swami/documentation/Swami":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","title":"Swami","type":"topic","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}]},"doc://samatwork.Swami/documentation/Swami/Interaction":{"navigatorTitle":[{"kind":"identifier","text":"Interaction"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","title":"Interaction","url":"\/documentation\/swami\/interaction","type":"topic","abstract":[{"text":"SwiftUI equivalent of Origami’s ","type":"text"},{"inlineContent":[{"type":"text","text":"Interaction"}],"type":"strong"},{"text":" patch.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction"}],"kind":"symbol","role":"symbol"},"doc://samatwork.Swami/documentation/Swami/Beats":{"role":"article","kind":"article","type":"topic","abstract":[{"text":"The four-beat discipline that keeps the translator honest: one pattern per branch,","type":"text"},{"text":" ","type":"text"},{"text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship","type":"text"},{"text":" ","type":"text"},{"text":"only on Reviewer approval plus a human spot-check.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats","url":"\/documentation\/swami\/beats","title":"Beats"}}}