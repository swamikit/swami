ntation\/Swami\/Interaction_DragView","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"url":"\/documentation\/swami\/interaction_dragview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/contextMenu(menuItems:preview:)":{"role":"symbol","type":"topic","abstract":[],"title":"contextMenu(menuItems:preview:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/contextMenu(menuItems:preview:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contextMenu","kind":"identifier"},{"text":"<","kind":"text"},{"text":"M","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"P","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"menuItems","kind":"externalParam"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"M"},{"kind":"text","text":", "},{"kind":"externalParam","text":"preview"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"P"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"url":"\/documentation\/swami\/interaction_dragview\/contextmenu(menuitems:preview:)"},"doc://samatwork.Swami/documentation/Swami":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"type":"codeVoice","code":".origami"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"kind":"symbol","url":"\/documentation\/swami","role":"collection","type":"topic"}}}