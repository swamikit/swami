ied against","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"role":"collection","type":"topic","url":"\/documentation\/swami","kind":"symbol","title":"Swami"}}}