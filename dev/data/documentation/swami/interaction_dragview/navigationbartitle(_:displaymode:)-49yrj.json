 resting position.","type":"text"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/navigationBarTitle(_:displayMode:)-49yrj":{"title":"navigationBarTitle(_:displayMode:)","url":"\/documentation\/swami\/interaction_dragview\/navigationbartitle(_:displaymode:)-49yrj","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"navigationBarTitle","kind":"identifier"},{"text":"(","kind":"text"},{"text":"LocalizedStringKey","preciseIdentifier":"s:7SwiftUI18LocalizedStringKeyV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"displayMode","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"NavigationBarItem","preciseIdentifier":"s:7SwiftUI17NavigationBarItemV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"TitleDisplayMode","preciseIdentifier":"s:7SwiftUI17NavigationBarItemV16TitleDisplayModeO","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"abstract":[],"deprecated":true,"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/navigationBarTitle(_:displayMode:)-49yrj","kind":"symbol","role":"symbol"}}}