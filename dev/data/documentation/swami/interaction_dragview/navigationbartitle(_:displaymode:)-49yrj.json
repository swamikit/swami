i":{"role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","url":"\/documentation\/swami","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/navigationBarTitle(_:displayMode:)-49yrj":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/navigationBarTitle(_:displayMode:)-49yrj","title":"navigationBarTitle(_:displayMode:)","type":"topic","deprecated":true,"url":"\/documentation\/swami\/interaction_dragview\/navigationbartitle(_:displaymode:)-49yrj","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"navigationBarTitle"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"LocalizedStringKey","preciseIdentifier":"s:7SwiftUI18LocalizedStringKeyV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"displayMode"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"NavigationBarItem","preciseIdentifier":"s:7SwiftUI17NavigationBarItemV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"TitleDisplayMode","preciseIdentifier":"s:7SwiftUI17NavigationBarItem