pe":"text","text":"card responds to touch input via Origami’s "},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"url":"\/documentation\/swami\/interaction_dragview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/previewLayout(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"previewLayout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"PreviewLayout","kind":"typeIdentifier","preciseIdentifier":"s:21DeveloperToolsSupport13PreviewLayoutO"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"type":"topic","abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/previewlayout(_:)","kind":"symbol","title":"previewLayout(_:)","role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/previewLayout(_:)"}}}