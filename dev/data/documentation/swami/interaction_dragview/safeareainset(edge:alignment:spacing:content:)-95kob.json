":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami","kind":"symbol","title":"Swami","type":"topic","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/safeAreaInset(edge:alignment:spacing:content:)-95kob":{"url":"\/documentation\/swami\/interaction_dragview\/safeareainset(edge:alignment:spacing:content:)-95kob","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/safeAreaInset(edge:alignment:spacing:content:)-95kob","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"safeAreaInset","kind":"identifier"},{"text":"<","kind":"text"},{"text":"V","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"edge","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"VerticalEdge","preciseIdentifier":"s:7SwiftUI12VerticalEdgeO","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alignment","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"HorizontalAlignment","preciseIdentifier":"s:7SwiftUI19HorizontalAlignmentV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"spacing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"CGFloat","preciseIdentifier":"s:14CoreFoundation7CGFloatV","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"}