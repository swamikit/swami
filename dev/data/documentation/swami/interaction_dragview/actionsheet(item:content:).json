ecatedAt":"100000.0"},{"name":"tvOS","deprecated":false,"introducedAt":"13.0","unavailable":false,"message":"use `confirmationDialog(title:isPresented:titleVisibility:presenting:actions:)`instead.","beta":false,"deprecatedAt":"100000.0"},{"name":"visionOS","deprecated":false,"introducedAt":"1.0","unavailable":false,"message":"use `confirmationDialog(title:isPresented:titleVisibility:presenting:actions:)`instead.","beta":false,"deprecatedAt":"100000.0"},{"name":"watchOS","deprecated":false,"introducedAt":"6.0","unavailable":false,"message":"use `confirmationDialog(title:isPresented:titleVisibility:presenting:actions:)`instead.","beta":false,"deprecatedAt":"100000.0"}],"extendedModule":"SwiftUICore"},"references":{"doc://samatwork.Swami/documentation/Swami":{"role":"collection","kind":"symbol","type":"topic","title":"Swami","url":"\/documentation\/swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/actionSheet(item:content:)":{"type":"topic","role":"symbol","abstract":[],"kind":"symbol","title":"actionSheet(item:content:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag