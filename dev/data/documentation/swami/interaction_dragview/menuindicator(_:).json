ard responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_dragview"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/menuIndicator(_:)":{"role":"symbol","abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/menuindicator(_:)","title":"menuIndicator(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"menuIndicator"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI10VisibilityO","text":"Visibility"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/menuIndicator(_:)","type":"topic","kind":"symbol"}}}