ext":" : ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI10ShapeStyleP","text":"ShapeStyle","kind":"typeIdentifier"},{"text":"\n","kind":"text"}]}],"kind":"declarations"}],"sections":[],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_dragview","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/foregroundStyle(_:_:_:)":{"abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/foregroundStyle(_:_:_:)","type":"topic","role":"symbol","title":"foregroundStyle(_:_:_:)","url":"\/documentation\/swami\/interaction_dragview\/foregroundstyle(_:_:_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"foregroundStyle"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S1"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"S2"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"S3"},{"kind":"text","text":">("},{"kind":"