ami/documentation/Swami/Interaction_DragView":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Interaction_DragView"}],"role":"symbol","kind":"symbol","url":"\/documentation\/swami\/interaction_dragview"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/previewContext(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"previewContext","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"type":"topic","abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/previewContext(_:)","role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/previewcontext(_:)","kind":"symbol","title":"previewContext(_:)"}}}