i patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","kind":"symbol","type":"topic","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityShowsLargeContentViewer()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityShowsLargeContentViewer","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibilityShowsLargeContentViewer()","abstract":[],"kind":"symbol","type":"topic","title":"accessibilityShowsLargeContentViewer()","url":"\/documentation\/swami\/interaction_dragview\/accessibilityshowslargecontentviewer()","role":"symbol"}}}