"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"url":"\/documentation\/swami\/interaction_dragview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView"}}}