,{"kind":"identifier","text":"Interaction_DragView"}],"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"url":"\/documentation\/swami\/interaction_dragview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/contentMargins(_:_:for:)-1fs7f":{"role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contentMargins","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Edge","preciseIdentifier":"s:7SwiftUI4EdgeO","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Set","preciseIdentifier":"s:7SwiftUI4EdgeO3SetV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"EdgeInsets","preciseIdentifier":"s:7SwiftUI10EdgeInsetsV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ContentMarginPlacement","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI22ContentMarginPlacementV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"title":"contentMargins(_:_:for:)","kind":"symbol","abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/contentMargins(_:_:for:)-1fs7f","url":"\/documentation\/swami\/interaction_dragview\/contentmargins(_:_:for:)-1fs7f"},"doc://samatwork.Swami/documentation/Swami":{"url":"\/documentation\/swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","kind":"symbol","type":"topic","role":"collection"}}}