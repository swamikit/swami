ype":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}]}}}