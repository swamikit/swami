atch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"kind":"symbol","role":"symbol","url":"\/documentation\/swami\/interaction_dragview","title":"Interaction_DragView","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/menuOrder(_:)":{"url":"\/documentation\/swami\/interaction_dragview\/menuorder(_:)","title":"menuOrder(_:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"menuOrder"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI9MenuOrderV","text":"MenuOrder"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/menuOrder(_:)","abstract":[]}}}