type":"text","text":"card snaps back to its resting position."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swami\/interaction_dragview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"}}}