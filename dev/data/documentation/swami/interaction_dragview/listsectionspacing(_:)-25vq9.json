t","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"kind":"symbol","role":"symbol","url":"\/documentation\/swami\/interaction_dragview","title":"Interaction_DragView","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/listSectionSpacing(_:)-25vq9":{"type":"topic","abstract":[],"kind":"symbol","role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/listSectionSpacing(_:)-25vq9","url":"\/documentation\/swami\/interaction_dragview\/listsectionspacing(_:)-25vq9","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"listSectionSpacing","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7SwiftUI18ListSectionSpacingV","text":"ListSectionSpacing","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"title":"listSectionSpacing(_:)"}}}