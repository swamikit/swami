":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"]]},"sections":[],"references":{"doc://samatwork.Swami/documentation/Swami":{"role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","url":"\/documentation\/swami","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/onKeyPress(_:phases:action:)":{"title":"onKeyPress(_:phases:action:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/onKeyPress(_:phases:action:)","abstract":[],"kind":"symbol","role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/onkeypress(_:phases:action:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onKeyPress"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"KeyEquivalent","preciseIdentifier":"s:7SwiftUI13KeyEquivalentV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"phases"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"KeyPress","preciseIdentifier":"s:7SwiftUI8KeyPr