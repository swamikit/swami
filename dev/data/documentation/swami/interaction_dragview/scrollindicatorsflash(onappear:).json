modules":[{"relatedModules":["SwiftUICore"],"name":"Swami"}],"role":"symbol","roleHeading":"Instance Method","platforms":[{"beta":false,"introducedAt":"17.0","deprecated":false,"unavailable":false,"name":"iOS"},{"beta":false,"introducedAt":"17.0","deprecated":false,"unavailable":false,"name":"iPadOS"},{"beta":false,"introducedAt":"17.0","deprecated":false,"unavailable":false,"name":"Mac Catalyst"},{"name":"macOS","unavailable":false,"deprecated":false,"introducedAt":"14.0","beta":false},{"name":"tvOS","unavailable":false,"deprecated":false,"introducedAt":"17.0","beta":false},{"name":"watchOS","unavailable":false,"deprecated":false,"introducedAt":"10.0","beta":false}],"extendedModule":"SwiftUICore"},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","url":"\/documentation\/swami\/interaction_dragview","role":"symbol","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"type":"topic","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/scrollIndicatorsFlash(onAppear:)":{"url":"\/documentation\/swami\/interaction_dragview\/scrollindicatorsflash(onappear:)","type":"topic","kind":"symbol","role":"symbol","title":"scrollIndicatorsFlash(onAppear:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scrollIndicatorsFlash","kind":"identifier"},{"text":"(","kind":"text"},{"text":"onAppear","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/scrollIndicatorsFlash(onAppear:)"},"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"role":"collection","url":"\/documentation\/swami","title":"Swami"}}}