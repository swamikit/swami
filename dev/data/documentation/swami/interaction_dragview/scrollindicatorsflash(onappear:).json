nAppear:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"nonisolated"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scrollIndicatorsFlash"},{"kind":"text","text":"("},{"kind":"externalParam","text":"onAppear"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"},{"kind":"text","text":"\n"}]}]}],"references":{"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"title":"Swami","kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/scrollIndicatorsFlash(onAppear:)":{"kind":"symbol","url":"\/documentation\/swami\/interaction_dragview\/scrollindicatorsflash(onappear:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Inter