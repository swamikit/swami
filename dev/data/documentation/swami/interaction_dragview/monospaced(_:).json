ragView","kind":"symbol","role":"symbol","url":"\/documentation\/swami\/interaction_dragview","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"type":"codeVoice","code":"origami.Drag"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/monospaced(_:)":{"title":"monospaced(_:)","url":"\/documentation\/swami\/interaction_dragview\/monospaced(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"monospaced"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/monospaced(_:)","type":"topic","role":"symbol","kind":"symbol","abstract":[]}}}