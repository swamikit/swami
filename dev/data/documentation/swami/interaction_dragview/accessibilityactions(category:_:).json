,"text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"kind":"symbol","role":"symbol","url":"\/documentation\/swami\/interaction_dragview","title":"Interaction_DragView","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityActions(category:_:)":{"kind":"symbol","abstract":[],"title":"accessibilityActions(category:_:)","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibilityActions(category:_:)","url":"\/documentation\/swami\/interaction_dragview\/accessibilityactions(category:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityActions","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"category","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AccessibilityActionCategory","preciseIdentifier":"s:7SwiftUI27AccessibilityActionCategoryV","kind":"typeIdentifier"},{"text":", () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"role":"symbol"},"doc://samatwork.Swami/documentation/Swami":{"url":"\/documentation\/swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic","title":"Swami","kind":"symbol","role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"}}}