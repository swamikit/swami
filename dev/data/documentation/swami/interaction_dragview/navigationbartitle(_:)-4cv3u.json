ck to its resting position."}],"kind":"symbol","title":"Interaction_DragView","role":"symbol","type":"topic","url":"\/documentation\/swami\/interaction_dragview","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}]}}}