":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami","title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/keyboardShortcut(_:modifiers:localization:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyboardShortcut"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"KeyEquivalent","preciseIdentifier":"s:7SwiftUI13KeyEquivalentV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"modifiers"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EventModifiers","preciseIdentifier":"s:7SwiftUI14EventModifiersV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"localization"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"KeyboardShortcut","preciseIdentifier":"s:7SwiftUI16KeyboardShortcutV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Localization","preciseIdentifier":"s:7SwiftUI16KeyboardShortcutV12LocalizationV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/keyboardshortcut(_:modifi