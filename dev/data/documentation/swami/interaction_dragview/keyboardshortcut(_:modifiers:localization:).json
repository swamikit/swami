cumentation\/Swami\/Interaction_DragView","title":"Interaction_DragView","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Interaction_DragView"}],"role":"symbol","kind":"symbol","url":"\/documentation\/swami\/interaction_dragview"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/keyboardShortcut(_:modifiers:localization:)":{"kind":"symbol","role":"symbol","abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/keyboardShortcut(_:modifiers:localization:)","type":"topic","title":"keyboardShortcut(_:modifiers:localization:)","url":"\/documentation\/swami\/interaction_dragview\/keyboardshortcut(_:modifiers:localization:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyboardShortcut"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"KeyEquivalent","preciseIdentifier":"s:7SwiftUI13KeyEquivalentV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"modifiers"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EventModifiers","preciseIdentifier":"s:7SwiftUI14EventModifiersV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"localization"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"KeyboardShortcut","preciseIdentifier":"s:7SwiftUI16KeyboardShortcutV"},{"kind":"text","text"