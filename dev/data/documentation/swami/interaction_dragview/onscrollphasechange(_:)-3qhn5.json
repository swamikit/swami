he center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"role":"symbol","title":"Interaction_DragView","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","kind":"symbol"}}}