{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"generated":true,"title":"Patterns","anchor":"Patterns"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Preview","level":2,"text":"Preview","type":"heading"},{"inlineContent":[],"type":"paragraph"},{"anchor":"The-patch","level":2,"text":"The patch","type":"heading"},{"inlineContent":[{"type":"text","text":"Origami drives this with an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" — a remembered on\/off state — flipped by"},{"type":"text","text":" "},{"type":"text","text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight"},{"type":"text","text":" "},{"type":"text","text":"onto native SwiftUI, which is the reusable idea worth taking away. A "},{"type":"codeVoice","code":"MagnifyGesture"},{"type":"text","text":" "},{"type":"text","text":"reads the pinch, a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" flag flips at a threshold, and a "},{"type":"codeVoice","code":".spring"},{"type":"text","text":" animates the"},{"type":"text","text":" "},{"type":"text","text":"scale between the two states (see the State\/memory → "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" row in"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","isActive":true},{"type":"text","text":")."}],"type":"paragraph"},{"code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not","type":"text"},{"text":" ","type":"text"},{"text":"a scale that tracks your fingers continuously.","type":"text"}],"type":"paragraph"},{"anchor":"How-its-built","level":2,"text":"How it’s built","type":"heading"},{"inlineContent":[{"text":"The full view sits the white rounded triangle on the magenta artboard and adds a live","type":"text"},{"text":" ","type":"text"},{"code":"@GestureState","type":"codeVoice"},{"text":" so the shape follows your fingers mid-pinch before it settles on the","type":"text"},{"text":" ","type":"text"},{"text":"popped state. Read the source (below) for the whole thing.","type":"text"}],"type":"paragraph"},{"anchor":"Behavior","level":2,"text":"Behavior","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Pinch out on the shape to grow it; pinch in to shrink it.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross the threshold and it snaps to the next size with a spring, rather than","type":"text"},{"text":" ","type":"text"},{"text":"tracking your fingers continuously.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The switch remembers its state, so a release between pinches holds the current size."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Downloads","level":2,"text":"Downloads","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Xcode sample","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"type":"reference","identifier":"https:\/\/swamikit.github.io\/swami\/dev\/downloads\/Interaction_Pinch.zip","isActive":true},{"text":" — a runnable App Playground. Unzip, open in Xcode 15+, and press Run to launch this pattern as an app.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Swift source","type":"text"}]},{"type":"text","text":" — "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift"},{"type":"text","text":" — the single source file, to read how the pop maps to "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" + a spring."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Origami source","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"isActive":true,"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","type":"reference"},{"type":"text","text":" — the original prototype (opens in Origami Studio)."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch"},"sections":[],"abstract":[{"text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a","type":"text"},{"text":" ","type":"text"},{"text":"spring; pinch back in and it pops home.","type":"text"}],"variants":[{"paths":["\/documentation\/swami\/interaction_pinch"],"traits":[{"interfaceLanguage":"swift"}]}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"isActive":true,"type":"reference","overridingTitle":"Download Xcode sample","identifier":"https:\/\/swamikit.github.io\/swami\/dev\/downloads\/Interaction_Pinch.zip"}},"metadata":{"title":"Interaction — Pinch","roleHeading":"Sample Code","modules":[{"name":"Swami"}],"role":"sampleCode"},"kind":"article","references":{"doc://samatwork.Swami/documentation/Swami":{"role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Origami patterns, rebuilt as SwiftUI you ca