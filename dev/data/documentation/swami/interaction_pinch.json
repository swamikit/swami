{"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"level":2,"text":"Preview","anchor":"Preview","type":"heading"},{"inlineContent":[],"type":"paragraph"},{"level":2,"text":"The patch","anchor":"The-patch","type":"heading"},{"inlineContent":[{"text":"Origami drives this with an ","type":"text"},{"code":"origami.PopSwitch","type":"codeVoice"},{"text":" — a remembered on\/off state — flipped by","type":"text"},{"text":" ","type":"text"},{"text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight","type":"text"},{"text":" ","type":"text"},{"text":"onto native SwiftUI, which is the reusable idea worth taking away. A ","type":"text"},{"code":"MagnifyGesture","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reads the pinch, a ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" flag flips at a threshold, and a ","type":"text"},{"code":".spring","type":"codeVoice"},{"text":" animates the","type":"text"},{"text":" ","type":"text"},{"text":"scale between the two states (see the State\/memory → ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" row in","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not","type":"text"},{"text":" ","type":"text"},{"text":"a scale that tracks your fingers continuously.","type":"text"}],"type":"paragraph"},{"level":2,"text":"How it’s built","anchor":"How-its-built","type":"heading"},{"inlineContent":[{"type":"text","text":"The full view sits the white rounded triangle on the magenta artboard and adds a live"},{"type":"text","text":" "},{"type":"codeVoice","code":"@GestureState"},{"type":"text","text":" so the shape follows your fingers mid-pinch before it settles on the"},{"type":"text","text":" "},{"type":"text","text":"popped state. Read the source (below) for the whole thing."}],"type":"paragraph"},{"level":2,"text":"Behavior","anchor":"Behavior","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Pinch out on the shape to grow it; pinch in to shrink it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross the threshold and it snaps to the next size with a spring, rather than"},{"type":"text","text":" "},{"type":"text","text":"tracking your fingers continuously."}]}]},{"content":[{"inlineContent":[{"text":"The switch remembers its state, so a release between pinches holds the current size.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Downloads","anchor":"Downloads","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Swift sample","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","isActive":true,"type":"reference"},{"text":" — the full source. Read it to see how the pop maps to ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" + a spring; paste it to run it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Origami source","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami"},{"text":" — the original prototype (opens in Origami Studio).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_pinch"]}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"]},{"title":"Patterns","anchor":"Patterns","generated":true,"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"]}],"abstract":[{"type":"text","text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a"},{"type":"text","text":" "},{"type":"text","text":"spring; pinch back in and it pops home."}],"metadata":{"roleHeading":"Sample Code","title":"Interaction — Pinch","role":"sampleCode","modules":[{"name":"Swami"}]},"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch","interfaceLanguage":"swift"},"sampleCodeDownload":{"kind":"sampleDownload","action":{"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","overridingTitle":"Open in Origami","type":"reference","isActive":true}},"sections":[],"references":{"https://github.com/swamikit/swami/blob/development/app/Swami/Patterns/Interaction_Pinch.swift":{"titleInlineContent":[{"code":"Interaction_Pinch.swift","type":"codeVoice"}],"title":"Interaction_Pinch.swift","url":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","type":"link","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift"},"doc://samatwork.Swami/documentation/Swami/OrigamiMappings":{"type":"topic","identifier":"doc