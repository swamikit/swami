{"sampleCodeDownload":{"kind":"sampleDownload","action":{"isActive":true,"overridingTitle":"Open in Origami","type":"reference","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami"}},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"abstract":[{"text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a","type":"text"},{"text":" ","type":"text"},{"text":"spring; pinch back in and it pops home.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch"},"metadata":{"role":"sampleCode","title":"Interaction — Pinch","modules":[{"name":"Swami"}],"roleHeading":"Sample Code"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"anchor":"Patterns","title":"Patterns","generated":true}],"variants":[{"paths":["\/documentation\/swami\/interaction_pinch"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Preview","anchor":"Preview"},{"type":"paragraph","inlineContent":[]},{"level":2,"type":"heading","text":"The patch","anchor":"The-patch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami drives this with an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" — a remembered on\/off state — flipped by"},{"type":"text","text":" "},{"type":"text","text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight"},{"type":"text","text":" "},{"type":"text","text":"onto native SwiftUI, which is the reusable idea worth taking away. A "},{"type":"codeVoice","code":"MagnifyGesture"},{"type":"text","text":" "},{"type":"text","text":"reads the pinch, a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" flag flips at a threshold, and a "},{"type":"codeVoice","code":".spring"},{"type":"text","text":" animates the"},{"type":"text","text":" "},{"type":"text","text":"scale between the two states (see the State\/memory → "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" row in"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"},{"type":"text","text":")."}]},{"type":"codeListing","code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not"},{"type":"text","text":" "},{"type":"text","text":"a scale that tracks your fingers continuously."}]},{"level":2,"type":"heading","text":"How it’s built","anchor":"How-its-built"},{"type":"paragraph","inlineContent":[{"text":"The full view sits the white rounded triangle on the magenta artboard and adds a live","type":"text"},{"text":" ","type":"text"},{"code":"@GestureState","type":"codeVoice"},{"text":" so the shape follows your fingers mid-pinch before it settles on the","type":"text"},{"text":" ","type":"text"},{"text":"popped state. Read the source (below) for the whole thing.","type":"text"}]},{"level":2,"type":"heading","text":"Behavior","anchor":"Behavior"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Pinch out on the shape to grow it; pinch in to shrink it.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross the threshold and it snaps to the next size with a spring, rather than","type":"text"},{"text":" ","type":"text"},{"text":"tracking your fingers continuously.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The switch remembers its state, so a release between pinches holds the current size.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Downloads","anchor":"Downloads"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Swift sample"}]},{"text":" — ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","type":"reference"},{"text":" — the full source. Read it to see how the pop maps to ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" + a spring; paste it to run it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Origami source"}]},{"text":" — ","type":"text"},{"type":"reference","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","isActive":true},{"text":" — the original prototype (opens in Origami Studio).","type":"text"}]}]}]}],"kind":"content"}],"sections":[],"references":{"doc://samatwork.Swami/documentation/Swami":{"role":"collection","type":"topic","kind":"symbol","title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","abstract":[{"type":"text","text":"Origami patterns, rebuilt as SwiftUI you can read — each one a worked example of the"},{"text":" ","type":"text"},{"text":"patches behind it, so you can see how a prototype’s behavior is written and reach for","type":"text"},{"text":" ","type":"text"},{"text":"the same patch on your own layers.","type":"text"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_Drag":{"abstract":[{"text":"A card you can drag anywhere on screen. It carries momentum when you let go and","type":"text"},{"text":" ","type":"text"},{"text":"springs back from the edges.","type":"text"}],"type":"topic","kind":"article","title":"Interaction — Drag","url":"\/documentation\/swami\/interaction_drag","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag","role":"sampleCode"},"https://github.com/swamikit/swami/blob/development/app/Swami/Patterns/Interaction_Pinch.swift":{"identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","titleInlineContent":[{"type":"codeVoice","code":"Interaction_Pinch.swift"}],"url":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","title":"Interaction_Pinch.swift","type":"link"},"doc://samatwork.Swami/documentation/Swami/OrigamiMappings":{"url":"\/documentation\/swami\/origamimappings","title":"Origami → SwiftUI reference","type":"topic","role":"article","abstract":[{"type":"text","text":"What each Origami patch becomes in SwiftUI, so you know which construct — or which"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"},{"type":"text","text":" helper — to reach for."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","kind":"article"},"https://origami.design/public/origami_files/patterns/Interaction_Pinch.origami":{"checksum":null,"type":"download","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","url":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami"}}}