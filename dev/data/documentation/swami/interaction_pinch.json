{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a"},{"type":"text","text":" "},{"type":"text","text":"spring; pinch back in and it pops home."}],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"]},{"title":"Patterns","anchor":"Patterns","generated":true,"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"]}],"metadata":{"roleHeading":"Sample Code","images":[{"identifier":"Interaction_Pinch.png","type":"card"}],"modules":[{"name":"Swami"}],"role":"sampleCode","title":"Interaction — Pinch"},"primaryContentSections":[{"content":[{"text":"Preview","type":"heading","anchor":"Preview","level":2},{"type":"paragraph","inlineContent":[{"identifier":"Interaction_Pinch","type":"image"}]},{"text":"The patch","type":"heading","anchor":"The-patch","level":2},{"type":"paragraph","inlineContent":[{"text":"Origami drives this with an ","type":"text"},{"code":"origami.PopSwitch","type":"codeVoice"},{"text":" — a remembered on\/off state — flipped by","type":"text"},{"text":" ","type":"text"},{"text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight","type":"text"},{"text":" ","type":"text"},{"text":"onto native SwiftUI, which is the reusable idea worth taking away. A ","type":"text"},{"code":"MagnifyGesture","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reads the pinch, a ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" flag flips at a threshold, and a ","type":"text"},{"code":".spring","type":"codeVoice"},{"text":" animates the","type":"text"},{"text":" ","type":"text"},{"text":"scale between the two states (see the State\/memory → ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" row in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/s