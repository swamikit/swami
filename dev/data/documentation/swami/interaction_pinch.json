{"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"metadata":{"role":"sampleCode","roleHeading":"Sample Code","title":"Interaction — Pinch","images":[{"type":"card","identifier":"Interaction_Pinch.png"}],"modules":[{"name":"Swami"}]},"kind":"article","abstract":[{"type":"text","text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a"},{"type":"text","text":" "},{"type":"text","text":"spring; pinch back in and it pops home."}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"anchor":"Related-Documentation"},{"title":"Patterns","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"generated":true,"anchor":"Patterns"}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"type":"reference","identifier":"https:\/\/swamikit.github.io\/swami\/dev\/downloads\/Interaction_Pinch.zip","overridingTitle":"Download Xcode sample","isActive":true}},"primaryContentSections":[{"content":[{"level":2,"anchor":"Preview","type":"heading","text":"Preview"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"Interaction_Pinch"}]},{"level":2,"anchor":"The-patch","type":"heading","text":"The patch"},{"type":"paragraph","inlineContent":[{"text":"Origami drives this with an ","type":"text"},{"code":"origami.PopSwitch","type":"codeVoice"},{"text":" — a remembered on\/off state — flipped by","type":"text"},{"text":" ","type":"text"},{"text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight","type":"text"},{"text":" ","type":"text"},{"text":"onto native SwiftUI, which is the reusable idea worth taking away. A ","type":"text"},{"code":"MagnifyGesture","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reads the pinch, a ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" flag flips at a threshold, and a ","type":"text"},{"code":".spring","type":"codeVoice"},{"text":" animates the","type":"text"},{"text":" ","type":"text"},{"text":"scale between the two states (see the State\/memory → ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" row in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not","type":"text"},{"text":" ","type":"text"},{"text":"a scale that tracks your fingers continuously.","type":"text"}]},{"level":2,"anchor":"How-its-built","type":"heading","text":"How it’s built"},{"type":"paragraph","inlineContent":[{"text":"The full view sits the white rounded triangle on the magenta artboard and adds a live","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@GestureState"},{"text":" so the shape follows your fingers mid-pinch before it settles on the","type":"text"},{"text":" ","type":"text"},{"text":"popped state. Read the source (below) for the whole thing.","type":"text"}]},{"level":2,"anchor":"Behavior","type":"heading","text":"Behavior"},{"items":[{"content":[{"inlineContent":[{"text":"Pinch out on the shape to grow it; pinch in to shrink it.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross the threshold and it snaps to the next size with a spring, rather than"},{"type":"text","text":" "},{"type":"text","text":"tracking your fingers continuously."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The switch remembers its state, so a release between pinches holds the current size.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Downloads","type":"heading","text":"Downloads"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Xcode sample","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"identifier":"https:\/\/swamikit.github.io\/swami\/dev\/downloads\/Interaction_Pinch.zip","isActive":true,"type":"reference"},{"text":" — the runnable project (same as the button above).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Swift source","type":"text"}]},{"text":" — ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","type":"reference"},{"text":" — the single source file to read.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Origami source"}]},{"type":"text","text":" — "},{"isActive":true,"type":"reference","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swami\/interaction_pinch"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_Drag":{"images":[{"type":"card","identifier":"Interaction_Drag.png"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag","type":"topic","url":"\/documentation\/swami\/interaction_drag","tit