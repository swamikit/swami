{"schemaVersion":{"patch":0,"minor":3,"major":0},"sampleCodeDownload":{"action":{"isActive":true,"type":"reference","identifier":"https:\/\/swamikit.github.io\/swami\/dev\/downloads\/Interaction_Pinch.zip","overridingTitle":"Download Xcode sample"},"kind":"sampleDownload"},"sections":[],"abstract":[{"type":"text","text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a"},{"type":"text","text":" "},{"type":"text","text":"spring; pinch back in and it pops home."}],"primaryContentSections":[{"content":[{"text":"Preview","type":"heading","level":2,"anchor":"Preview"},{"inlineContent":[{"identifier":"Interaction_Pinch","type":"image"}],"type":"paragraph"},{"text":"The patch","type":"heading","level":2,"anchor":"The-patch"},{"inlineContent":[{"type":"text","text":"Origami drives this with an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" — a remembered on\/off state — flipped by"},{"type":"text","text":" "},{"type":"text","text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight"},{"type":"text","text":" "},{"type":"text","text":"onto native SwiftUI, which is the reusable idea worth taking away. A "},{"type":"codeVoice","code":"MagnifyGesture"},{"type":"text","text":" "},{"type":"text","text":"reads the pinch, a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" flag flips at a threshold, and a "},{"type":"codeVoice","code":".spring"},{"type":"text","text":" animates the"},{"type":"text","text":" "},{"type":"text","text":"scale between the two states (see the State\/memory → "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" row in"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"},{"type":"text","text":")."}],"type":"paragraph"},{"code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not"},{"type":"text","text":" "},{"type":"text","text":"a scale that tracks your fingers continuously."}],"type":"paragraph"},{"text":"How it’s built","type":"heading","level":2,"anchor":"How-its-built"},{"inlineContent":[{"text":"The full view sits the white rounded triangle on the magenta artboard and adds a live","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@GestureState"},{"text":" so the shape follows your fingers mid-pinch before it settles on the","type":"text"},{"text":" ","type":"text"},{"text":"popped state. Read the source (below) for the whole thing.","type":"text"}],"type":"paragraph"},{"text":"Behavior","type":"heading","level":2,"anchor":"Behavior"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Pinch out on the shape to grow it; pinch in to shrink it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross the threshold and it snaps to the next size with a spring, rather than"},{"type":"text","text":" "},{"type":"text","text":"tracking your fingers continuously."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The switch remembers its state, so a release between pinches holds the current size."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Downloads","type":"heading","level":2,"anchor":"Downloads"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Xcode sample","type":"text"}]},{"text":" — ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/swamikit.github.io\/swami\/dev\/downloads\/Interaction_Pinch.zip"},{"text":" — the runnable project (same as the button above).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Swift source"}],"type":"strong"},{"type":"text","text":" — "},{"type":"reference","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","isActive":true},{"type":"text","text":" — the single source file to read."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Origami source"}]},{"type":"text","text":" — "},{"type":"reference","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","isActive":true}]}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch"},"variants":[{"paths":["\/documentation\/swami\/interaction_pinch"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"anchor":"Related-Documentation"},{"title":"Patterns","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"generated":true,"anchor":"Patterns"}],"metadata":{"role":"sampleCode","title":"Interaction — Pinch","modules":[{"name":"Swami"}],"images":[{"type":"card","identifier":"Interaction_Pinch.png"}],"roleHeading":"Sample Code"},"references":{"https://origami.design/public/origami_files/patterns/Interaction_Pinch.origami":{"title":"Interaction_Pinch.origami","titleInlineContent":[{"type":"codeVoice","code":"Interaction_Pinch.origami"}],"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/In