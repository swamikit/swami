{"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Preview","level":2,"text":"Preview","type":"heading"},{"inlineContent":[],"type":"paragraph"},{"anchor":"The-patch","level":2,"text":"The patch","type":"heading"},{"inlineContent":[{"type":"text","text":"Origami drives this with an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" — a remembered on\/off state — flipped by"},{"type":"text","text":" "},{"type":"text","text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight"},{"type":"text","text":" "},{"type":"text","text":"onto native SwiftUI, which is the reusable idea worth taking away. A "},{"type":"codeVoice","code":"MagnifyGesture"},{"type":"text","text":" "},{"type":"text","text":"reads the pinch, a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" flag flips at a threshold, and a "},{"type":"codeVoice","code":".spring"},{"type":"text","text":" animates the"},{"type":"text","text":" "},{"type":"text","text":"scale between the two states (see the State\/memory → "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" row in"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"},{"type":"text","text":")."}],"type":"paragraph"},{"syntax":"swift","code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"],"type":"codeListing"},{"inlineContent":[{"text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not","type":"text"},{"text":" ","type":"text"},{"text":"a scale that tracks your fingers continuously.","type":"text"}],"type":"paragraph"},{"anchor":"How-its-built","level":2,"text":"How it’s built","type":"heading"},{"inlineContent":[{"type":"text","text":"The full view sits the white rounded triangle on the magenta artboard and adds a live"},{"type":"text","text":" "},{"type":"codeVoice","code":"@GestureState"},{"type":"text","text":" so the shape follows your fingers mid-pinch before it settles on the"},{"type":"text","text":" "},{"type":"text","text":"popped state. Read the source (below) for the whole thing."}],"type":"paragraph"},{"anchor":"Behavior","level":2,"text":"Behavior","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pinch out on the shape to grow it; pinch in to shrink it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross the threshold and it snaps to the next size with a spring, rather than","type":"text"},{"text":" ","type":"text"},{"text":"tracking your fingers continuously.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The switch remembers its state, so a release between pinches holds the current size.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Downloads","level":2,"text":"Downloads","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Swift sample"}]},{"type":"text","text":" — "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift"},{"type":"text","text":" — the full source. Read it to see how the pop maps to "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" + a spring; paste it to run it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Origami source","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"isActive":true,"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","type":"reference"},{"type":"text","text":" — the original prototype (opens in Origami Studio)."}]}]}],"type":"unorderedList"}]}],"metadata":{"title":"Interaction — Pinch","modules":[{"name":"Swami"}],"roleHeading":"Sample Code","role":"sampleCode"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_pinch"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"title":"Patterns","anchor":"Patterns","generated":true}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"overridingTitle":"Open in Origami","type":"reference","isActive":true,"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami"}},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a"},{"type":"text","text":" "},{"type":"text","text":"spring; pinch back in and it pops home."}],"references":{"doc://samatwork.Swami/documentation/Swami":{"role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"topic","kind":"symbol","abstract":[{"text":"Origami patterns, rebuilt as SwiftUI you can read — each one a worked example of the","type":"text"},{"text":" ","type":"text"},{"text":"patches behind it, so you can see how a prototype’s behavior is written and reach for","type":"text"},{"text":" ","type":"text"},{"text":"the same patch on your own layers.","type":"text"}],"url":"\/documentation\/swami","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/OrigamiMappings":{"role":"article","abstract":[{"type":"text","text":"What each Origami patch becomes in SwiftUI, so you know which construct — or which"},{"type":"text","text":" "},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"reference","isActive":true},{"text":" helper — to reach for.","type":"text"}],"kind":"article","url":"\/documentation\/swami\/origamimappings","title":"Origami → SwiftUI reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","type":"topic"},"https://origami.design/public/origami_files/patterns/Interaction_Pinch.origami":{"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","type":"download","url":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","checksum":null},"doc://samatwork.Swami/documentation/Swami/Interaction_Drag":{"title":"Interaction — Drag","abstract":[{"text":"A card you can drag anywhere on screen. It carries momentum when you let go and","type":"text"},{"text":" ","type":"text"},{"text":"springs back from the edges.","type":"text"}],"role":"sampleCode","kind":"article","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag","url":"\/documentation\/swami\/interaction_drag","type":"topic"},"https://github.com/swamikit/swami/blob/development/app/Swami/Patterns/Interaction_Pinch.swift":{"identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","url":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","title":"Interaction_Pinch.swift","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Interaction_Pinch.swift"}]}}}