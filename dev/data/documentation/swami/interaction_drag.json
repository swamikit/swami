{"primaryContentSections":[{"content":[{"text":"Preview","type":"heading","level":2,"anchor":"Preview"},{"inlineContent":[{"text":"The preview image is generated by the CI render pipeline, never hand-committed:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"verify.yml"}],"type":"strong"},{"text":" (","type":"text"},{"code":"pixel-gate","type":"codeVoice"},{"text":" job) renders Origami’s artboard and SwamiHost’s","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI side-by-side at matching simulator dimensions.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"post-merge.yml"}]},{"type":"text","text":" copies the SwamiHost render into"},{"type":"text","text":" "},{"type":"codeVoice","code":"Resources\/Patterns\/Interaction_Drag.png"},{"type":"text","text":" after a pattern lands on main."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"publish-docs.yml","type":"text"}],"type":"strong"},{"type":"text","text":" picks up the committed PNG and includes it in the"},{"type":"text","text":" "},{"type":"text","text":"DocC archive published to GitHub Pages."}]}]}]},{"inlineContent":[{"type":"text","text":"The artifact path is: "},{"code":"app\/Swami\/Swami.docc\/Resources\/Patterns\/Interaction_Drag.png","type":"codeVoice"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"],"anchor":"Related-Documentation"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_drag"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"Interaction — Drag","role":"sampleCode","roleHeading":"Sample Code","modules":[{"name":"Swami"}]},"hierarchy":{"paths":[["doc:\/\/sam