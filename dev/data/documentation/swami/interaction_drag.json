{"kind":"article","metadata":{"roleHeading":"Sample Code","title":"Interaction — Drag","role":"sampleCode","modules":[{"name":"Swami"}]},"primaryContentSections":[{"content":[{"type":"heading","text":"Preview","anchor":"Preview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The preview image is generated by the CI render pipeline, never hand-committed:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"verify.yml"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"pixel-gate"},{"type":"text","text":" job) renders Origami’s artboard and SwamiHost’s"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI side-by-side at matching simulator dimensions."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"post-merge.yml"}]},{"type":"text","text":" copies the SwamiHost render into"},{"type":"text","text":" "},{"type":"codeVoice","code":"Resources\/Patterns\/Interaction_Drag.png"},{"type":"text","text":" after a pattern lands on main."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"publish-docs.yml"}],"type":"strong"},{"text":" picks up the committed PNG and includes it in the","type":"text"},{"text":" ","type":"text"},{"text":"DocC archive published to GitHub Pages.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The artifact path is: "},{"type":"codeVoice","code":"app\/Swami\/Swami.docc\/Resources\/Patterns\/Interaction_Drag.png"}]}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"],"anchor":"Related-Documentation","title":"Related Documentation"}],"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_drag"]}],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag","interfaceLanguage":"swift"},"references":{"doc://samatwork.Swami/documentation/Swami":{"role":"collection","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol","title":"Swami","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_Drag