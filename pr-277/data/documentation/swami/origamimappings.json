{"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI both describe how values flow and change over"},{"type":"text","text":" "},{"type":"text","text":"time, so the translations map onto SwiftUI’s own tools: computed properties for"},{"type":"text","text":" "},{"type":"text","text":"pure math, gestures and "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for interaction, "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" for motion. Most"},{"type":"text","text":" "},{"type":"text","text":"patches land on a native SwiftUI construct. A few need a helper from the "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","isActive":true},{"type":"text","text":" "},{"type":"text","text":"library, named after the patch it stands in for."}]},{"level":2,"type":"heading","anchor":"Patch-%E2%86%92-SwiftUI","text":"Patch → SwiftUI"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami patch"}]}],[{"type":"paragraph","inlineContent":[{"text":"SwiftUI","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pure value patch (Add, interpolate, logic)"}]}],[{"type":"paragraph","inlineContent":[{"text":"computed property \/ expression (native)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interaction (Tap, Press, Double Tap, Long Press)"}]}],[{"type":"paragraph","inlineContent":[{"text":"gesture + ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" via ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true,"type":"reference"},{"text":" (helper)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" — Drag"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)"},{"type":"text","text":" (helper)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Magnification \/ Pinch","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"MagnifyGesture","type":"codeVoice"},{"type":"text","text":" (native)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" — Pop Switch"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@State"},{"text":" flipped on a threshold, ","type":"text"},{"type":"codeVoice","code":".spring"},{"text":" pop (native)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"builtin.layer.shape"},{"type":"text","text":" — Shape (triangle)"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/RoundedTriangle"},{"type":"text","text":" (helper)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"State \/ memory (Switch, Sample and Hold)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@State"},{"text":" + update logic (native)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Animation (Classic Animation, Pop \/ Spring)"}]}],[{"type":"paragraph","inlineContent":[{"code":"withAnimation","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".animation(.spring)","type":"codeVoice"},{"text":" (native)","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"code":"View","type":"codeVoice"},{"type":"text","text":" body."}]},{"level":2,"type":"heading","anchor":"How-the-categories-map","text":"How the categories map"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Pure value patches","type":"text"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"Add"},{"type":"text","text":", interpolation, logic — carry no state. They run an"},{"type":"text","text":" "},{"type":"text","text":"input through math and emit a result, which is exactly a computed property or an"},{"type":"text","text":" "},{"type":"text","text":"inline expression."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Interaction"}],"type":"strong"},{"type":"text","text":" exposes discrete outputs: "},{"type":"codeVoice","code":"down"},{"type":"text","text":", "},{"type":"codeVoice","code":"position"},{"type":"text","text":", "},{"type":"codeVoice","code":"onTap"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":". Each becomes a SwiftUI gesture whose result lands in"},{"type":"text","text":" "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" or fires a callback. The "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true},{"type":"text","text":" helper attaches only the"},{"type":"text","text":" "},{"type":"text","text":"recognizers you ask for, so gesture arbitration stays clean."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State and memory"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"Switch"},{"type":"text","text":", "},{"type":"codeVoice","code":"Sample and Hold"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Switch"},{"type":"text","text":" — remember a value"},{"type":"text","text":" "},{"type":"text","text":"between evaluations. That is what "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" is for; the update path is a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, an "},{"type":"codeVoice","code":".onChange"},{"type":"text","text":", or an assignment."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Animation"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":" — drives a value toward a"},{"type":"text","text":" "},{"type":"text","text":"target over time, which is a state change wrapped in "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an"},{"type":"text","text":" "},{"type":"codeVoice","code":".animation(_:value:)"},{"text":" modifier.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One naming note: Origami’s "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means "},{"type":"emphasis","inlineContent":[{"text":"interpolation","type":"text"}]},{"type":"text","text":" (mapping one range"},{"type":"text","text":" "},{"type":"text","text":"onto another), not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier for view insertion and"},{"type":"text","text":" "},{"type":"text","text":"removal."}]},{"level":2,"type":"heading","anchor":"When-a-mapping-isnt-exact","text":"When a mapping isn’t exact"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some Origami semantics have no direct SwiftUI equivalent — continuous-time springs,"},{"type":"text","text":" "},{"type":"text","text":"custom JavaScript patches, absolute-position layout. Rather than approximate them"},{"type":"text","text":" "},{"type":"text","text":"silently, each translated view marks the gap with an inline "},{"code":"TODO","type":"codeVoice"},{"type":"text","text":" in its source,"},{"type":"text","text":" "},{"type":"text","text":"so the caveat travels with the code. The individual pattern pages link to the"},{"type":"text","text":" "},{"type":"text","text":"source where those notes live."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier"