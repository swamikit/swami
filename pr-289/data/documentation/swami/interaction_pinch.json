{"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Preview","text":"Preview"},{"inlineContent":[],"type":"paragraph"},{"type":"heading","level":2,"anchor":"The-patch","text":"The patch"},{"inlineContent":[{"text":"Origami drives this with an ","type":"text"},{"code":"origami.PopSwitch","type":"codeVoice"},{"text":" — a remembered on\/off state — flipped by","type":"text"},{"text":" ","type":"text"},{"text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight","type":"text"},{"text":" ","type":"text"},{"text":"onto native SwiftUI, which is the reusable idea worth taking away. A ","type":"text"},{"code":"MagnifyGesture","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reads the pinch, a ","type":"text"},{"code":"@State","type":"codeVoice"},{"type":"text","text":" flag flips at a threshold, and a "},{"type":"codeVoice","code":".spring"},{"type":"text","text":" animates the"},{"type":"text","text":" "},{"text":"scale between the two states (see the State\/memory → ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" row in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","type":"reference","isActive":true},{"text":").","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not"},{"type":"text","text":" "},{"type":"text","text":"a scale that tracks your fingers continuously."}]},{"type":"heading","level":2,"anchor":"How-its-built","text":"How it’s built"},{"type":"paragraph","inlineContent":[{"text":"The full view sits the white rounded triangle on the magenta artboard and adds a live","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@GestureState"},{"text":" so the shape follows your fingers mid-pinch before it settles on the","type":"text"},{"text":" ","type":"text"},{"text":"popped state. Read the source (below) for the whole thing.","type":"text"}]},{"type":"heading","level":2,"anchor":"Behavior","text":"Behavior"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Pinch out on the shape to grow it; pinch in to shrink it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Cross the threshold and it snaps to the next size with a spring, rather than","type":"text"},{"text":" ","type":"text"},{"text":"tracking your fingers continuously.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The switch remembers its state, so a release between pinches holds the current size."}]}]}]},{"type":"heading","level":2,"anchor":"Downloads","text":"Downloads"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Xcode sample","type":"text"}]},{"text":" — ","type":"text"},{"identifier":"https:\/\/swamikit.github.io\/swami\/pr-289\/downloads\/Interaction_Pinch.zip","type":"reference","isActive":true},{"text":" — the runnable project (same as the button above).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Swift source","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift"},{"text":" — the single source file to read.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Origami source"}]},{"type":"text","text":" — "},{"type":"reference","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","isActive":true}]}]}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"anchor":"Related-Documentation"},{"title":"Patterns","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"generated":true,"anchor":"Patterns"}],"sections":[],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swami\/interaction_pinch"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"sampleCode","modules":[{"name":"Swami"}],"roleHeading":"Sample Code","title":"Interaction — Pinch"},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"abstract":[{"text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a","type":"text"},{"text":" ","type":"text"},{"text":"spring; pinch back in and it pops home.","type":"text"}],"kind":"article","sampleCodeDownload":{"action":{"overridingTitle":"Download Xcode sample","type":"reference","identifier":"https:\/\/swamikit.github.io\/swami\/pr-289\/downloads\/Interaction_Pinch.zip","isActive":true},"kind":"sampleDownload"},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_Drag":{"title":"Interaction — Drag","kind":"article","abstract":[{"type":"text","text":"A card you can drag anywhere on screen. It carries momentum when you let go and"},{"type":"text","text":" "},{"type":"text","text":"springs back from the edges."}],"url":"\/documentation\/swami\/interaction_drag","role":"sampleCode","ty