{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/swami\/interaction_pinch"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"title":"Related Documentation","anchor":"Related-Documentation"},{"generated":true,"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"title":"Patterns","anchor":"Patterns"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Preview","anchor":"Preview"},{"type":"paragraph","inlineContent":[]},{"type":"heading","level":2,"text":"The patch","anchor":"The-patch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami drives this with an "},{"code":"origami.PopSwitch","type":"codeVoice"},{"type":"text","text":" — a remembered on\/off state — flipped by"},{"type":"text","text":" "},{"type":"text","text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight"},{"type":"text","text":" "},{"type":"text","text":"onto native SwiftUI, which is the reusable idea worth taking away. A "},{"code":"MagnifyGesture","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"reads the pinch, a "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" flag flips at a threshold, and a "},{"type":"codeVoice","code":".spring"},{"type":"text","text":" animates the"},{"type":"text","text":" "},{"type":"text","text":"scale between the two states (see the State\/memory → "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" row in"},{"type":"text","text":" "},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","type":"reference","isActive":true},{"type":"text","text":")."}]},{"type":"codeListing","syntax":"swift","code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"]},{"type":"paragraph","inlineContent":[{"text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not","type":"text"},{"text":" ","type":"text"},{"text":"a scale that tracks your fingers continuously.","type":"text"}]},{"type":"heading","level":2,"text":"How it’s built","anchor":"How-its-built"},{"type":"paragraph","inlineContent":[{"text":"The full view sits the white rounded triangle on the magenta artboard and adds a live","type":"text"},{"text":" ","type":"text"},{"code":"@GestureState","type":"codeVoice"},{"text":" so the shape follows your fingers mid-pinch before it settles on the","type":"text"},{"text":" ","type":"text"},{"text":"popped state. Read the source (below) for the whole thing.","type":"text"}]},{"type":"heading","level":2,"text":"Behavior","anchor":"Behavior"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Pinch out on the shape to grow it; pinch in to shrink it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Cross the threshold and it snaps to the next size with a spring, rather than","type":"text"},{"text":" ","type":"text"},{"text":"tracking your fingers continuously.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The switch remembers its state, so a release between pinches holds the current size."}]}]}]},{"type":"heading","level":2,"text":"Downloads","anchor":"Downloads"},{"type":"unorderedList","items":[{"