{"sampleCodeDownload":{"kind":"sampleDownload","action":{"isActive":true,"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","type":"reference","overridingTitle":"Open in Origami"}},"metadata":{"roleHeading":"Sample Code","role":"sampleCode","modules":[{"name":"Swami"}],"title":"Interaction — Pinch"},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"anchor":"Related-Documentation"},{"generated":true,"title":"Patterns","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"anchor":"Patterns"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_pinch"]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Preview","level":2,"type":"heading","text":"Preview"},{"inlineContent":[],"type":"paragraph"},{"anchor":"The-patch","level":2,"type":"heading","text":"The patch"},{"inlineContent":[{"text":"Origami drives this with an ","type":"text"},{"code":"origami.PopSwitch","type":"codeVoice"},{"text":" — a remembered on\/off state — flipped by","type":"text"},{"text":" ","type":"text"},{"text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight","type":"text"},{"text":" ","type":"text"},{"text":"onto native SwiftUI, which is the reusable idea worth taking away. A ","type":"text"},{"type":"codeVoice","code":"MagnifyGesture"},{"text":" ","type":"text"},{"text":"reads the pinch, a ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" flag flips at a threshold, and a ","type":"text"},{"type":"codeVoice","code":".spring"},{"text":" animates the","type":"text"},{"text":" ","type":"text"},{"text":"scale between the two states (see the State\/memory → ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" row in","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"},{"text":").","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"]},{"type":"paragraph","inlineContent":[{"text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not","type":"text"},{"text":" ","type":"text"},{"text":"a scale that tracks your fingers continuously.","type":"text"}]},{"anchor":"How-its-built","type":"heading","level":2,"text":"How it’s built"},{"type":"paragraph","inlineContent":[{"text":"The full view sits the white rounded triangle on the magenta artboard and adds a live","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@GestureState"},{"text":" so the shape follows your fingers mid-pinch before it settles on the","type":"text"},{"text":" ","type":"text"},{"text":"popped state. Read the source (below) for the whole thing.","type":"text"}]},{"anchor":"Behavior","type":"heading","level":2,"text":"Behavior"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Pinch out on the shape to grow it; pinch in to shrink it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Cross the threshold and it snaps to the next size with a spring, rather than","type":"text"},{"text":" ","type":"text"},{"text":"tracking your fingers continuously.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The switch remembers its state, so a release between pinches holds the current size.","type":"text"}]}]}]},{"level":2,"text":"Downloads","anchor":"Downloads","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Swift sample"}],"type":"strong"},{"type":"text","text":" — "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift"},{"type":"text","text":" — the full source. Read it to see how the pop maps to "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" + a spring; paste it to run it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Origami source"}],"type":"strong"},{"type":"text","text":" — "},{"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","type":"reference","isActive":true},{"type":"text","text":" — the original prototype (opens in Origami Studio)."}]}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"abstract":[{"type":"text","text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a"},{"type":"text","text":" "},{"type":"text","text":"spring; pinch back in and it pops home."}],"references":{"https://origami.design/public/origami_files/patterns/Interaction_Pinch.origami":{"checksum":null,"url":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","type":"download","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami"},"doc://samatwork.Swami/documentation/Swami/Interaction_Drag":{"title":"Interaction — Drag","role":"sampleCode","type":"topic","url":"\/documentation\/swami\/interaction_drag","kind":"article","abstract":[{"text":"A card you can drag anywhere on screen. It carries momentum when you let go and","type":"text"},{"text":" ","type":"text"},{"text":"springs back from the edges.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"},"doc://samatwork.Swami/documentation/Swami":{"type":"topic","abstract":[{"text":"Origami patterns, rebuilt as SwiftUI you can read — each one a worked example of the","type":"text"},{"text":" ","type":"text"},{"text":"patches behind it, so you can see how a prototype’s behavior is written and reach for","type":"text"},{"text":" ","type":"text"},{"text":"the same patch on your own layers.","type":"text"}],"url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","role":"collection","kind":"symbol"},"https://github.com/swamikit/swami/blob/development/app/Swami/Patterns/Interaction_Pinch.swift":{"url":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","title":"Interaction_Pinch.swift","titleInlineContent":[{"type":"codeVoice","code":"Interaction_Pinch.swift"}],"type":"link","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift"},"doc://samatwork.Swami/documentation/Swami/OrigamiMappings":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","title":"Origami → SwiftUI reference","role":"article","url":"\/documentation\/swami\/origamimappings","kind":"article","abstract":[{"text":"What each Origami patch becomes in SwiftUI, so you know which construct — or which","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"reference"},{"text":" helper — to reach for.","type":"text"}],"type":"topic"}}}