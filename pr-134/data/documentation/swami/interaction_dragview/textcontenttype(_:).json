ftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"kind":"symbol","title":"Swami","url":"\/documentation\/swami","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/textContentType(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"textContentType"},{"kind":"text","text":"("},{"preciseIdentifier":"c:@T@UITextContentType","kind":"typeIdentifier","text":"UITextContentType"},{"kind":"text","text":"?) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"type":"topic","abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/textcontenttype(_:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/textContentType(_:)","kind":"symbol","title":"textContentType(_:)","role":"symbol"}}}