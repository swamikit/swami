xt":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Naming (ADR-0010): helpers are named after the Origami "},{"inlineContent":[{"type":"text","text":"patch"}],"type":"emphasis"},{"type":"text","text":", bare (no prefix) —"},{"type":"text","text":" "},{"type":"text","text":"disambiguate with the module ("},{"code":"OrigamiPatterns.Interaction","type":"codeVoice"},{"type":"text","text":") if it ever collides. This one"},{"type":"text","text":" "},{"type":"text","text":"doesn’t clash with anything in SwiftUI."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"composes off them, matching the graph:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"down","type":"codeVoice"},{"text":" — ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" while a finger is on the layer,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"position"},{"type":"text","text":" — the touch point, in the layer’s coordinate space,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"onTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":" — discrete pulses.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Only the gesture for an output you actually request is attached — so a tap-only layer","type":"text"},{"text":" ","type":"text"},{"text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean.","type":"text"}]}],"kind":"content"}],"kind":"symbol","references":{"doc://samatwork.Swami/s8SendableP":{"identifier":"doc:\/\/samatwork.Swami\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://samatwork.Swami/docume