":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/backgroundPreferenceValue(_:_:)":{"role":"symbol","title":"backgroundPreferenceValue(_:_:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/backgroundPreferenceValue(_:_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"backgroundPreferenceValue","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":".Type, (","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:7SwiftUI13PreferenceKeyP5ValueQa"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"abstract":[],"kind":"symbol","type":"topic","url":"\/documentation\/swami\/interaction_dragview\/backgroundpreferencevalue(_:_:)"}}}