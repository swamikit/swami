","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Naming (ADR-0010): helpers are named after the Origami "},{"type":"emphasis","inlineContent":[{"type":"text","text":"patch"}]},{"type":"text","text":", bare (no prefix) —"},{"type":"text","text":" "},{"type":"text","text":"disambiguate with the module ("},{"type":"codeVoice","code":"OrigamiPatterns.Interaction"},{"type":"text","text":") if it ever collides. This one"},{"type":"text","text":" "},{"type":"text","text":"doesn’t clash with anything in SwiftUI."}]},{"type":"paragraph","inlineContent":[{"text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"composes off them, matching the graph:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"down"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" while a finger is on the layer,","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"position","type":"codeVoice"},{"text":" — the touch point, in the layer’s coordinate space,","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"onTap","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"onDoubleTap","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"onLongPress","type":"codeVoice"},{"type":"text","text":" — discrete pulses."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Only the gesture for an output you actually request is attached — so a tap-only layer","type":"text"},{"text":" ","type":"text"},{"text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean.","type":"text"}]}],"kind":"content"}],"kind":"symbol","references":{"doc://samatwork.Swami/documentation/Swami/Interaction":{"navigatorTitle":[{"kind":"identifier","text":"Interaction"}],"abstract":[{"type":"text","text":"SwiftUI equi