,"text":"Drag"}],"type":"strong"},{"text":" patch (","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drag"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Drag"}],"url":"\/documentation\/swami\/drag"},"doc://samatwork.Swami/7SwiftUI12ViewModifierP":{"identifier":"doc:\/\/samatwork.Swami\/7SwiftUI12ViewModifierP","title":"SwiftUICore.ViewModifier","type":"unresolvable"},"doc://samatwork.Swami/documentation/Swami":{"role":"collection","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","type":"topic","url":"\/documentation\/swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}]}}}