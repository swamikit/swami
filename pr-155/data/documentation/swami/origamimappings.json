e"},{"text":", or an assignment inside a ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" block).","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Animation-%E2%86%92-withAnimation--animation","type":"heading","text":"Animation → `withAnimation` \/ `.animation`"},{"inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":", and other animation patches drive a value"},{"type":"text","text":" "},{"type":"text","text":"toward a target over time. In SwiftUI, that’s a state change wrapped in"},{"type":"text","text":" "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".animation(_:value:)"},{"type":"text","text":" modifier on the animated property."},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}],"type":"paragraph"},{"level":2,"anchor":"Flag-dont-fake","type":"heading","text":"Flag, don’t fake"},{"inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"Swami"}],"role":"article","title":"Origami → SwiftUI mappings","roleHeading":"Article"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"How Swami translat