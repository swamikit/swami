ducedAt":"18.0","unavailable":false,"deprecated":false,"beta":false},{"name":"Mac Catalyst","introducedAt":"18.0","unavailable":false,"deprecated":false,"beta":false},{"name":"macOS","introducedAt":"15.0","unavailable":false,"deprecated":false,"beta":false},{"name":"tvOS","introducedAt":"18.0","unavailable":false,"deprecated":false,"beta":false},{"name":"visionOS","introducedAt":"2.0","unavailable":false,"deprecated":false,"beta":false},{"name":"watchOS","introducedAt":"11.0","unavailable":false,"deprecated":false,"beta":false}],"externalID":"s:7SwiftUI4ViewPAAE16labelsVisibilityyQrAA0E0OF::SYNTHESIZED::s:5Swami20Interaction_DragViewV","title":"labelsVisibility(_:)","symbolKind":"method","role":"symbol"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"url":"\/documentation\/swami\/interaction_dragview","title":"Interaction_DragView","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/labelsVisibility(_:)":{"role":"symbol","type":"topic","abstract":[],"identifie