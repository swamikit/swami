roducedAt":"15.0"},{"deprecated":false,"beta":false,"name":"iPadOS","unavailable":false,"introducedAt":"15.0"},{"deprecated":false,"beta":false,"name":"Mac Catalyst","unavailable":false,"introducedAt":"15.0"},{"deprecated":false,"beta":false,"name":"macOS","unavailable":false,"introducedAt":"12.0"},{"unavailable":false,"beta":false,"name":"tvOS","deprecated":false,"introducedAt":"15.0"},{"unavailable":false,"beta":false,"name":"watchOS","deprecated":false,"introducedAt":"8.0"}],"role":"symbol","extendedModule":"SwiftUICore","modules":[{"name":"Swami","relatedModules":["SwiftUICore"]}],"externalID":"s:7SwiftUI4ViewPAAE18accessibilityRotor_7entriesQrAA4TextV_qd__yctAA013AccessibilityE7ContentRd__lF::SYNTHESIZED::s:5Swami20Interaction_DragViewV","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityRotor","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Text","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4TextV"},{"text":", ","kind":"text"},{"text":"entries","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"roleHeading":"Instance Method","symbolKind":"method"},"variants":[{"paths":["\/documentation\/swami\/interaction_dragview\/accessibilityrotor(_:entries:)-6amsa"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibilityRotor(_:entries:)-6amsa"},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"title":"Interaction_DragView","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","type":"topic","url":"\/documentation\/swami\/interaction_dragview","role":"symbol","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","kind":"symbol","role":"collection","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityRotor(_:entries:)-6amsa":{"role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/