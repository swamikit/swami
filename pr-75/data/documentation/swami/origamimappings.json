{"metadata":{"roleHeading":"Article","role":"article","title":"Origami → SwiftUI mappings","modules":[{"name":"Swami"}]},"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph."}],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"seeAlsoSections":[{"generated":true,"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"]}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI are both reactive dataflow, so the translator"},{"type":"text","text":" "},{"type":"text","text":"targets SwiftUI’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"state graph"}]},{"type":"text","text":" — computed properties, "},{"code":"@State","type":"codeVoice"},{"type":"text","text":", "},{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"not imperative functions. Each row below is a rule the codegen applies; the helper"},{"type":"text","text":" "},{"type":"text","text":"library ("},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","isActive":true},{"type":"text","text":", …) fills the gaps where a patch has no direct"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI equivalent."}],"type":"paragraph"},{"level":2,"text":"The four rules","type":"heading","anchor":"The-four-rules"},{"rows":[[[{"inlineContent":[{"text":"Origami","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Pure value patch (Add, Transition\/interpolate, logic)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"computed property \/ expression","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Interaction (Tap, Down\/press, Double Tap, Long Press)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"gesture + ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"@GestureState","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"State\/memory (Switch, Sample and Hold)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"@State"},{"type":"text","text":" + update logic"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Animation (Classic Animation, Pop\/Spring)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".animation(.spring)"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"The Origami layer tree becomes the SwiftUI ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" body. Origami ","type":"text"},{"code":"Transition","type":"codeVoice"},{"text":" means","type":"text"},{"text":" ","type":"text"},{"text":"interpolation (not SwiftUI’s ","type":"text"},{"code":".transition()","type":"codeVoice"},{"text":" modifier — that’s a different concept).","type":"text"}],"type":"paragraph"},{"level":3,"text":"Pure value patch → computed property","type":"heading","anchor":"Pure-value-patch-%E2%86%92-computed-property"},{"inlineContent":[{"type":"codeVoice","code":"Add"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Transition\/interpolate"},{"text":", and other pure-function patches carry no state.","type":"text"},{"text":" ","type":"text"},{"text":"They fan an input through math and emit an output. In SwiftUI that’s a computed","type":"text"},{"text":" ","type":"text"},{"text":"property (or an inline expression) — no ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":", no side effect.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Interaction → gesture + `@State`","type":"heading","anchor":"Interaction-%E2%86%92-gesture-+-State"},{"inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"code":"down","type":"codeVoice"},{"type":"text","text":", "},{"code":"position","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"onTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onDoubleTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onLongPress","type":"codeVoice"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" or fires a callback. The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction"},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}],"type":"paragraph"},{"level":3,"text":"State\/memory → `@State` + update logic","type":"heading","anchor":"Statememory-%E2%86%92-State-+-update-logic"},{"inlineContent":[{"type":"codeVoice","code":"Switch"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Sample and Hold"},{"type":"text","text":" remember a value across evaluations. That’s what"},{"type":"text","text":" "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" is for. Codegen emits the state variable plus the update path (a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, a "},{"type":"codeVoice","code":".onChange"},{"type":"text","text":", or an assignment inside a "},{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" block)."}],"type":"paragraph"},{"level":3,"text":"Animation → `withAnimation` \/ `.animation`","type":"heading","anchor":"Animation-%E2%86%92-withAnimation--animation"},{"inlineContent":[{"code":"Classic Animation","type":"codeVoice"},{"type":"text","text":", "},{"code":"Pop Animation","type":"codeVoice"},{"type":"text","text":", and other animation patches drive a value"},{"type":"text","text":" "},{"type":"text","text":"toward a target over time. In SwiftUI, that’s a state change wrapped in"},{"type":"text","text":" "},{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" or an "},{"code":".animation(_:value:)","type":"codeVoice"},{"type":"text","text":" modifier on the animated property."},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}],"type":"paragraph"},{"level":2,"text":"Flag, don’t fake","type":"heading","anchor":"Flag-dont-fake"},{"inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/origamimappings"]}],"references":{"doc://samatwork.Swami/documentation/Swami":{"title":"Swami","type":"topic","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".