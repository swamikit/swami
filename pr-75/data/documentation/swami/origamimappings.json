n inline expression) — no "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", no side effect."}]},{"anchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"type":"codeVoice","code":"down"},{"type":"text","text":", "},{"type":"codeVoice","code":"position"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"onTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" or fires a callback. The "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}]},{"anchor":"Statememory-%E2%86%92-State-+-update-logic","text":"State\/memory → `@State` + update logic","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Switch"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Sample and Hold"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"type":"codeVoice","code":".onChange"},{"text":", or an assignment inside a ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" block).","type":"text"}]},{"anchor":"Animation-%E2%86%92-withAnimation--animation","text":"Animation → `withAnimation` \/ `.animation`","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"code":"Classic Animation","type":"codeVoice"},{"type":"text","text":", "},{"code":"Pop Animation","type":"codeVoice"},{"type":"text","text":", and other animation patches drive a value"},{"type":"text","text":" "},{"type":"text","text":"toward a target over time. In SwiftUI, that’s a state change wrapped in"},{"type":"text","text":" "},{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" or an "},{"code":".animation(_:value:)","type":"codeVoice"},{"type":"text","text":" modifier on the animated property."},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}]},{"anchor":"Flag-dont-fake","text":"Flag, don’t fake","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,"},{"type":"text","text":" "},{"type":"text","text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over"},{"type":"text","text":" "},{"type":"text","text":"it. The current list: continuous-time springs, custom JavaScript patches,"},{"type":"text","text":" "},{"type":"text","text":"absolute-position layout."}]}]}],"variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"Reference","generated":true,"title":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"]}],"references":{"doc://samatwork.Swami/documentation/Swami/Drag":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drag"}],"identifier":"doc:\/\/samatwork.Swa