{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/origamimappings"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Reference","generated":true,"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"anchor":"Reference"}],"metadata":{"modules":[{"name":"Swami"}],"roleHeading":"Article","role":"article","title":"Origami → SwiftUI mappings"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"Origami’s patch graph and SwiftUI are both reactive dataflow, so the translator","type":"text"},{"text":" ","type":"text"},{"text":"targets SwiftUI’s ","type":"text"},{"inlineContent":[{"text":"state graph","type":"text"}],"type":"emphasis"},{"text":" — computed properties, ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":", ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"not imperative functions. Each row below is a rule the codegen applies; the helper","type":"text"},{"text":" ","type":"text"},{"text":"library (","type":"text"},{"isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","type":"reference"},{"text":", …) fills the gaps where a patch has no direct","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI equivalent.","type":"text"}],"type":"paragraph"},{"anchor":"The-four-rules","text":"The four rules","type":"heading","level":2},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami"}]}],[{"type":"paragraph","inlineContent":[{"text":"SwiftUI","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Pure value patch (Add, Transition\/interpolate, logic)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"computed property \/ expression"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Interaction (Tap, Down\/press, Double Tap, Long Press)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"gesture + ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"@GestureState"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"State\/memory (Switch, Sample and Hold)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@State"},{"type":"text","text":" + update logic"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Animation (Classic Animation, Pop\/Spring)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"withAnimation","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".animation(.spring)","type":"codeVoice"}]}]]],"type":"table"},{"inlineContent":[{"text":"The Origami layer tree becomes the SwiftUI ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" body. Origami ","type":"text"},{"code":"Transition","type":"codeVoice"},{"text":" means","type":"text"},{"text":" ","type":"text"},{"text":"interpolation (not SwiftUI’s ","type":"text"},{"code":".transition()","type":"codeVoice"},{"text":" modifier — that’s a different concept).","type":"text"}],"type":"paragraph"},{"anchor":"Pure-value-patch-%E2%86%92-computed-property","text":"Pure value patch → computed property","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":"Add"},{"type":"text","text":", "},{"type":"codeVoice","code":"Transition\/interpolate"},{"type":"text","text":", and other pure-function patches carry no state."},{"type":"text","text":" "},{"type":"text","text":"They fan an input through math and emit an output. In SwiftUI that’s a computed"},{"type":"text","text":" "},{"type":"text","text":"property (or an inline expression) — no "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", no side effect."}],"type":"paragraph"},{"anchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"type":"codeVoice","code":"down"},{"type":"text","text":", "},{"type":"codeVoice","code":"position"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"onTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" or fires a callback. The "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}],"type":"paragraph"},{"anchor":"Statememory-%E2%86%92-State-+-update-logic","text":"State\/memory → `@State` + update logic","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":"Switch"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Sample and Hold"},{"type":"text","text":" remember a value across evaluations. That’s what"},{"type":"text","text":" "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" is for. Codegen emits the state variable plus the update path (a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, a "},{"type":"codeVoice","code":".onChange"},{"type":"text","text":", or an assignment inside a "},{"code":"withAnimation","type":"codeVoice"},{"text":" block).","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Animation-%E2%86%92-withAnimation--animation","type":"heading","text":"Animation → `withAnimation` \/ `.animation`"},{"inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Pop Animation"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" or an ","type":"text"},{"type":"codeVoice","code":".animation(_:value:)"},{"text":" modifier on the animated property.","type":"text"},{"text":" ","type":"text"},{"text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged","type":"text"},{"text":" ","type":"text"},{"text":"by the parser — Swami won’t fake them.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Flag-dont-fake","type":"heading","text":"Flag, don’t fake"},{"inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph.","type":"text"}],"references":{"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","role":"collection","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Drag":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","role":"symbol","title":"Drag","navigatorTitle":[{"kind":"identifier","text":"Drag"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drag"}],"type":"topic","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Drag"}]},{"type":"text","text":" patch ("},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":")."}],"kind":"symbol","url":"\/documentation\/swami\/drag"},"doc://samatwork.Swami/documentation/Swami/Beats":{"abstract":[{"type":"text","text":"The four-beat discipline that keeps the translator honest: one pattern per branch,"},{"type":"text","text":" "},{"type":"text","text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship"},{"type":"text","text":" "},{"type":"text","text":"only on Reviewer approval plus a human spot-check."}],"url":"\/documentation\/swami\/beats","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats","title":"Beats","role":"article","kind":"artic