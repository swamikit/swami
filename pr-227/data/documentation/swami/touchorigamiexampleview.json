mple."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"topic","kind":"symbol","url":"\/documentation\/swami","title":"Swami","role":"collection"},"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView/View-Implementations":{"url":"\/documentation\/swami\/touchorigamiexampleview\/view-implementations","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView\/View-Implementations","type":"topic","abstract":[],"title":"View Implementations","role":"collectionGroup","kind":"article"}}}