{"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"roleHeading":"Sample Code","role":"sampleCode","title":"Interaction — Drag","modules":[{"name":"Swami"}]},"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"],"anchor":"Related-Documentation","title":"Related Documentation"}],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Preview","anchor":"Preview"},{"type":"paragraph","inlineContent":[{"text":"The preview image is generated by the CI render pipeline, never hand-committed:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"verify.yml","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"pixel-gate","type":"codeVoice"},{"text":" job) renders Origami’s artboard and SwamiHost’s","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI side-by-side at matching simulator dimensions.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"post-merge.yml","type":"text"}]},{"type":"text","text":" copies the SwamiHost render into"},{"type":"text","text":" "},{"type":"codeVoice","code":"Resources\/Patterns\/Interaction_Drag.png"},{"type":"text","text":" after a pattern lands on ma