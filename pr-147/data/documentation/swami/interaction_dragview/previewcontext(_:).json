ami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","role":"symbol","url":"\/documentation\/swami\/interaction_dragview"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/previewContext(_:)":{"role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/previewContext(_:)","title":"previewContext(_:)","url":"\/documentation\/swami\/interaction_dragview\/previewcontext(_:)","abstract":[],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"previewContext"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}]}}}