 ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","role":"symbol","kind":"symbol","url":"\/documentation\/swami\/interaction_dragview"}}}