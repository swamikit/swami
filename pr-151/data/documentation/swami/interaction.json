ed after the Origami ","type":"text"},{"inlineContent":[{"text":"patch","type":"text"}],"type":"emphasis"},{"text":", bare (no prefix) —","type":"text"},{"text":" ","type":"text"},{"text":"disambiguate with the module (","type":"text"},{"code":"OrigamiPatterns.Interaction","type":"codeVoice"},{"text":") if it ever collides. This one","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t clash with anything in SwiftUI.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"composes off them, matching the graph:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"down"},{"type":"text","text":" — "},{"type":"codeVoice","code":"true"},{"type":"text","text":" while a finger is on the layer,"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"position","type":"codeVoice"},{"text":" — the touch point, in the layer’s coordinate space,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"onTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":" — discrete pulses.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Only the gesture for an output you actually request is attached — so a tap-only layer"},{"type":"text","text":" "},{"type":"text","text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","interfaceLanguage":"swift"},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction/body(content:)":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","t