{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI are both reactive dataflow, so the translator"},{"type":"text","text":" "},{"type":"text","text":"targets SwiftUI’s "},{"inlineContent":[{"type":"text","text":"state graph"}],"type":"emphasis"},{"type":"text","text":" — computed properties, "},{"code":"@State","type":"codeVoice"},{"type":"text","text":", "},{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"not imperative functions. Each row below is a rule the codegen applies; the helper"},{"type":"text","text":" "},{"type":"text","text":"library ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag"},{"type":"text","text":", …) fills the gaps where a patch has no direct"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI equivalent."}],"type":"paragraph"},{"level":2,"anchor":"The-four-rules","type":"heading","text":"The four rules"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Origami","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"SwiftUI","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Pure value patch (Add, Transition\/interpolate, logic)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"computed property \/ expression","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interaction (Tap, Down\/press, Double Tap, Long Press)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"gesture + "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"@GestureState","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"State\/memory (Switch, Sample and Hold)"}]}],[{"type":"paragraph","inlineContent":[{"code":"@State","type":"codeVoice"},{"text":" + update logic","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Animation (Classic Animation, Pop\/Spring)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"withAnimation","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".animation(.spring)","type":"codeVoice"}]}]]]},{"inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"code":"View","type":"codeVoice"},{"type":"text","text":" body. Origami "},{"code":"Transition","type":"codeVoice"},{"type":"text","text":" means"},{"type":"text","text":" "},{"type":"text","text":"interpolation (not SwiftUI’s "},{"code":".transition()","type":"codeVoice"},{"type":"text","text":" modifier — that’s a different concept)."}],"type":"paragraph"},{"level":3,"anchor":"Pure-value-patch-%E2%86%92-computed-property","type":"heading","text":"Pure value patch → computed property"},{"inlineContent":[{"type":"codeVoice","code":"Add"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Transition\/interpolate"},{"text":", and other pure-function patches carry no state.","type":"text"},{"text":" ","type":"text"},{"text":"They fan an input through math and emit an output. In SwiftUI that’s a computed","type":"text"},{"text":" ","type":"text"},{"text":"property (or an inline expression) — no ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":", no side effect.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Interaction-%E2%86%92-gesture-+-State","type":"heading","text":"Interaction → gesture + `@State`"},{"inlineContent":[{"text":"Origami’s Interaction patch exposes discrete output ports: ","type":"text"},{"code":"down","type":"codeVoice"},{"text":", ","type":"text"},{"code":"position","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"onTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":". Each maps to a SwiftUI gesture recognizer","type":"text"},{"text":" ","type":"text"},{"text":"whose output lands in ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" or fires a callback. The ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true,"type":"reference"},{"text":" helper","type":"text"},{"text":" ","type":"text"},{"text":"attaches only the recognizer for each output the caller requests, which keeps","type":"text"},{"text":" ","type":"text"},{"text":"gesture arbitration clean.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Statememory-%E2%86%92-State-+-update-logic","type":"heading","text":"State\/memory → `@State` + update logic"},{"inlineContent":[{"code":"Switch","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Sample and Hold","type":"codeVoice"},{"type":"text","text":" remember a value across evaluations. That’s what"},{"type":"text","text":" "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" is for. Codegen emits the state variable plus the update path (a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, a "},{"code":".onChange","type":"codeVoice"},{"type":"text","text":", or an assignment inside a "},{"code":"withAnimation","type":"codeVoice"},{"text":" block).","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Animation-%E2%86%92-withAnimation--animation","type":"heading","text":"Animation → `withAnimation` \/ `.animation`"},{"inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":", and other animation patches drive a value"},{"type":"text","text":" "},{"type":"text","text":"toward a target over time. In SwiftUI, that’s a state change wrapped in"},{"type":"text","text":" "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".animation(_:value:)"},{"type":"text","text":" modifier on the animated property."},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}],"type":"paragraph"},{"level":2,"anchor":"Flag-dont-fake","type":"heading","text":"Flag, don’t fake"},{"inlineContent":[{"type":"text","text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,"},{"type":"text","text":" "},{"type":"text","text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over"},{"type":"text","text":" "},{"type":"text","text":"it. The current list: continuous-time springs, custom JavaScript patches,"},{"type":"text","text":" "},{"type":"text","text":"absolute-position layout."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"Swami"}],"role":"article","title":"Origami → SwiftUI mappings","roleHeading":"Article"},"kind":"article","hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/origamimappings"]}],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph."}],"seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"generated":true,"anchor":"Reference"}],"references":{"doc://samatwork.Swami/documentation/Swami/Beats":{"type":"topic","role":"article","title":"Beats","abstract":[{"type":"text","text":"The four-beat discipline that keeps the translator honest: one pattern per branch,"},{"type":"text","text":" "},{"type":"text","text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship"},{"type":"text","text":" "},{"type":"text","text":"only on Reviewer approval plus a human spot-check."}],"url":"\/documentation\/swami\/beats","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats","kind":"article"},"doc://samatwork.Swami/documentation/Swami/Interaction":{"title":"Interaction","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Interaction"}]},{"type":"text","text":" patch."}],"url":"\/documentation\/swami\/interaction","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Interaction"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction"}]},"doc://samatwork.Swami/documentation/Swami/Drag":{"title":"Drag","type":"topic","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"text":"Drag","type":"text"}]},{"type":"text","text":" patch ("},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":")."}],"role":"symbol","navigatorTitle":[{"text":"Drag","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drag","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","url":"\/documentation\/swami\/drag"},"doc://samatwork.Swami/documentation/Swami":{"title":"Swami","url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol","role":"collection","type":"topic","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}]}}}