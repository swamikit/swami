ich wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"url":"\/documentation\/swami\/interaction_dragview","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView","type":"topic","role":"symbol","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/searchCompletion(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"searchCompletion","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"role":"symbol","title":"searchCompletion(_:)","kind":"symbol","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/searchCompletion(_:)","url":"\/documentation\/swami\/interaction_dragview\/searchcompletion(_:)","abstract":[]}}}