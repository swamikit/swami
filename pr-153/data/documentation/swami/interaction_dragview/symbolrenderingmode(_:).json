onds to touch input via Origami’s ","type":"text"},{"type":"codeVoice","code":"origami.Drag"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","url":"\/documentation\/swami\/interaction_dragview","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"title":"Interaction_DragView","type":"topic","role":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/symbolRenderingMode(_:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"symbolRenderingMode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SymbolRenderingMode","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI19SymbolRenderingModeV"},{"text":"?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/symbolRenderingMode(_:)","kind":"symbol","title":"symbolRenderingMode(_:)","type":"topic","abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/symbolrenderingmode(_:)"}}}