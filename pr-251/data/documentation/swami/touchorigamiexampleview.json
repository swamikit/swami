mple."}],"title":"Swami","role":"collection","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol","url":"\/documentation\/swami"},"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView/View-Implementations":{"type":"topic","title":"View Implementations","role":"collectionGroup","kind":"article","url":"\/documentation\/swami\/touchorigamiexampleview\/view-implementations","abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView\/View-Implementations"}}}