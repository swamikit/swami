:"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"title":"Swami","role":"collection","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol","url":"\/documentation\/swami"}}}