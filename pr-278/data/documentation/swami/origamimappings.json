ng","text":"The four rules"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami"}]}],[{"type":"paragraph","inlineContent":[{"text":"SwiftUI","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pure value patch (Add, Transition\/interpolate, logic)"}]}],[{"type":"paragraph","inlineContent":[{"text":"computed property \/ expression","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interaction (Tap, Down\/press, Double Tap, Long Press)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"gesture + "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"@GestureState"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"origami.drag"},{"type":"text","text":" — Drag"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)"},{"text":" (helper)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"builtin.layer.shape","type":"codeVoice"},{"text":" — Shape (triangle)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/RoundedTriangle","type":"reference","isActive":true},{"type":"text","text":" (helper)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Magnification \/ Pinch","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MagnifyGesture"},{"type":"text","text":" (native)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"origami.PopSwitch","type":"codeVoice"},{"type":"text","text":" — Pop Switch"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@State"},{"type":"text","text":" flipped on a threshold, "},{"type":"codeVoice","code":".spring"},{"type":"text","text":" pop (native)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"State\/memory (Switch, Sample and Hold)"}]}],[{"type":"paragraph","inlineContent":[{"code":"@State","type":"codeVoice"},{"type":"text","text":" + update logic"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Animation (Classic Animation, Pop\/Spring)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".animation(.spring)"}]}]]],"type":"table"},{"inlineContent":[{"text":"The Origami layer tree becomes the SwiftUI ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" body. Origami ","type":"text"},{"code":"Transition","type":"codeVoice"},{"text":" means","type":"text"},{"text":" ","type":"text"},{"text":"interpolation (not SwiftUI’s ","type":"text"},{"code":".transition()","type":"codeVoice"},{"text":" modifier — that’s a different concept).","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Pure-value-patch-%E2%86%92-computed-property","text":"Pure value patch → computed property"},{"inlineContent":[{"code":"Add","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Transition\/interpolate","type":"codeVoice"},{"text":", and other pure-function patches carry no state.","type":"text"},{"text":" ","type":"text"},{"text":"They fan an input through math and emit an output. In SwiftUI that’s a computed","type":"text"},{"text":" ","type":"text"},{"text":"property (or an inline expression) — no ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":", no side effect.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`"},{"inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"code":"down","type":"codeVoice"},{"type":"text","text":", "},{"code":"position","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"onTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onDoubleTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onLongPress","type":"codeVoice"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" or fires a callback. The "},{"isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference"},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Statememory-%E2%86%92-State-+-update-logic","text":"State\/memory → `@State` + update logic"},{"inlineContent":[{"type":"codeVoice","code":"Switch"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Sample and Hold"},{"type":"text","text":" remember a value across evaluations. That’s what"},{"type":"text","text":" "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" is for. Codegen emits the state variable plus the update path (a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, a "},{"type":"codeVoice","code":".onChange"},{"type":"text","text":", or an assignment inside a "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" block)."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Animation-%E2%86%92-withAnimation--animation","text":"Animation → `withAnimation` \/ `.animation`"},{"inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":", and other animation patches drive a value"},{"type":"text","text":" "},{"type":"text","text":"toward a target over time. In SwiftUI, that’s a state change wrapped in"},{"type":"text","text":" "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".animation(_:value:)"},{"type":"text","text":" modifier on the animated property."},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Flag-dont-fake","text":"Flag, don’t fake"},{"inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://samatwork.Swami/documentation/Swami/Beats":{"abstract":[{"type":"text","text":"The four-beat discipline that keeps the translator honest: one pattern per branch,"},{"type":"text","text":" "},{"type":"text","text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship"},{"type":"text","text":" "},{"type":"text","text":"only on Reviewer approval plus a human spot-check."}],"type":"topic","role":"article","kind":"article","url":"\/documentation\/swami\/beats","title":"Beats","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"},"doc://samatwork.Swami/documentation/Swami":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol","type":"topic","title":"Swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" 