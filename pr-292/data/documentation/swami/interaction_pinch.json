{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_pinch"]}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"title":"Patterns","anchor":"Patterns","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"text":"Preview","type":"heading","level":2,"anchor":"Preview"},{"type":"paragraph","inlineContent":[{"identifier":"Interaction_Pinch","type":"image"}]},{"text":"The patch","type":"heading","level":2,"anchor":"The-patch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami drives this with an "},{"code":"origami.PopSwitch","type":"codeVoice"},{"type":"text","text":" — a remembered on\/off state — flipped by"},{"type":"text","text":" "},{"type":"text","text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight"},{"type":"text","text":" "},{"type":"text","text":"onto native SwiftUI, which is the reusable idea worth taking away. A "},{"code":"MagnifyGesture","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"reads the pinch, a "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" flag flips at a threshold, and a "},{"code":".spring","type":"codeVoice"},{"type":"text","text":" animates the"},{"type":"text","text":" "},{"type":"text","text":"scale between the two states (see the State\/memory → "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" row in"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","type":"reference"},{"type":"text","text":")."}]},{"type":"codeListing","code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not"},{"type":"text","text":" "},{"type":"text","text":"a scale that tracks your fingers continuously."}]},{"text":"How it’s built","type":"heading","level":2,"anchor":"How-its-built"},{"type":"paragraph","inlineContent":[{"text":"The full view sits the white rounded triangle on the magenta artboard and adds a live","type":"text"},{"text":" ","type":"text"},{"code":"@GestureState","type":"codeVoice"},{"text":" so the shape follows your fingers mid-pinch before it settles on the","type":"text"},{"text":" ","type":"text"},{"text":"popped state. Read the source (below) for the whole thing.","type":"text"}]},{"text":"Behavior","type":"heading","level":2,"anchor":"Behavior"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Pinch out on the shape to grow it; pinch in to shrink it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross the threshold and it snaps to the next size with a spring, rather than","type":"text"},{"text":" ","type":"text"},{"text":"tracking your fingers continuously.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The switch remembers its state, so a release between pinches holds the current size."}]}]}]},{"text":"Downloads","type":"heading","level":2,"anchor"