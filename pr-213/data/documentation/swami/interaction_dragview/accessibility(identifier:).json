dentifier":"s:7SwiftUI15ModifiedContentV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AccessibilityAttachmentModifier","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI31AccessibilityAttachmentModifierV"},{"text":">","kind":"text"}],"roleHeading":"Instance Method","role":"symbol","platforms":[{"deprecatedAt":"100000.0","deprecated":false,"renamed":"accessibilityIdentifier(_:)","unavailable":false,"beta":false,"name":"iOS","introducedAt":"13.0"},{"deprecatedAt":"100000.0","deprecated":false,"renamed":"accessibilityIdentifier(_:)","unavailable":false,"beta":false,"name":"iPadOS","introducedAt":"13.0"},{"deprecatedAt":"100000.0","deprecated":false,"renamed":"accessibilityIdentifier(_:)","unavailable":false,"beta":false,"name":"Mac Catalyst","introducedAt":"13.0"},{"deprecatedAt":"100000.0","deprecated":false,"renamed":"accessibilityIdentifier(_:)","unavailable":false,"beta":false,"name":"macOS","introducedAt":"10.15"},{"deprecatedAt":"100000.0","deprecated":false,"renamed":"accessibilityIdentifier(_:)","unavailable":false,"beta":false,"name":"tvOS","introducedAt":"13.0"},{"deprecatedAt":"100000.0","deprecated":false,"renamed":"accessibilityIdentifier(_:)","unavailable":false,"beta":false,"name":"visionOS","introducedAt":"1.0"},{"deprecatedAt":"100000.0","deprecated":false,"renamed":"accessibilityIdentifier(_:)","unavailable":false,"beta":false,"name":"watchOS","introducedAt":"6.0"}],"modules":[{"relatedModules":["SwiftUICore"],"name":"Swami"}]},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"]]},"kind":"symbol","references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView","role":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_dragview","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}]},"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","title":"Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic","url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibility(identifier:)":{"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibility(identifier