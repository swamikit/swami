text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/swami\/interaction_dragview","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"title":"Interaction_DragView","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/persistentSystemOverlays(_:)":{"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/persistentSystemOverlays(_:)","kind":"symbol","url":"\/documentation\/swami\/interaction_dragview\/persistentsystemoverlays(_:)","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"persistentSystemOverlays","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Visibility","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI10VisibilityO"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"title":"persistentSystemOverlays(_:)","role":"symbol"}}}