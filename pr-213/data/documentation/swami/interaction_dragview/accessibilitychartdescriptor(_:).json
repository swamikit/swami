xt":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic","url":"\/documentation\/swami","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityChartDescriptor(_:)":{"title":"accessibilityChartDescriptor(_:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibilityChartDescriptor(_:)","kind":"symbol","type":"topic","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityChartDescriptor","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"url":"\/documentation\/swami\/interaction_dragview\/accessibilitychartdescriptor(_:)","role":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"url":"\/documentation\/swami\/interaction_dragview","kind":"symbol","title":"Interaction_DragView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"type":"topic","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"identifier":"doc:\/\/samatwork.Swami\/d