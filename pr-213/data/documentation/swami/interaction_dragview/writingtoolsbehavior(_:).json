ami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic","url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/writingToolsBehavior(_:)":{"type":"topic","kind":"symbol","title":"writingToolsBehavior(_:)","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"writingToolsBehavior","kind":"identifier"},{"text":"(","kind":"text"},{"text":"WritingToolsBehavior","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI20WritingToolsBehaviorV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/writingToolsBehavior(_:)","url":"\/documentation\/swami\/interaction_dragview\/writingtoolsbehavior(_:)","role":"symbol"}}}