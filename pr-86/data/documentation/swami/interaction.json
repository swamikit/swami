: helpers are named after the Origami ","type":"text"},{"inlineContent":[{"type":"text","text":"patch"}],"type":"emphasis"},{"text":", bare (no prefix) —","type":"text"},{"text":" ","type":"text"},{"text":"disambiguate with the module (","type":"text"},{"code":"OrigamiPatterns.Interaction","type":"codeVoice"},{"text":") if it ever collides. This one","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t clash with anything in SwiftUI.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"composes off them, matching the graph:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"down","type":"codeVoice"},{"text":" — ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" while a finger is on the layer,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"position"},{"type":"text","text":" — the touch point, in the layer’s coordinate space,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"onTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":" — discrete pulses.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Only the gesture for an output you actually request is attached — so a tap-only layer"},{"type":"text","text":" "},{"type":"text","text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction"},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction/ViewModifier-Implementations":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/ViewMo