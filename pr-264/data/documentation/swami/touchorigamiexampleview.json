truct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_pinchview","title":"Interaction_PinchView","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","abstract":[{"type":"text","text":"Pinch to scale a shape. A magnification (pinch) gesture drives an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"state feeds the shape’s Transform Scale ("},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":"); releasing the pinch “pops” the"},{"type":"text","text":" "},{"type":"text","text":"switch to its nearest state with a spring. At rest a white triangle sits at its base scale on"},{"type":"text","text":" "},{"type":"text","text":"the magenta artboard."}],"type":"topic"},"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView":{"url":"\/documentation\/swami\/touchorigamiexampleview","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TouchOrigamiExampleView","kind":"identifier"}],"navigatorTitle":[{"text":"TouchOrigamiExampleView","kind":"identifier"}],"abstract":[{"type":"text","text":"Artboard 1 → Group (vertical stack of cards)."}],"title":"TouchOrigamiExampleView","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView"},"doc://samatwork.Swami/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/samatwork.Swami\/s8SendableP","title":"Swift.Sendable"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"url":"\/documentation\/swami\/interaction_dragview","title":"Interaction_DragView","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","type":"topic","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"role":"symbol","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami":{"role":"collection","kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","type":"topic","title":"Swami"}}}