le":"TouchOrigamiExampleView","navigatorTitle":[{"text":"TouchOrigamiExampleView","kind":"identifier"}],"role":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"abstract":[{"text":"Pinch to scale a rounded triangle. A magnification (pinch) gesture feeds the shape’s","type":"text"},{"text":" ","type":"text"},{"text":"Transform Scale (","type":"text"},{"type":"codeVoice","code":"builtin.point3D"},{"text":"), gated by ","type":"text"},{"type":"codeVoice","code":"origami.PopSwitch"},{"text":" paging; releasing settles","type":"text"},{"text":" ","type":"text"},{"text":"to the nearest state with a spring. At rest a white rounded triangle sits at its base scale,","type":"text"},{"text":" ","type":"text"},{"text":"centered on the magenta artboard.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"role":"symbol","type":"topic","title":"Interaction_PinchView","url":"\/documentation\/swami\/interaction_pinchview","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","kind":"symbol"},"doc://samatwork.Swami/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/samatwork.Swami\/s8SendableP","title":"Swift.Sendable"},"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView/init()":{"type":"topic","title":"init()","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"role":"symbol","url":"\/documentation\/swami\/touchorigamiexampleview\/init()","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView\/init()","abstract":[],"kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView/body":{"role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView\/body","type":"topic","url":"\/documentation\/swami\/touchorigamiexampleview\/body