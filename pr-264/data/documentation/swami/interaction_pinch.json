{"primaryContentSections":[{"kind":"content","content":[{"text":"Mapping","type":"heading","anchor":"Mapping","level":2},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"origami.PopSwitch"},{"text":" — Pop Switch","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"@State","type":"codeVoice"},{"type":"text","text":" + "},{"code":"withAnimation(.spring)","type":"codeVoice"},{"type":"text","text":" (native)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Magnification (pinch) gesture","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"MagnifyGesture","type":"codeVoice"},{"text":" (native)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":" — Transform Scale"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View\/scaleEffect(_:anchor:)"},{"text":" (native)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"builtin.layer.shape","type":"codeVoice"},{"type":"text","text":" — shape"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shape"},{"type":"text","text":" (upward triangle, native)"}]}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The two "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" nodes carry the X and Y components of the scale"},{"type":"text","text":" "},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":"; a uniform pinch flips them together, so a single "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" Bool models"},{"type":"text","text":" "},{"type":"text","text":"both faithfully. The visible constants — the white triangle (Origami’s default Shape"},{"type":"text","text":" "},{"type":"text","text":"geometry), the magenta "},{"type":"codeVoice","code":"#DD70DF"},{"type":"text","text":" artboard, and the shape’s proportions — are matched to"},{"type":"text","text":" "},{"type":"text","text":"the Origami reference render (the pixel oracle the runner screenshots). The magnified-scale"},{"type":"text","text":" "},{"type":"text","text":"endpoint and the exact point size remain documented placeholders pending parser input-port"},{"type":"text","text":" "},{"type":"text","text":"decoding (see the source header)."}]},{"text":"Preview","type":"heading","anchor":"Preview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The preview image is generated by the CI render pipeline, never hand-committed:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"verify.yml"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"pixel-gate"},{"type":"text","text":" job) renders Origami’s artboard and SwamiHost’s"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI side-by-side at matching simulator dimensions."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"post-merge.yml"}]},{"text":" copies the SwamiHost render into","type":"text"},{"text":" ","type":"text"},{"code":"Resources\/Patterns\/Interaction_Pinch.png","type":"codeVoice"},{"text":" after a pattern lands on main.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"publish-docs.yml","type":"text"}],"type":"strong"},{"type":"text","text":" picks up the committed PNG and includes it in the"},{"type":"text","text":" "},{"type":"text","text":"DocC archive published to GitHub Pages."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"The artifact path is: ","type":"text"},{"code":"app\/Swami\/Swami.docc\/Resources\/Patterns\/Interaction_Pinch.png","type":"codeVoice"}]}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView"]}],"metadata":{"roleHeading":"Sample Code","role":"sampleCode","modules":[{"name":"Swami"}],"title":"Interaction — Pinch"},"abstract":[{"type":"text","text":"Pinch to scale a shape. A magnification (pinch) gesture drives an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" "},{"type":"text","text":"whose state feeds the shape’s Transform Scale ("},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":"); releasing the pinch"},{"type":"text","text":" "},{"type":"text","text":"“pops” the switch to its nearest state with a spring. At rest a white triangle sits at"},{"type":"text","text":" "},{"type":"text","text":"its base scale on the magenta artboard."}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_pinch"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch"},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"role":"symbol","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_pinchview","title":"Interaction_PinchView","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","abstract":[{"type":"text","text":"Pinch to scale a shape. A magnification (pinch) gesture drives an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"state feeds the shape’s Transform Scale ("},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":"); releasing the pinch “pops” the"},{"type":"text","text":" "},{"type":"text","text":"switch to its nearest state with a spring. At rest a white triangle sits at its base scale on"},{"type":"text","text":" "},{"type":"text","text":"the magenta artboard."}],"type":"topic"},"doc://samatwork.Swami/documentation/Swami":{"role":"collection","kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","type":"topic","title":"Swami"}}}