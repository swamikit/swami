type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"role":"collection","type":"topic","title":"Swami","url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"abstract":[{"text":"Pinch to scale a rounded triangle. A magnification (pinch) gesture feeds the shape’s","type":"text"},{"text":" ","type":"text"},{"text":"Transform Scale (","type":"text"},{"type":"codeVoice","code":"builtin.point3D"},{"text":"), gated by ","type":"text"},{"type":"codeVoice","code":"origami.PopSwitch"},{"text":" paging; releasing settles","type":"text"},{"text":" ","type":"text"},{"text":"to the nearest state with a spring. At rest a white rounded triangle sits at its base scale,","type":"text"},{"text":" ","type":"text"},{"text":"centered on the magenta artboard.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"role":"symbol","type":"topic","title":"Interaction_PinchView","url":"\/documentation\/swami\/interaction_pinchview","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","kind":"symbol"}}}