hView\/contextMenu(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contextMenu","kind":"identifier"},{"text":"<","kind":"text"},{"text":"MenuItems","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:7SwiftUI11ContextMenuV","text":"ContextMenu","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"MenuItems","kind":"typeIdentifier"},{"text":">?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"deprecated":true,"abstract":[],"type":"topic","kind":"symbol","title":"contextMenu(_:)"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"role":"symbol","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_pinchview","title":"Interaction_PinchView","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","abstract":[{"type":"text","text":"Pinch to scale a shape. A magnification (pinch) gesture drives an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"state feeds the shape’s Transform Scale ("},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":"); releasing the pinch “pops” the"},{"type":"text","text":" "},{"type":"text","text":"switch to its nearest state with a spring. At rest a white triangle sits at its base scale on"},{"type":"text","text":" "},{"type":"text","text":"the magenta artboard."}],"type":"topic"},"doc://samatwork.Swami/documentation/Swami":{"role":"collection","kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","type":"topic","title":"Swami"}}}