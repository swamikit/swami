ose"},{"type":"text","text":" "},{"type":"text","text":"state feeds the shape’s Transform Scale ("},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":"); releasing the pinch “pops” the"},{"type":"text","text":" "},{"type":"text","text":"switch to its nearest state with a spring. At rest the shape sits at its base scale on the"},{"type":"text","text":" "},{"type":"text","text":"artboard background."}],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","url":"\/documentation\/swami\/interaction_pinchview","kind":"symbol","title":"Interaction_PinchView","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_PinchView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/coordinateSpace(_:)":{"type":"topic","url":"\/documentation\/swami\/interaction_pinchview\/coordinatespace(_:)","role":"symbol","title":"coordinateSpace(_:)","abstract":[],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"coordinateSpace","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NamedCoordinateSpace","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI20NamedCoordinateSpaceV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/coordinateSpace(_:)"}}}