e","code":"origami.PopSwitch"},{"type":"text","text":" paging; releasing settles"},{"type":"text","text":" "},{"type":"text","text":"to the nearest state with a spring. At rest a white rounded triangle sits at its base scale,"},{"type":"text","text":" "},{"type":"text","text":"centered on the magenta artboard."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_PinchView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}],"kind":"symbol"}}}