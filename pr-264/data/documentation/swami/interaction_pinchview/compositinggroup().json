nchView"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/compositingGroup()"},"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"View.compositingGroup()"},{"type":"text","text":"."}],"references":{"doc://samatwork.Swami/documentation/Swami":{"role":"collection","kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","type":"topic","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/compositingGroup()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compositingGroup","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"role":"symbol","url":"\/documentation\/swami\/interaction_pinchview\/compositinggroup()","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/compositingGroup()","title":"compositingGroup()","abstract":[],"type":"topic","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"role":"symbol","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_pinchview","title":"Interaction_PinchView","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","abstract":[{"type":"text","text":"Pinch to scale a shape. A magnification (pinch) gesture drives an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"state feeds the shape’s Transform Scale ("},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":"); releasing the pinch “pops” the"},{"type":"text","text":" "},{"type":"text","text":"switch to its nearest state with a spring. At rest a white triangle sits at its base scale on"},{"type":"text","text":" "},{"type":"text","text":"the magenta artboard."}],"type":"topic"}}}