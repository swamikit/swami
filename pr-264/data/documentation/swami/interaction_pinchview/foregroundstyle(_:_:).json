es"},{"type":"text","text":" "},{"type":"text","text":"to the nearest state with a spring. At rest a white rounded triangle sits at its base scale,"},{"type":"text","text":" "},{"type":"text","text":"centered on the magenta artboard."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_PinchView"}],"url":"\/documentation\/swami\/interaction_pinchview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}]}}}