nt3D"},{"type":"text","text":"); releasing the pinch “pops” the"},{"type":"text","text":" "},{"type":"text","text":"switch to its nearest state with a spring. At rest a white triangle sits at its base scale on"},{"type":"text","text":" "},{"type":"text","text":"the magenta artboard."}],"type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/accessibilityDropPoint(_:description:isEnabled:)-495nd":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityDropPoint","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:7SwiftUI9UnitPointV","text":"UnitPoint","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"description","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"isEnabled","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI15ModifiedContentV","text":"ModifiedContent","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI31AccessibilityAttachmentModifierV","text":"AccessibilityAttachmentModifier","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/accessibilityDropPoint(_:description:isEnabled:)-495nd","kind":"symbol","url":"\/documentation\/swami\/interaction_pinchview\/accessibilitydroppoint(_:description:isenabled:)-495nd","title":"accessibilityDropPoint(_:description:isEnabled:)","abstract":[]}}}