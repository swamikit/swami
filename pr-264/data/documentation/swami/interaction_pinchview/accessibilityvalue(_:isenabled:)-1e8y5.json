nification (pinch) gesture feeds the shape’s"},{"type":"text","text":" "},{"type":"text","text":"Transform Scale ("},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":"), gated by "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" paging; releasing settles"},{"type":"text","text":" "},{"type":"text","text":"to the nearest state with a spring. At rest a white rounded triangle sits at its base scale,"},{"type":"text","text":" "},{"type":"text","text":"centered on the magenta artboard."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_PinchView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}],"kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/accessibilityValue(_:isEnabled:)-1e8y5":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityValue"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4TextV","text":"Text"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI15ModifiedContentV","text":"ModifiedContent"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI31AccessibilityAttachmentModifierV","text":"AccessibilityAttachmentModifier"},{"kind":"text","text":">"}],"role":"symbol","url":"\/documentation\/swami\/interaction_pinchview\/accessibilityvalue(_:isenabled:)-1e8y5","type":"topic","abstract":[],"title":"accessibilityValue(_:isEnabled:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/accessibilityValue(_:isEnabled:)-1e8y5"},"doc://samatwork.Swami/documentati