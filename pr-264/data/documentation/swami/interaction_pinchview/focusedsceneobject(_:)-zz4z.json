n\/swami","type":"topic","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"role":"symbol","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_pinchview","title":"Interaction_PinchView","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","abstract":[{"type":"text","text":"Pinch to scale a shape. A magnification (pinch) gesture drives an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"state feeds the shape’s Transform Scale ("},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":"); releasing the pinch “pops” the"},{"type":"text","text":" "},{"type":"text","text":"switch to its nearest state with a spring. At rest a white triangle sits at its base scale on"},{"type":"text","text":" "},{"type":"text","text":"the magenta artboard."}],"type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/focusedSceneObject(_:)-zz4z":{"type":"topic","title":"focusedSceneObject(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"focusedSceneObject"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":"?) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"url":"\/documentation\/swami\/interaction_pinchview\/focusedsceneobject(_:)-zz4z","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/focusedSceneObject(_:)-zz4z","kind":"symbol","abstract":[]}}}