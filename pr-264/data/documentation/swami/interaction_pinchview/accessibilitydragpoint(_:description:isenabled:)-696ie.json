:[],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"abstract":[{"type":"text","text":"Pinch to scale a shape. A magnification (pinch) gesture drives an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" whose"},{"type":"text","text":" "},{"type":"text","text":"state feeds the shape’s Transform Scale ("},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":"); releasing the pinch “pops” the"},{"type":"text","text":" "},{"type":"text","text":"switch to its nearest state with a spring. At rest the shape sits at its base scale on the"},{"type":"text","text":" "},{"type":"text","text":"artboard background."}],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","url":"\/documentation\/swami\/interaction_pinchview","kind":"symbol","title":"Interaction_PinchView","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_PinchView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/accessibilityDragPoint(_:description:isEnabled:)-696ie":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityDragPoint"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"UnitPoint","preciseIdentifier":"s:7SwiftUI9UnitPointV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"description"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"LocalizedStringKey","preciseIdentifier":"s:7SwiftUI18LocalizedStringKeyV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ModifiedContent","preciseIdentifier":"s:7SwiftUI15ModifiedContentV"},{"kind":"text","text"