. At rest a white triangle sits at its base scale on"},{"type":"text","text":" "},{"type":"text","text":"the magenta artboard."}],"type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/onChange(of:initial:_:)-2vma3":{"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/onChange(of:initial:_:)-2vma3","kind":"symbol","url":"\/documentation\/swami\/interaction_pinchview\/onchange(of:initial:_:)-2vma3","abstract":[],"title":"onChange(of:initial:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onChange"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"V"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":", "},{"kind":"externalParam","text":"initial"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", ("},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"role":"symbol"}}}