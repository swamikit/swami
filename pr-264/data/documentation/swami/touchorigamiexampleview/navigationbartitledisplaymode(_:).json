ami/documentation/Swami":{"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"role":"collection","type":"topic","title":"Swami","url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView":{"type":"topic","url":"\/documentation\/swami\/touchorigamiexampleview","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TouchOrigamiExampleView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView","abstract":[{"text":"Artboard 1 → Group (vertical stack of cards).","type":"text"}],"title":"TouchOrigamiExampleView","navigatorTitle":[{"text":"TouchOrigamiExampleView","kind":"identifier"}],"role":"symbol"}}}