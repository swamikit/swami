cumentation\/Swami\/Interaction_DragView","url":"\/documentation\/swami\/interaction_dragview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}]}}}