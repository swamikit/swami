i","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView/init()":{"url":"\/documentation\/swami\/touchorigamiexampleview\/init()","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView\/init()","abstract":[],"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"kind":"symbol","title":"init()","type":"topic"},"doc://samatwork.Swami/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/samatwork.Swami\/s8SendableP","title":"Swift.Sendable"}}}