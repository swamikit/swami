r the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"topic","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/compositingGroup()":{"role":"symbol","abstract":[],"title":"compositingGroup()","url":"\/documentation\/swami\/interaction_dragview\/compositinggroup()","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/compositingGroup()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compositingGroup","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"type":"topic"}}}