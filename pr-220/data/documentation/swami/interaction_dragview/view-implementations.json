rified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic","url":"\/documentation\/swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/interaction(down:position:onTap:onDoubleTap:onLongPress:)":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/interaction(down:position:onTap:onDoubleTap:onLongPress:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Attach Origami-style "},{"type":"strong","inlineContent":[{"text":"Interaction","type":"text"}]},{"type":"text","text":" outputs. Pass only the outputs you need; each maps"},{"type":"text","text":" "},{"type":"text","text":"to an Interaction output port, and only its gesture is attached."}],"url":"\/documentation\/swami\/interaction_dragview\/interaction(down:position:ontap:ondoubletap:onlongpress:)","role":"symbol","title":"interaction(down:position:onTap:onDoubleTap:onLongPress:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"interaction"},{"kind":"text","text":"("},{"kind":"externalParam","text":"down"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7SwiftUI7BindingV","kind":"typeIdentifier","text":"Binding"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":">?, "},{"kind":"externalParam","text":"position"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7SwiftUI7BindingV","kind":"typeIdentifier","text":"Binding"},{"kind":"text","text":"<"},{"preciseIdentifier":"c:@S@CGPoint","kind":"typeIdentifier","text":"CGPoint"},{"kind":"text","text":"?>?, "},{"kind":"externalParam","text":"onTap"},{"kind":"text","text":": (() -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":")?, "},{"kind":"externalParam","text":"onDoubleTap"},{"kind":"text","text":": (() -> "},{"text":"Void","kind":"typeIdent