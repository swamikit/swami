":"text"},{"text":"E","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"A","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"isPresented","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV"},{"text":"<","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":">, ","kind":"text"},{"text":"error","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"actions","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"A","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}]},"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"topic","role":"collection","title":"Swami","kind":"symbol"}}}