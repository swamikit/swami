Interaction_Drag":{"abstract":[{"code":"Interaction_DragView","type":"codeVoice"},{"type":"text","text":" translates the Interaction Drag pattern into a full-screen"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI composition. The dimensions and colors are measured from the runner-produced"},{"type":"text","text":" "},{"type":"text","text":"750×1334 RGBA reference. Its corresponding 375×667-point composition has a"},{"type":"text","text":" "},{"code":"#DD70DF","type":"codeVoice"},{"type":"text","text":" canvas, a 315×607-point "},{"code":"#E5A6E6","type":"codeVoice"},{"type":"text","text":" interaction area, and a centered"},{"type":"text","text":" "},{"type":"text","text":"120×120-point white card. The current-head"},{"type":"text","text":" "},{"type":"text","text":"PR screenshot triplet verifies the rendered result rather than this page assuming a match."}],"kind":"article","type":"topic","role":"sampleCode","title":"Interaction — Drag","url":"\/documentation\/swami\/interaction_drag","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","url":"\/documentation\/swami\/interaction_dragview","abstract":[{"type":"text","text":"Reproduces the layer hierarchy measured from Origami’s runner render: a full-screen"},{"type":"text","text":" "},{"type":"text","text":"purple canvas, an inset rounded interaction area, and a centered draggable card."},{"type":"text","text":" "},{"type":"text","text":"The card maps the "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" Position output to its SwiftUI offset. A release"},{"type":"text","text":" "},{"type":"text","text":"projects momentum and applies rubber-band bounds. If its touch-up position is within"},{"type":"text","text":" "},{"type":"text","text":"100 points of center on both axes, the placed graph’s Reset branch pulses Drag’s"},{"type":"text","text":" "},{"type":"text","text":"Reset input and returns the card to its origin."}]}}}