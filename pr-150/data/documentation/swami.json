xt":" ","type":"text"},{"text":"physics — Swami ships a helper named after the Origami patch and shaped like it.","type":"text"}]},{"type":"heading","anchor":"Corpus-in-progress-2-of-69","text":"Corpus (in progress — 2 of 69)","level":2},{"type":"paragraph","inlineContent":[{"text":"The translated corpus is the gallery and the training set. Each entry is a","type":"text"},{"text":" ","type":"text"},{"text":"verified SwiftUI translation of an Origami pattern.","type":"text"}]},{"type":"heading","anchor":"Interaction","text":"Interaction","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"doc:Interaction_Touch"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"}]}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swami"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami"},"sections":[],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction":{"type":"topic","navigatorTitle":[{"text":"In