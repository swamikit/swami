":"text","text":"Interaction patch’s four discrete output ports, or Drag’s momentum + rubber-band"},{"type":"text","text":" "},{"type":"text","text":"physics — Swami ships a helper named after the Origami patch and shaped like it."}],"type":"paragraph"},{"anchor":"Corpus-in-progress-2-of-69","type":"heading","level":2,"text":"Corpus (in progress — 2 of 69)"},{"inlineContent":[{"text":"The translated corpus is the gallery and the training set. Each entry is a","type":"text"},{"text":" ","type":"text"},{"text":"verified SwiftUI translation of an Origami pattern.","type":"text"}],"type":"paragraph"},{"anchor":"Interaction","type":"heading","level":3,"text":"Interaction"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"doc:Interaction_Touch","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag","isActive":true}]}]}],"type":"unorderedList"}]}],"kind":"symbol","hierarchy":{"paths":[[]]},"topicSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"anchor":"Reference","title":"Reference"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag"],"anchor":"Helpers","title":"Helpers"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"],"anchor":"Examples","title":"Examples"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"anchor":"Articles","title":"Articles","generated":true},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/SwiftUICore"],"anchor":"Extended-Modules","title":"Extended Modules","generated":true}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction":{"type":"topic","identifier":"doc:\/\/samatwo