":[{"text":"Naming (ADR-0010): helpers are named after the Origami ","type":"text"},{"inlineContent":[{"text":"patch","type":"text"}],"type":"emphasis"},{"text":", bare (no prefix) —","type":"text"},{"text":" ","type":"text"},{"text":"disambiguate with the module (","type":"text"},{"code":"OrigamiPatterns.Interaction","type":"codeVoice"},{"text":") if it ever collides. This one","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t clash with anything in SwiftUI.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"composes off them, matching the graph:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"down"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" while a finger is on the layer,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"position"},{"text":" — the touch point, in the layer’s coordinate space,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":" — discrete pulses."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Only the gesture for an output you actually request is attached — so a tap-only layer","type":"text"},{"text":" ","type":"text"},{"text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","references":{"doc://samatwork.Swami/documentation/Swami/Drag":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drag"}],"ide