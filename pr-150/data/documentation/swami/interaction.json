,{"type":"paragraph","inlineContent":[{"type":"text","text":"Naming (ADR-0010): helpers are named after the Origami "},{"inlineContent":[{"type":"text","text":"patch"}],"type":"emphasis"},{"type":"text","text":", bare (no prefix) —"},{"type":"text","text":" "},{"type":"text","text":"disambiguate with the module ("},{"type":"codeVoice","code":"OrigamiPatterns.Interaction"},{"type":"text","text":") if it ever collides. This one"},{"type":"text","text":" "},{"type":"text","text":"doesn’t clash with anything in SwiftUI."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"composes off them, matching the graph:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"down"},{"type":"text","text":" — "},{"type":"codeVoice","code":"true"},{"type":"text","text":" while a finger is on the layer,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"position","type":"codeVoice"},{"text":" — the touch point, in the layer’s coordinate space,","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"onTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":" — discrete pulses.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the gesture for an output you actually request is attached — so a tap-only layer"},{"type":"text","text":" "},{"type":"text","text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction/body(content:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind"