ed after the Origami ","type":"text"},{"inlineContent":[{"type":"text","text":"patch"}],"type":"emphasis"},{"type":"text","text":", bare (no prefix) —"},{"type":"text","text":" "},{"type":"text","text":"disambiguate with the module ("},{"type":"codeVoice","code":"OrigamiPatterns.Interaction"},{"type":"text","text":") if it ever collides. This one"},{"type":"text","text":" "},{"type":"text","text":"doesn’t clash with anything in SwiftUI."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"composes off them, matching the graph:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"down"},{"type":"text","text":" — "},{"type":"codeVoice","code":"true"},{"type":"text","text":" while a finger is on the layer,"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"position","type":"codeVoice"},{"type":"text","text":" — the touch point, in the layer’s coordinate space,"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"onTap"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"onDoubleTap"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"onLongPress"},{"text":" — discrete pulses.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Only the gesture for an output you actually request is attached — so a tap-only layer"},{"type":"text","text":" "},{"type":"text","text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","interfaceLanguage":"swift"},"references":{"doc://samatwork.Swami/7SwiftUI12ViewModifierP":{"type":"unresolvable","title":"SwiftUICore.ViewModifier","identifier":"doc:\/\/samatwork.Swami\/7SwiftUI12ViewModifie