{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/origamimappings"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph."}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"kind":"article","identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","title":"Origami → SwiftUI mappings","modules":[{"name":"Swami"}]},"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"title":"Reference","generated":true,"anchor":"Reference"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI are both reactive dataflow, so the translator"},{"type":"text","text":" "},{"type":"text","text":"targets SwiftUI’s "},{"type":"emphasis","inlineContent":[{"text":"state graph","type":"text"}]},{"type":"text","text":" — computed properties, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"not imperative functions. Each row below is a rule the codegen applies; the helper"},{"type":"text","text":" "},{"type":"text","text":"library ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag"},{"type":"text","text":", …) fills the gaps where a patch has no direct"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI equivalent."}]},{"text":"The four rules","type":"heading","level":2,"anchor":"The-four-rules"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Origami","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"SwiftUI","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Pure value patch (Add, Transition\/interpolate, logic)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"computed property \/ expression","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Interaction (Tap, Down\/press, Double Tap, Long Press)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"gesture + ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"@GestureState","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"origami.drag"},{"text":" — Drag","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)","type":"codeVoice"},{"text":" (helper)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"State\/memory (Switch, Sample and Hold)"}]}],[{"type":"paragraph","inlineContent":[{"code":"@State","type":"codeVoice"},{"text":" + update logic","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Animation (Classic Animation, Pop\/Spring)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".animation(.spring)"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"type":"codeVoice","code":"View"},{"type":"text","text":" body. Origami "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means"},{"type":"text","text":" "},{"type":"text","text":"interpolation (not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier — that’s a different concept)."}]},{"text":"Pure value patch → computed property","type":"heading","level":3,"anchor":"Pure-value-patch-%E2%86%92-computed-property"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Add"},{"type":"text","text":", "},{"type":"codeVoice","code":"Transition\/interpolate"},{"type":"text","text":", and other pure-function patches carry no state."},{"type":"text","text":" "},{"type":"text","text":"They fan an input through math and emit an output. In SwiftUI that’s a computed"},{"type":"text","text":" "},{"type":"text","text":"property (or an inline expression) — no "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", no side effect."}]},{"text":"Interaction → gesture + `@State`","type":"heading","level":3,"anchor":"Interaction-%E2%86%92-gesture-+-State"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"type":"codeVoice","code":"down"},{"type":"text","text":", "},{"type":"codeVoice","code":"position"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"onTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" or fires a callback. The "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}]},{"text":"State\/memory → `@State` + update logic","type":"heading","level":3,"anchor":"Statememory-%E2%86%92-State-+-update-logic"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Switch"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Sample and Hold"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"type":"codeVoice","code":".onChange"},{"text":", or an assignment inside a ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" block)."}]},{"text":"Animation → `withAnimation` \/ `.animation`","type":"heading","level":3,"anchor":"Animation-%E2%86%92-withAnimation--animation"},{"type":"paragraph","inlineContent":[{"code":"Classic Animation","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Pop Animation","type":"codeVoice"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" or an ","type":"text"},{"code":".animation(_:value:)","type":"codeVoice"},{"text":" modifier on the animated property.","type":"text"},{"text":" ","type":"text"},{"text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged","type":"text"},{"text":" ","type":"text"},{"text":"by the parser — Swami won’t fake them.","type":"text"}]},{"text":"Flag, don’t fake","type":"heading","level":2,"anchor":"Flag-dont-fake"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,"},{"type":"text","text":" "},{"type":"text","text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over"},{"type":"text","text":" "},{"type":"text","text":"it. The current list: continuous-time springs, custom JavaScript patches,"},{"type":"text","text":" "},{"type":"text","text":"absolute-position layout."}]}],"kind":"content"}],"references":{"doc://samatwork.Swami/documentation/Swami":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection","url":"\/documentation\/swami","title":"Swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"kind":"symbol","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Beats":{"abstract":[{"type":"text","text":"The four-beat discipline that keeps the translator honest: one pattern per branch,"},{"type":"text","text":" "},{"type":"text","text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship"},{"type":"text","text":" "},{"type":"text","text":"only on Reviewer approval plus a human spot-check."}],"kind":"article","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats","title":"Beats","type":"topic","url":"\/documentation\/swami\/beats","role":"article"},"doc://samatwork.Swami/documentation/Swami/Interaction":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction"}],"url":"\/documentation\/swami\/interaction","role":"symbol","abstract":[{"text":"SwiftUI equivalent of Origami’s ","type":"text"},{"type":"