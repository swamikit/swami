{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"kind":"article","variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph."}],"seeAlsoSections":[{"generated":true,"anchor":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"title":"Reference"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI are both reactive dataflow, so the translator"},{"type":"text","text":" "},{"type":"text","text":"targets SwiftUI’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"state graph"}]},{"type":"text","text":" — computed properties, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"not imperative functions. Each row below is a rule the codegen applies; the helper"},{"type":"text","text":" "},{"type":"text","text":"library ("},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","type":"reference","isActive":true},{"type":"text","text":", …) fills the gaps where a patch has no direct"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI equivalent."}]},{"type":"heading","text":"The four rules","level":2,"anchor":"The-four-rules"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Origami"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Pure value patch (Add, Transition\/interpolate, logic)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"computed property \/ expression"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Interaction (Tap, Down\/press, Double Tap, Long Press)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"gesture + "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"@GestureState","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"origami.drag","type":"codeVoice"},{"type":"text","text":" — Drag"}],"type":"paragraph"}],[{"inlineContent":[{"code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)","type":"codeVoice"},{"text":" (helper)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"State\/memory (Switch, Sample and Hold)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"@State","type":"codeVoice"},{"text":" + update logic","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Animation (Classic Animation, Pop\/Spring)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":".animation(.spring)","type":"codeVoice"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"The Origami layer tree becomes the SwiftUI ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" body. Origami ","type":"text"},{"code":"Transition","type":"codeVoice"},{"text":" means","type":"text"},{"text":" ","type":"text"},{"text":"interpolation (not SwiftUI’s ","type":"text"},{"code":".transition()","type":"codeVoice"},{"text":" modifier — that’s a different concept).","type":"text"}]},{"type":"heading","text":"Pure value patch → computed property","level":3,"anchor":"Pure-value-patch-%E2%86%92-computed-property"},{"type":"paragraph","inlineContent":[{"code":"Add","type":"codeVoice"},{"type":"text","text":", "},{"code":"Transition\/interpolate","type":"codeVoice"},{"type":"text","text":", and other pure-function patches carry no state."},{"type":"text","text":" "},{"type":"text","text":"They fan an input through math and emit an output. In SwiftUI that’s a computed"},{"type":"text","text":" "},{"type":"text","text":"property (or an inline expression) — no "},{"code":"@State","type":"codeVoice"},{"type":"text","text":", no side effect."}]},{"type":"heading","text":"Interaction → gesture + `@State`","level":3,"anchor":"Interaction-%E2%86%92-gesture-+-State"},{"type":"paragraph","inlineContent":[{"text":"Origami’s Interaction patch exposes discrete output ports: ","type":"text"},{"code":"down","type":"codeVoice"},{"text":", ","type":"text"},{"code":"position","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"onTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":". Each maps to a SwiftUI gesture recognizer","type":"text"},{"text":" ","type":"text"},{"text":"whose output lands in ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" or fires a callback. The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction"},{"text":" helper","type":"text"},{"text":" ","type":"text"},{"text":"attaches only the recognizer for each output the caller requests, which keeps","type":"text"},{"text":" ","type":"text"},{"text":"gesture arbitration clean.","type":"text"}]},{"type":"heading","text":"State\/memory → `@State` + update logic","level":3,"anchor":"Statememory-%E2%86%92-State-+-update-logic"},{"type":"paragraph","inlineContent":[{"code":"Switch","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Sample and Hold","type":"codeVoice"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"code":".onChange","type":"codeVoice"},{"text":", or an assignment inside a ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" block)."}]},{"type":"heading","text":"Animation → `withAnimation` \/ `.animation`","level":3,"anchor":"Animation-%E2%86%92-withAnimation--animation"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Pop Animation"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" or an ","type":"text"},{"type":"codeVoice","code":".animation(_:value:)"},{"text":" modifier on the animated property.","type":"text"},{"text":" ","type":"text"},{"text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged","type":"text"},{"text":" ","type":"text"},{"text":"by the parser — Swami won’t fake them.","type":"text"}]},{"type":"heading","text":"Flag, don’t fake","level":2,"anchor":"Flag-dont-fake"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,"},{"type":"text","text":" "},{"type":"text","text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over"},{"type":"text","text":" "},{"type":"text","text":"it. The current list: continuous-time springs, custom JavaScript patches,"},{"type":"text","text":" "},{"type":"text","text":"absolute-position layout."}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","title":"Origami → SwiftUI mappings","modules":[{"name":"Swam