ps "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" Position to"},{"type":"text","text":" "},{"type":"text","text":"its offset. Release projects momentum, applies the Drag patch’s logical bounds, and"},{"type":"text","text":" "},{"type":"text","text":"pulses Reset when both position axes are within the placed graph’s 100-point center"},{"type":"text","text":" "},{"type":"text","text":"tolerance."}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_dragview"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/transition(_:)":{"role":"symbol","kind":"symbol","title":"transition(_:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/transition(_:)","url":"\/documentation\/swami\/interaction_dragview\/transition(_:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transition"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"AnyTransition","preciseIdentifier":"s:7SwiftUI13AnyTransitionV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"abstract":[]}}}