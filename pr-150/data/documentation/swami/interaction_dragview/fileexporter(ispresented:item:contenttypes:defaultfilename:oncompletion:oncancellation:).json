Filename:onCompletion:onCancellation:)"},{"type":"text","text":"."}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_dragview","type":"topic","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. The rendered view uses the same"},{"type":"text","text":" "},{"type":"text","text":"centered 220×140 tan card, 888×1212 artboard, and full-bleed framing as the"},{"type":"text","text":" "},{"type":"text","text":"GitHub macOS runner evidence bound to this head."}],"kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/fileExporter(isPresented:item:contentTypes:defaultFilename:onCompletion:onCancellation:)":{"role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/fileExporter(isPresented:item:contentTypes:defaultFilename:onCompletion:onCancellation:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fileExporter","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"isPresented","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","preciseIdentifier":"s:7SwiftUI7BindingV","kind":"typeIdentifier"},{"