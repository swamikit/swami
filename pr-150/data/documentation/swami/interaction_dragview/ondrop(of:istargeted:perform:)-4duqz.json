],"references":{"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"topic","role":"collection","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/onDrop(of:isTargeted:perform:)-4duqz":{"url":"\/documentation\/swami\/interaction_dragview\/ondrop(of:istargeted:perform:)-4duqz","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onDrop"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:22UniformTypeIdentifiers6UTTypeV","text":"UTType"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"isTargeted"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV","text":"Binding"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":">?, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": ([","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSItemProvider","text":"NSItemProvider","kind"