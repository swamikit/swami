stract":[{"type":"text","text":"Reproduces the layer hierarchy measured from Origami’s runner render: a full-screen"},{"type":"text","text":" "},{"type":"text","text":"purple canvas, an inset rounded interaction area, and a centered draggable card."},{"type":"text","text":" "},{"type":"text","text":"The card maps the "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" Position output to its SwiftUI offset. A release"},{"type":"text","text":" "},{"type":"text","text":"projects momentum and applies rubber-band bounds. If the bounded destination is"},{"type":"text","text":" "},{"type":"text","text":"within 100 points of center on both axes, the placed graph’s Reset branch returns"},{"type":"text","text":" "},{"type":"text","text":"the card to its origin."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/interactiveDismissDisabled(_:)":{"kind":"symbol","title":"interactiveDismissDisabled(_:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/interactiveDismissDisabled(_:)","url":"\/documentation\/swami\/interaction_dragview\/interactivedismissdisabled(_:)","type":"topic","role":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"interactiveDismissDisabled"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}]}}}