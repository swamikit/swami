uages":["swift"]}],"kind":"declarations"}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/navigationDocument(_:preview:)-6unpn":{"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/navigationDocument(_:preview:)-6unpn","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"navigationDocument"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"D"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"I"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"D"},{"kind":"text","text":", "},{"kind":"externalParam","text":"preview"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SharePreview","preciseIdentifier":"s:7SwiftUI12SharePreviewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"I"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Never","preciseIdentifier":"s:s5NeverO"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"abstract":[],"kind":"symbol","url":"\/documentation\/swami\/interaction_dragview\/navigationdocument(_:preview:)-6unpn","role":"symbol","title":"navigationDocument(_:preview:)"},"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"url":"\/documentation\/swami","title":"Swami","kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"url":"\/documentation\/swami\/interaction_dragview","abstract":[{"text":"Reproduces the layer hierarchy measured from Origami’s runner render: a full-screen","type":"text"},{"text":" ","type":"text"},{"text":"purple canvas, an inset rounded interaction area, and a centered draggable card.","type":"text"},{"text":" ","type":"text"},{"text":"The card maps the ","type":"text"},{"type":"codeVoice","code":"origami.Drag"},{"text":" Position output to its SwiftUI offset. A release","type":"text"},{"text":" ","type":"text"},{"text":"projects momentum and applies rubber-band bounds. If its touch-up position is within","type":"text"},{"text":" ","type":"text"},{"text":"100 points of center on both axes, the placed graph’s Reset branch pulses Drag’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Reset input and returns the card to its origin."}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"type":"topic","title":"Interaction_DragView","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"}}}