s, and","type":"text"},{"text":" ","type":"text"},{"text":"pulses Reset when both position axes are within the placed graph’s 100-point center","type":"text"},{"text":" ","type":"text"},{"text":"tolerance.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView"}}}