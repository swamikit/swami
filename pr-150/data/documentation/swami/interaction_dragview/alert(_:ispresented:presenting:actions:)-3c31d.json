"text","text":" "},{"type":"text","text":"its offset. Release projects momentum, applies the Drag patch’s logical bounds, and"},{"type":"text","text":" "},{"type":"text","text":"pulses Reset when both position axes are within the placed graph’s 100-point center"},{"type":"text","text":" "},{"type":"text","text":"tolerance."}],"kind":"symbol","url":"\/documentation\/swami\/interaction_dragview","type":"topic","title":"Interaction_DragView","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}]}}}