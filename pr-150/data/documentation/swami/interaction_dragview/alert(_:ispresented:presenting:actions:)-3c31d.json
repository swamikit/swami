":"text"},{"text":"patch’s rubber-band bounds, and pulses Reset when both position axes are within the","type":"text"},{"text":" ","type":"text"},{"text":"placed graph’s 100-point center tolerance.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"role":"symbol","url":"\/documentation\/swami\/interaction_dragview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}]}}}