troducedAt":"17.0"},{"unavailable":false,"name":"macOS","deprecated":false,"beta":false,"introducedAt":"14.0"}],"externalID":"s:7SwiftUI4ViewPAAE27fileDialogConfirmationLabelyQrqd__SyRd__lF::SYNTHESIZED::s:5Swami20Interaction_DragViewV","modules":[{"name":"Swami","relatedModules":["SwiftUICore"]}],"role":"symbol"},"sections":[],"abstract":[{"text":"Inherited from ","type":"text"},{"code":"View.fileDialogConfirmationLabel(_:)","type":"codeVoice"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"]]},"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/fileDialogConfirmationLabel(_:)-82d98","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","url":"\/documentation\/swami\/interaction_dragview","type":"topic","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. The rendered view uses the same","type":"text"},{"text":" ","type":"text"},{"text":"centered 220×140 tan card, 888×1212 artboard, and full-bleed framing as the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"GitHub macOS runner evidence bound to this head."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text