"deprecated":false,"introducedAt":"13.0","unavailable":false,"beta":false,"name":"iOS"},{"deprecated":false,"introducedAt":"13.0","unavailable":false,"beta":false,"name":"iPadOS"},{"deprecated":false,"introducedAt":"13.0","unavailable":false,"beta":false,"name":"Mac Catalyst"},{"deprecated":false,"introducedAt":"10.15","unavailable":false,"beta":false,"name":"macOS"},{"deprecated":false,"introducedAt":"13.0","unavailable":false,"beta":false,"name":"tvOS"},{"deprecated":false,"introducedAt":"6.0","unavailable":false,"beta":false,"name":"watchOS"}],"symbolKind":"method","roleHeading":"Instance Method","extendedModule":"SwiftUICore","title":"listRowInsets(_:)"},"references":{"doc://samatwork.Swami/documentation/Swami":{"role":"collection","url":"\/documentation\/swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/listRowInsets(_:)":{"type":"topic","role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/listrowinsets(_:)","abstract":[],"kind":"symbol","title":"listRowInsets(_:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Int