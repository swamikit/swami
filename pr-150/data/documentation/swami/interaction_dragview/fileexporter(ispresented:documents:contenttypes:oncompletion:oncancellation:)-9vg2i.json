:{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"abstract":[{"text":"Reproduces the layer hierarchy shown by Origami’s runner render: a full-screen","type":"text"},{"text":" ","type":"text"},{"text":"purple canvas, an inset rounded interaction area, and a centered draggable card.","type":"text"},{"text":" ","type":"text"},{"text":"The card maps the ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" Position output to its SwiftUI offset. A release","type":"text"},{"text":" ","type":"text"},{"text":"projects momentum and applies rubber-band bounds. Releasing within 100 points of","type":"text"},{"text":" ","type":"text"},{"text":"center on both axes pulses Reset, matching the placed graph’s snap-to-origin branch.","type":"text"}],"url":"\/documentation\/swami\/interaction_dragview","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"title":"Interaction_DragView"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/fileExporter(isPresented:documents:contentTypes:onCompletion:onCancellation:)-9vg2i":{"kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/fileExporter(isPresented:documents:contentTypes:onCompletion:onCancellation:)-9vg2i","url":"\/documentation\/swami\/interaction_dragview\/fileexporter(ispresented:documents:contenttypes:oncompletion:oncancellation:)-9vg2i","title":"fileExporter(isPresented:documents:contentTypes:onCompletion:onCancellation:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fileExporter","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"isPresented","kind":"external