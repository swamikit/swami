"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/onChange(of:perform:)"},"kind":"symbol","sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"deprecationSummary":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use `onChange` with a two or zero parameter action closure instead."}]}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"]]},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"title":"Interaction_DragView","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","type":"topic","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. The rendered view uses the same"},{"type":"text","text":" "},{"type":"text","text":"centered 220×140 tan card, 888×1212 artboard, and full-bleed framing as the"},{"type":"text","text":" "},{"type":"text","text":"GitHub macOS runner evidence bound to this head."}],"role":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_dragview","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/onChange(of:perform:)":{"role":"symbol","abstract":[],"deprecated":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/onChange(of:perform: