View/accessibilityDragPoint(_:description:isEnabled:)-3fcbp":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibilityDragPoint(_:description:isEnabled:)-3fcbp","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityDragPoint","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UnitPoint","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI9UnitPointV"},{"text":", ","kind":"text"},{"text":"description","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Text","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4TextV"},{"text":", ","kind":"text"},{"text":"isEnabled","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI15ModifiedContentV","text":"ModifiedContent"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI31AccessibilityAttachmentModifierV","text":"AccessibilityAttachmentModifier"},{"kind":"text","text":">"}],"url":"\/documentation\/swami\/interaction_dragview\/accessibilitydragpoint(_:description:isenabled:)-3fcbp","kind":"symbol","title":"accessibilityDragPoint(_:description:isEnabled:)","role":"symbol","abstract":[]},"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI. One helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swami\/interaction_dragview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"title":"Interaction_DragView","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. The rendered view uses the same","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"centered 220×140 tan card, 888×1212 artboard, and full-bleed framing as the"},{"type":"text","text":" "},{"type":"text","text":"GitHub macOS runner evidence bound to this head."}]}}}