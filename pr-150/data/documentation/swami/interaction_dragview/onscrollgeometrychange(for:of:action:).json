 card maps the ","type":"text"},{"type":"codeVoice","code":"origami.Drag"},{"text":" Position output to its SwiftUI offset. A release","type":"text"},{"text":" ","type":"text"},{"text":"projects momentum and applies rubber-band bounds. If its touch-up position is within","type":"text"},{"text":" ","type":"text"},{"text":"100 points of center on both axes, the placed graph’s Reset branch pulses Drag’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Reset input and returns the card to its origin."}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"type":"topic","title":"Interaction_DragView","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/onScrollGeometryChange(for:of:action:)":{"type":"topic","title":"onScrollGeometryChange(for:of:action:)","role":"symbol","abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/onscrollgeometrychange(for:of:action:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onScrollGeometryChange","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": (","kind":"text"},{"preciseIdentifier":"s:7SwiftUI14ScrollGeometryV","text":"ScrollGeometry","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"action","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"pr