eproduces the layer hierarchy measured from Origami’s runner render: a full-screen"},{"type":"text","text":" "},{"type":"text","text":"purple canvas, an inset rounded interaction area, and a centered draggable card."},{"type":"text","text":" "},{"type":"text","text":"The card maps the "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" Position output to its SwiftUI offset. A release"},{"type":"text","text":" "},{"type":"text","text":"projects momentum and applies rubber-band bounds. If its touch-up position is within"},{"type":"text","text":" "},{"type":"text","text":"100 points of center on both axes, the placed graph’s Reset branch pulses Drag’s"},{"type":"text","text":" "},{"type":"text","text":"Reset input and returns the card to its origin."}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"url":"\/documentation\/swami\/interaction_dragview","role":"symbol","title":"Interaction_DragView","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/navigationTitle(_:)-1ezkp":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"navigationTitle"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"V"},{"kind":"text","text":">(() -> "},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/navigationTitle(_:)-1ezkp","kind":"symbol","role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/navigationtitle(_:)-1ezkp","title":"navigationTitle(_:)","abstract":[]}}}