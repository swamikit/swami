:[{"type":"text","text":"Reproduces the layer hierarchy measured from Origami’s runner render: a full-screen"},{"type":"text","text":" "},{"type":"text","text":"purple canvas, an inset rounded interaction area, and a centered draggable card."},{"type":"text","text":" "},{"type":"text","text":"The card maps the "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" Position output to its SwiftUI offset. A release"},{"type":"text","text":" "},{"type":"text","text":"projects momentum and applies rubber-band bounds. If its touch-up position is within"},{"type":"text","text":" "},{"type":"text","text":"100 points of center on both axes, the placed graph’s Reset branch pulses Drag’s"},{"type":"text","text":" "},{"type":"text","text":"Reset input and returns the card to its origin."}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"url":"\/documentation\/swami\/interaction_dragview","role":"symbol","title":"Interaction_DragView","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/phaseAnimator(_:trigger:content:animation:)":{"type":"topic","url":"\/documentation\/swami\/interaction_dragview\/phaseanimator(_:trigger:content:animation:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"phaseAnimator","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Phase","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","kind":"typeIdentifier","preciseIdentifier":"s:ST"},{"text":", ","kind":"text"},{"text":"trigger","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Equatable","kind":"typeIdentifier","preciseIdentifier":"s:SQ"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"PlaceholderContentView","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI22PlaceholderContentViewV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"Phase","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"},{"text":", ","kind":"text"},{"text":"animation","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Phase","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Animation","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI9AnimationV"},{"text":"?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"title":"phaseAnimator(_:trigger:content:animation:)","abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/phaseAnimator(_:trigger:content:animation:)","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami":{"url":"\/documentation\/swami","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"type":"topic","role":"collection"}}}