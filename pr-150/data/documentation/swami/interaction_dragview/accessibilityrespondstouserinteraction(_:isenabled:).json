"navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"kind":"symbol","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. The rendered view uses the same","type":"text"},{"text":" ","type":"text"},{"text":"centered 220×140 tan card, 888×1212 artboard, and full-bleed framing as the","type":"text"},{"text":" ","type":"text"},{"text":"GitHub macOS runner evidence bound to this head.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","url":"\/documentation\/swami\/interaction_dragview","role":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityRespondsToUserInteraction(_:isEnabled:)":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibilityRespondsToUserInteraction(_:isEnabled:)","abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/accessibilityrespondstouserinteraction(_:isenabled:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityRespondsToUserInteraction"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI15ModifiedContentV","text":"ModifiedContent"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeI