s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"type":"topic","kind":"symbol","title":"alert(_:isPresented:presenting:actions:)","url":"\/documentation\/swami\/interaction_dragview\/alert(_:ispresented:presenting:actions:)-81qwa","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/alert(_:isPresented:presenting:actions:)-81qwa"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","kind":"symbol","title":"Interaction_DragView","url":"\/documentation\/swami\/interaction_dragview","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"type":"codeVoice","code":"origami.Drag"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" to the layer’s transform. The rendered view uses the same","type":"text"},{"text":" ","type":"text"},{"text":"centered 220×140 tan card, 888×1212 artboard, and full-bleed framing as the","type":"text"},{"text":" ","type":"text"},{"text":"GitHub macOS runner evidence bound to this head.","type":"text"}],"role":"symbol","type":"topic","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"type":"codeVoice","code":".origami"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI. One helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"title":"Swami","url":"\/documentation\/swami","type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"}}}