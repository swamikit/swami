ami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"url":"\/documentation\/swami\/interaction_dragview","kind":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView","abstract":[{"text":"Reproduces the runner reference’s fixed layer hierarchy and framing. The card maps","type":"text"},{"text":" ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" Position to its offset. Release projects momentum, applies the Drag","type":"text"},{"text":" ","type":"text"},{"text":"patch’s rubber-band bounds, and pulses Reset when both position axes are within the","type":"text"},{"text":" ","type":"text"},{"text":"placed graph’s 100-point center tolerance.","type":"text"}],"type":"topic"}}}