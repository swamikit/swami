text","text":"<"},{"kind":"genericParameter","text":"V"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"externalParam","text":"text"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV","text":"Binding"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"placement"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI20SearchFieldPlacementV","text":"SearchFieldPlacement"},{"kind":"text","text":", "},{"kind":"externalParam","text":"prompt"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":", "},{"kind":"externalParam","text":"suggestions"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"kind":"symbol","title":"searchable(text:placement:prompt:suggestions:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/searchable(text:placement:prompt:suggestions:)-1qytr","type":"topic","role":"symbol","deprecated":true,"abstract":[]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","url":"\/documentation\/swami\/interaction_dragview","abstract":[{"type":"text","text":"Reproduces the layer hierarchy measured from Origami’s runner render: a full-screen"},{"type":"text","text":" "},{"type":"text","text":"purple canvas, an inset rounded interaction area, and a centered draggable card."},{"type":"text","text":" "},{"type":"text","text":"The card maps the "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" Position output to its SwiftUI offset. A release"},{"type":"text","text":" "},{"type":"text","text":"projects momentum and applies rubber-band bounds. If its touch-up position is within"},{"type":"text","text":" "},{"type":"text","text":"100 points of center on both axes, the placed graph’s Reset branch pulses Drag’s"},{"type":"text","text":" "},{"type":"text","text":"Reset input and returns the card to its origin."}]},"doc://samatwork.Swami/documentation/Swami":{"role":"collection","url":"\/documentation\/swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","kind":"symbol"}}}