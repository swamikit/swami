o its resting position.","type":"text"}],"url":"\/documentation\/swami\/interaction_dragview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}]}}}