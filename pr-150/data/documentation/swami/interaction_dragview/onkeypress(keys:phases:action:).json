 rubber-band bounds. The draggable"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. The rendered view uses the same","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"centered 220×140 tan card, 888×1212 artboard, and full-bleed framing as the"},{"type":"text","text":" "},{"type":"text","text":"GitHub macOS runner evidence bound to this head."}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/onKeyPress(keys:phases:action:)":{"url":"\/documentation\/swami\/interaction_dragview\/onkeypress(keys:phases:action:)","kind":"symbol","type":"topic","abstract":[],"title":"onKeyPress(keys:phases:action:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/onKeyPress(keys:phases:action:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onKeyPress"},{"kind":"text","text":"("},{"kind":"externalParam","text":"keys"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:7SwiftUI13KeyEquivalentV","kind":"typeIdentifier","text":"KeyEquivalent"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"phases"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7SwiftUI8KeyPressV","kind":"typeIdentifier","text":"KeyPress"},{"kind":"text","text":"."},{"preciseIdentifier":"s:7SwiftUI8KeyPressV6PhasesV","kind":"typeIdentifier","text":"Phases"},{"kind":"text","text":", "},{"kind":"externalParam","text":"action"},{"kind":"text","text":": ("},{"preciseIdentifier":"s:7SwiftUI8KeyPressV","kind":"typeIdentifier","text":"KeyPress"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:7SwiftUI8KeyP