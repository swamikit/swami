s between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/visualEffect(_:)":{"abstract":[],"title":"visualEffect(_:)","kind":"symbol","role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/visualeffect(_:)","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/visualEffect(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"visualEffect"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"EmptyVisualEffect","preciseIdentifier":"s:7SwiftUI17EmptyVisualEffectV"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"GeometryProxy","preciseIdentifier":"s:7SwiftUI13GeometryProxyV"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"VisualEffect","preciseIdentifier":"s:7SwiftUI12VisualEffectP"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"role":"symbol","url":"\/documentation\/swami\/interaction_dragview","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"title":"Interaction_DragView","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"type":"topic","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}]}}}