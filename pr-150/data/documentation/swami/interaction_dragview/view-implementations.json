ern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/interaction(down:position:onTap:onDoubleTap:onLongPress:)":{"type":"topic","url":"\/documentation\/swami\/interaction_dragview\/interaction(down:position:ontap:ondoubletap:onlongpress:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/interaction(down:position:onTap:onDoubleTap:onLongPress:)","role":"symbol","title":"interaction(down:position:onTap:onDoubleTap:onLongPress:)","abstract":[{"type":"text","text":"Attach Origami-style "},{"inlineContent":[{"type":"text","text":"Interaction"}],"type":"strong"},{"type":"text","text":" outputs. Pass only the outputs you need; each maps"},{"type":"text","text":" "},{"type":"text","text":"to an Interaction output port, and only its gesture is attached."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"interaction","kind":"identifier"},{"text":"(","kind":"text"},{"text":"down","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","preciseIdentifier":"s:7SwiftUI7BindingV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":">?, ","kind":"text"},{"text":"position","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","preciseIdentifier":"s:7SwiftUI7BindingV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"CGPoint","preciseIdentifier":"c:@S@CGPoint","kind":"typeIdentifier"},{"text":"?>?, ","kind":"text"},{"text":"onTap","kind":"externalParam"},{"text":": (() -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")?, ","kind":"text