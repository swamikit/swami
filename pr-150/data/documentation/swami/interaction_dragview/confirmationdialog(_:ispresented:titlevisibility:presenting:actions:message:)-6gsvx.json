ext":": ("},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"A"},{"kind":"text","text":", "},{"kind":"externalParam","text":"message"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"M"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"title":"confirmationDialog(_:isPresented:titleVisibility:presenting:actions:message:)","type":"topic","abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/confirmationdialog(_:ispresented:titlevisibility:presenting:actions:message:)-6gsvx","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"abstract":[{"type":"text","text":"Reproduces the runner reference’s fixed layer hierarchy and framing: a full-screen"},{"type":"text","text":" "},{"type":"text","text":"magenta canvas and a centered white card. The card maps "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" Position to"},{"type":"text","text":" "},{"type":"text","text":"its offset. Release projects momentum, applies the Drag patch’s logical bounds, and"},{"type":"text","text":" "},{"type":"text","text":"pulses Reset when both position axes are within the placed graph’s 100-point center"},{"type":"text","text":" "},{"type":"text","text":"tolerance."}],"kind":"symbol","url":"\/documentation\/swami\/interaction_dragview","type":"topic","title":"Interaction_DragView","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}]},"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","title":"Swami","type":"topic","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection","url":"\/documentation\/swami"}}}