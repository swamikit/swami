d":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"symbolKind":"method","extendedModule":"SwiftUICore","role":"symbol","platforms":[{"deprecated":false,"beta":false,"name":"iOS","introducedAt":"13.0","unavailable":false},{"deprecated":false,"beta":false,"name":"iPadOS","introducedAt":"13.0","unavailable":false},{"deprecated":false,"beta":false,"name":"Mac Catalyst","introducedAt":"13.0","unavailable":false},{"deprecated":false,"beta":false,"name":"macOS","introducedAt":"10.15","unavailable":false},{"deprecated":false,"beta":false,"name":"tvOS","introducedAt":"13.0","unavailable":false},{"deprecated":false,"beta":false,"name":"watchOS","introducedAt":"6.0","unavailable":false}],"roleHeading":"Instance Method"},"references":{"doc://samatwork.Swami/documentation/Swami":{"title":"Swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI. One helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","kind":"symbol","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\