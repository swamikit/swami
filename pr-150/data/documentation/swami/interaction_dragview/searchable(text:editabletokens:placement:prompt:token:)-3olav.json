eIdentifier"},{"text":", ","kind":"text"},{"text":"token","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Binding","preciseIdentifier":"s:7SwiftUI7BindingV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","preciseIdentifier":"s:ST7ElementQa","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/swami\/interaction_dragview\/searchable(text:editabletokens:placement:prompt:token:)-3olav","role":"symbol","abstract":[],"kind":"symbol"},"doc://samatwork.Swami/documentation/Swami":{"title":"Swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI. One helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","kind":"symbol","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","url":"\/documentation\/swami\/interaction_dragview","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. The rendered view uses the same"},{"type":"text","text":" "},{"type":"text","text":"centered 220×140 tan card, 888×1212 artboard, and full-bleed framing as the"},{"type":"text","text":" "},{"type":"text","text":"GitHub macOS runner evidence bound to this head."}],"type":"topic","title":"Interaction_DragView"}}}