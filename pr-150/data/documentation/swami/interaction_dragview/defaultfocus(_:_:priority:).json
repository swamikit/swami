:"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/defaultFocus(_:_:priority:)":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/defaultFocus(_:_:priority:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultFocus","kind":"identifier"},{"text":"<","kind":"text"},{"text":"V","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"FocusState","preciseIdentifier":"s:7SwiftUI10FocusStateV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"Binding","preciseIdentifier":"s:7SwiftUI10FocusStateV7BindingV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"priority","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"DefaultFocusEvaluationPriority","preciseIdentifier":"s:7SwiftUI30DefaultFocusEvaluationPriorityV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"title":"defaultFocus(_:_:priority:)","role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/defaultfocus(_:_:priority:)","abstract":[],"kind":"symbol","type":"topic"}}}