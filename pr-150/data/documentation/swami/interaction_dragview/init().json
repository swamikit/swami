{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"init","title":"init()","externalID":"s:5Swami20Interaction_DragViewVACycfc","roleHeading":"Initializer","modules":[{"name":"Swami"}],"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}]},"kind":"symbol","variants":[{"paths":["\/documentation\/swami\/interaction_dragview\/init()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/init()"},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"init","kind":"keyword"},{"text":"()","kind":"text"}],"platforms":["iOS"]}],"kind":"declarations"}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/init()":{"abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/init()","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"title":"init()","kind":"symbol","type":"topic","role":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"url":"\/documentation\/swami\/interaction_dragview","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"type":"topic","title":"Interaction_DragView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}]},"doc://samatwork.Swami/documentation/Swami":{"type":"topic","kind":"symbol","title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"role":"collection","url":"\/documentation\/swami"}}}