{"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"paths":["\/documentation\/swami\/interaction_dragview\/init()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"externalID":"s:5Swami20Interaction_DragViewVACycfc","roleHeading":"Initializer","title":"init()","symbolKind":"init","role":"symbol","modules":[{"name":"Swami"}]},"kind":"symbol","identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/init()","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"init"},{"kind":"text","text":"()"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/init()":{"abstract":[],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"type":"topic","title":"init()","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/init()","url":"\/documentation\/swami\/interaction_dragview\/init()","role":"symbol","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami":{"url":"\/documentation\/swami","kind":"symbol","role":"collection","type":"topic","title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","abstract":[{"type":"text","text":"Reproduces the runner reference’s fixed layer hierarchy and framing: a full-screen"},{"type":"text","text":" "},{"type":"text","text":"magenta canvas and a centered white card. The card maps "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" Position to"},{"type":"text","text":" "},{"type":"text","text":"its offset. Release projects momentum, applies the Drag patch’s logical bounds, and"},{"type":"text","text":" "},{"type":"text","text":"pulses Reset when both position axes are within the placed graph’s 100-point center"},{"type":"text","text":" "},{"type":"text","text":"tolerance."}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_dragview"}}}