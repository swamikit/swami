atchOS","unavailable":false,"beta":false,"introducedAt":"10.0"}],"externalID":"s:7SwiftUI4ViewPAAE7toolbar8removingQrAA22ToolbarDefaultItemKindVSg_tF::SYNTHESIZED::s:5Swami20Interaction_DragViewV","symbolKind":"method","extendedModule":"SwiftUICore","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"toolbar","kind":"identifier"},{"text":"(","kind":"text"},{"text":"removing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ToolbarDefaultItemKind","preciseIdentifier":"s:7SwiftUI22ToolbarDefaultItemKindV","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/toolbar(removing:)":{"kind":"symbol","title":"toolbar(removing:)","abstract":[],"role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/toolbar(removing:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"toolbar","kind":"identifier"},{"text":"(","kind":"text"},{"text":"removing","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ToolbarDefaultItemKind","preciseIdentifier":"s:7SwiftUI22ToolbarDefaultItemKindV","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/toolbar(removing:)"},"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","role":"collection","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_dragview","role":"symbol","title":"Interaction_DragView","abstract":[{"type":"text","text":"Reproduces the layer hierarchy measured from Origami’s runner render: a full-screen"},{"type":"text","text":" "},{"type":"text","text":"purple canvas, an inset rounded interaction area, and a centered draggable card."},{"type":"text","text":" "},{"type":"text","text":"The card maps the "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" Position output to its SwiftUI offset. A release"},{"type":"text","text":" "},{"type":"text","text":"projects momentum and applies rubber-band bounds. If the bounded destination is"},{"type":"text","text":" "},{"type":"text","text":"within 100 points of center on both axes, the placed graph’s Reset branch returns"},{"type":"text","text":" "},{"type":"text","text":"the card to its origin."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}]}}}