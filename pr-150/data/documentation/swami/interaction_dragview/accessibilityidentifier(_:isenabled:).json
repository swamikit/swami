I. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityIdentifier(_:isEnabled:)":{"kind":"symbol","role":"symbol","title":"accessibilityIdentifier(_:isEnabled:)","abstract":[],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibilityIdentifier(_:isEnabled:)","url":"\/documentation\/swami\/interaction_dragview\/accessibilityidentifier(_:isenabled:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityIdentifier","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"isEnabled","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ModifiedContent","preciseIdentifier":"s:7SwiftUI15ModifiedContentV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AccessibilityAttachmentModifier","preciseIdentifier":"s:7SwiftUI31AccessibilityAttachmentModifierV","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","type":"topic","navigatorTitle":[{"kind"