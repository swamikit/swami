ami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","abstract":[{"type":"text","text":"Reproduces the runner reference’s fixed layer hierarchy and framing: a full-screen"},{"type":"text","text":" "},{"type":"text","text":"magenta canvas and a centered white card. The card maps "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" Position to"},{"type":"text","text":" "},{"type":"text","text":"its offset. Release projects momentum, applies the Drag patch’s logical bounds, and"},{"type":"text","text":" "},{"type":"text","text":"pulses Reset when both position axes are within the placed graph’s 100-point center"},{"type":"text","text":" "},{"type":"text","text":"tolerance."}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_dragview"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/previewContext(_:)":{"role":"symbol","title":"previewContext(_:)","type":"topic","url":"\/documentation\/swami\/interaction_dragview\/previewcontext(_:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/previewContext(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"previewContext","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"kind":"symbol","abstract":[]}}}