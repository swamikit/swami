xt":"Content"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"},{"kind":"text","text":"\n"}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/fullScreenCover(isPresented:onDismiss:content:)":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/fullScreenCover(isPresented:onDismiss:content:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fullScreenCover","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"isPresented","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI7BindingV","text":"Binding","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"onDismiss","kind":"externalParam"},{"text":": (() -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":")?, ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"url":"\/documentation\/swami\/interaction_dragview\/fullscreencover(ispresented:ondismiss:content:)","type":"topic","title":"fullScreenCover(isPresented:onDismiss:content:)","abstract":[],"kind":"symbol"},"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"url":"\/documentation\/swami","title":"Swami","kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"url":"\/documentation\/swami\/interaction_dragview","abstract":[{"text":"Reproduces the layer hierarchy measured from Origami’s runner render: a full-screen","type":"text"},{"text":" ","type":"text"},{"text":"purple canvas, an inset rounded interaction area, and a centered draggable card.","type":"text"},{"text":" ","type":"text"},{"text":"The card maps the ","type":"text"},{"type":"codeVoice","code":"origami.Drag"},{"text":" Position output to its SwiftUI offset. A release","type":"text"},{"text":" ","type":"text"},{"text":"projects momentum and applies rubber-band bounds. If its touch-up position is within","type":"text"},{"text":" ","type":"text"},{"text":"100 points of center on both axes, the placed graph’s Reset branch pulses Drag’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Reset input and returns the card to its origin."}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"type":"topic","title":"Interaction_DragView","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"}}}