":"\/documentation\/swami","kind":"symbol","role":"collection","type":"topic","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI. One helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}]},"doc://samatwork.Swami/documentation/Swami/InteractionDragView":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/InteractionDragView","navigatorTitle":[{"text":"InteractionDragView","kind":"identifier"}],"type":"topic","title":"InteractionDragView","abstract":[],"url":"\/documentation\/swami\/interactiondragview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InteractionDragView","kind":"identifier"}],"role":"symbol","kind":"symbol"}}}