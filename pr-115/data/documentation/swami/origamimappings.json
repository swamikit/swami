e"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"@GestureState"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"State\/memory (Switch, Sample and Hold)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"@State"},{"type":"text","text":" + update logic"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Animation (Classic Animation, Pop\/Spring)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".animation(.spring)"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"code":"View","type":"codeVoice"},{"type":"text","text":" body. Origami "},{"code":"Transition","type":"codeVoice"},{"type":"text","text":" means"},{"type":"text","text":" "},{"type":"text","text":"interpolation (not SwiftUI’s "},{"code":".transition()","type":"codeVoice"},{"type":"text","text":" modifier — that’s a different concept)."}]},{"type":"heading","anchor":"Pure-value-patch-%E2%86%92-computed-property","text":"Pure value patch → computed property","level":3},{"type":"paragraph","inlineContent":[{"code":"Add","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Transition\/interpolate","type":"codeVoice"},{"text":", and other pure-function patches carry no state.","type":"text"},{"text":" ","type":"text"},{"text":"They fan an input through math and emit an output. In SwiftUI that’s a computed","type":"text"},{"text":" ","type":"text"},{"text":"property (or an inline expression) — no ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":", no side effect.","type":"text"}]},{"type":"heading","anchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"code":"down","type":"codeVoice"},{"type":"text","text":", "},{"code":"position","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"onTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onDoubleTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onLongPress","type":"codeVoice"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" or fires a callback. The "},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference","isActive":true},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}]},{"type":"heading","anchor":"Statememory-%E2%86%92-State-+-update-logic","text":"State\/memory → `@State` + update logic","level":3},{"type":"paragraph","inlineContent":[{"code":"Switch","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Sample and Hold","type":"codeVoice"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"code":".onChange","type":"codeVoice"},{"text":", or an assignment inside a ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" block).","type":"text"}]},{"type":"heading","anchor":"Animation-%E2%86%92-withAnimation--animation","text":"Animation → `withAnimation` \/ `.animation`","level":3},{"type":"paragraph","inlineContent":[{"code":"Classic Animation","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Pop Animation","type":"codeVoice"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" or an ","type":"text"},{"code":".animation(_:value:)","type":"codeVoice"},{"text":" modifier on the animated property.","type":"text"},{"text":" ","type":"text"},{"text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged","type":"text"},{"text":" ","type":"text"},{"text":"by the parser — Swami won’t fake them.","type":"text"}]},{"type":"heading","anchor":"Flag-dont-fake","text":"Flag, don’t fake","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,"},{"type":"text","text":" "},{"type":"text","text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over"},{"type":"text","text":" "},{"type":"text","text":"it. The current list: continuous-time springs, custom JavaScript patches,"},{"type":"text","text":" "},{"type":"text","text":"absolute-position layout."}]}]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swami"}],"title":"Origami → SwiftUI mappings"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"title":"Reference","generated":true,"anchor":"Reference"}],"abstract":[{"type":"text","text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph."}],"variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","url":"\/documentation\/swami\/interaction","role":"symbol","kind"