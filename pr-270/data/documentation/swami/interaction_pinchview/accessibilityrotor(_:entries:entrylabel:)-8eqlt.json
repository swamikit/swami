 Transform Scale, and"},{"type":"text","text":" "},{"type":"text","text":"the pop is animated with a spring. At rest a white rounded triangle sits at base"},{"type":"text","text":" "},{"type":"text","text":"scale, centered on the magenta artboard."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_PinchView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","title":"Interaction_PinchView","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/accessibilityRotor(_:entries:entryLabel:)-8eqlt":{"role":"symbol","abstract":[],"type":"topic","url":"\/documentation\/swami\/interaction_pinchview\/accessibilityrotor(_:entries:entrylabel:)-8eqlt","title":"accessibilityRotor(_:entries:entryLabel:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityRotor"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"EntryModel"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"AccessibilitySystemRotor","preciseIdentifier":"s:7SwiftUI24AccessibilitySystemRotorV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"entries"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"EntryModel"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"entryLabel"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"KeyPath","preciseIdentifier":"s:s7KeyPathC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"EntryModel"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Sw