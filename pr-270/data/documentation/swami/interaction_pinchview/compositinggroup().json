e":"text","text":" "},{"type":"text","text":"the pop is animated with a spring. At rest a white rounded triangle sits at base"},{"type":"text","text":" "},{"type":"text","text":"scale, centered on the magenta artboard."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_PinchView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","title":"Interaction_PinchView","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/compositingGroup()":{"abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"compositingGroup"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"url":"\/documentation\/swami\/interaction_pinchview\/compositinggroup()","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/compositingGroup()","title":"compositingGroup()","role":"symbol","type":"topic"}}}