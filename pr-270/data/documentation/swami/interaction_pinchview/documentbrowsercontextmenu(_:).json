"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"url":"\/documentation\/swami\/interaction_pinchview\/documentbrowsercontextmenu(_:)","kind":"symbol","role":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_pinchview","title":"Interaction_PinchView","type":"topic","role":"symbol","abstract":[{"text":"Pinch to scale a shape. A ","type":"text"},{"type":"codeVoice","code":"MagnifyGesture"},{"text":" (Origami’s magnification\/pinch input)","type":"text"},{"text":" ","type":"text"},{"text":"drives two ","type":"text"},{"type":"codeVoice","code":"origami.PopSwitch"},{"text":" nodes that flip the shape between its base and an","type":"text"},{"text":" ","type":"text"},{"text":"enlarged state; the switch state feeds a ","type":"text"},{"type":"codeVoice","code":"builtin.point3D"},{"text":" Transform Scale, and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the pop is animated with a spring. At rest a white rounded triangle sits at base"},{"type":"text","text":" "},{"type":"text","text":"scale, centered on the magenta artboard."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper