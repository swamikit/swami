ole":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/accessibility(addTraits:)","abstract":[],"url":"\/documentation\/swami\/interaction_pinchview\/accessibility(addtraits:)","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibility","kind":"identifier"},{"text":"(","kind":"text"},{"text":"addTraits","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI19AccessibilityTraitsV","text":"AccessibilityTraits","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI15ModifiedContentV","text":"ModifiedContent","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI31AccessibilityAttachmentModifierV","text":"AccessibilityAttachmentModifier","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","title":"Swami","type":"topic","url":"\/documentation\/swami","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"type":"codeVoice","code":".origami"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"url":"\/documentation\/swami\/interaction_pinchview","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Pinch to scale a shape. A "},{"type":"codeVoice","code":"MagnifyGesture"},{"type":"text","text":" (Origami’s magnification\/pinch input)"},{"type":"text","text":" "},{"type":"text","text":"drives two "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" nodes that flip the shape between its base and an"},{"type":"text","text":" "},{"type":"text","text":"enlarged state; the switch state feeds a "},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":" Transform Scale, and"},{"type":"text","text":" "},{"type":"text","text":"the pop is animated with a spring. At rest the shape sits at base scale on the"},{"type":"text","text":" "},{"type":"text","text":"magenta artboard."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}],"title":"Interaction_PinchView","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}]}}}