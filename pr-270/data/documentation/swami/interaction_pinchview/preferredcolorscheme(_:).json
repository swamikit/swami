esture"},{"type":"text","text":" (Origami’s magnification\/pinch input)"},{"type":"text","text":" "},{"type":"text","text":"drives two "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" nodes that flip the shape between its base and an"},{"type":"text","text":" "},{"type":"text","text":"enlarged state; the switch state feeds a "},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":" Transform Scale, and"},{"type":"text","text":" "},{"type":"text","text":"the pop is animated with a spring. At rest the shape sits at base scale on the"},{"type":"text","text":" "},{"type":"text","text":"magenta artboard."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}],"title":"Interaction_PinchView","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/preferredColorScheme(_:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"preferredColorScheme"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI11ColorSchemeO","text":"ColorScheme"},{"kind":"text","text":"?) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"abstract":[],"role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/preferredColorScheme(_:)","title":"preferredColorScheme(_:)","url":"\/documentation\/swami\/interaction_pinchview\/preferredcolorscheme(_:)","type":"topic"}}}