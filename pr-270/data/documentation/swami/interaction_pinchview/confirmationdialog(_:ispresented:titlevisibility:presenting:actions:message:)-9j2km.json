:"drives two "},{"code":"origami.PopSwitch","type":"codeVoice"},{"type":"text","text":" nodes that flip the shape between its base and an"},{"type":"text","text":" "},{"type":"text","text":"enlarged state; the switch state feeds a "},{"code":"builtin.point3D","type":"codeVoice"},{"type":"text","text":" Transform Scale, and"},{"type":"text","text":" "},{"type":"text","text":"the pop is animated with a spring. At rest a white rounded triangle sits at base"},{"type":"text","text":" "},{"type":"text","text":"scale, centered on the magenta artboard."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}],"url":"\/documentation\/swami\/interaction_pinchview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/confirmationDialog(_:isPresented:titleVisibility:presenting:actions:message:)-9j2km":{"title":"confirmationDialog(_:isPresented:titleVisibility:presenting:actions:message:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"confirmationDialog"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"A"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"M"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isPresented"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7SwiftUI7BindingV","kind":"typeIdentifier","text":"Binding"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"titleVisibility"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7SwiftUI10VisibilityO","kind":"typeIdentifier","text":"Visibility"},{"kind":"text","text":", "},{"kind":"external