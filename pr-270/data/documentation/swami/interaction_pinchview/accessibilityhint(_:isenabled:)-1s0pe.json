n_PinchView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_pinchview","title":"Interaction_PinchView","type":"topic","role":"symbol","abstract":[{"text":"Pinch to scale a shape. A ","type":"text"},{"type":"codeVoice","code":"MagnifyGesture"},{"text":" (Origami’s magnification\/pinch input)","type":"text"},{"text":" ","type":"text"},{"text":"drives two ","type":"text"},{"type":"codeVoice","code":"origami.PopSwitch"},{"text":" nodes that flip the shape between its base and an","type":"text"},{"text":" ","type":"text"},{"text":"enlarged state; the switch state feeds a ","type":"text"},{"type":"codeVoice","code":"builtin.point3D"},{"text":" Transform Scale, and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the pop is animated with a spring. At rest a white rounded triangle sits at base"},{"type":"text","text":" "},{"type":"text","text":"scale, centered on the magenta artboard."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/accessibilityHint(_:isEnabled:)-1s0pe":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityHint","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"isEnabled","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"text":"ModifiedContent","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI15ModifiedContentV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AccessibilityAttachmentModifier","kind":"typeIdentifier","precis