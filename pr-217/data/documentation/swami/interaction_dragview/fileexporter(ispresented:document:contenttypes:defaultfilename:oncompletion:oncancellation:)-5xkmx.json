text","text":" "},{"type":"text","text":"provide momentum and rubber-band bounds; the placed Interaction → Pulse chain"},{"type":"text","text":" "},{"type":"text","text":"resets releases near the origin."}],"title":"Interaction_DragView","role":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_dragview","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"}}}