"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A centered layer follows a drag in any direction. Origami’s Drag Settings","type":"text"},{"text":" ","type":"text"},{"text":"provide momentum and rubber-band bounds; the placed Interaction → Pulse chain","type":"text"},{"text":" ","type":"text"},{"text":"resets releases near the origin.","type":"text"}],"url":"\/documentation\/swami\/interaction_dragview","type":"topic","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","role":"symbol"},"doc://samatwork.Swami/documentation/Swami":{"url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","kind":"symbol","role":"collection","type":"topic","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}]}}}