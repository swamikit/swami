g in any direction. Origami’s Drag Settings"},{"type":"text","text":" "},{"type":"text","text":"provide momentum and rubber-band bounds; the placed Interaction → Pulse chain"},{"type":"text","text":" "},{"type":"text","text":"resets releases near the origin."}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"url":"\/documentation\/swami\/interaction_dragview","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","type":"topic","role":"symbol"}}}