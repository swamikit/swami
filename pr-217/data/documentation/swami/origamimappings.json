 honest: one pattern per branch,","type":"text"},{"text":" ","type":"text"},{"text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship","type":"text"},{"text":" ","type":"text"},{"text":"only on Reviewer approval plus a human spot-check.","type":"text"}]},"doc://samatwork.Swami/documentation/Swami/Drag":{"kind":"symbol","navigatorTitle":[{"text":"Drag","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drag","kind":"identifier"}],"role":"symbol","type":"topic","title":"Drag","url":"\/documentation\/swami\/drag","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"text":"Drag","type":"text"}]},{"type":"text","text":" patch ("},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":")."}]}}}