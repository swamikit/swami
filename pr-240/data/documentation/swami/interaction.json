"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Naming (ADR-0010): helpers are named after the Origami "},{"type":"emphasis","inlineContent":[{"text":"patch","type":"text"}]},{"type":"text","text":", bare (no prefix) —"},{"type":"text","text":" "},{"type":"text","text":"disambiguate with the module ("},{"type":"codeVoice","code":"OrigamiPatterns.Interaction"},{"type":"text","text":") if it ever collides. This one"},{"type":"text","text":" "},{"type":"text","text":"doesn’t clash with anything in SwiftUI."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"composes off them, matching the graph:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"down"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" while a finger is on the layer,","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"position"},{"type":"text","text":" — the touch point, in the layer’s coordinate space,"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"onTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":" — discrete pulses.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Only the gesture for an output you actually request is attached — so a tap-only layer"},{"type":"text","text":" "},{"type":"text","text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean."}],"type":"paragraph"}]}],"references":{"doc://samatwork.Swami/7SwiftUI12ViewModifierP":{"type":"unresolvable","identifier":"doc:\/\/samatwork.Swami\/7SwiftUI12ViewModifierP","title":"SwiftUICore.ViewModifi