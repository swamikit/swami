{"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"metadata":{"role":"article","title":"Origami → SwiftUI mappings","modules":[{"name":"Swami"}],"roleHeading":"Article"},"variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"abstract":[{"text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI are both reactive dataflow, so the translator"},{"type":"text","text":" "},{"type":"text","text":"targets SwiftUI’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"state graph"}]},{"type":"text","text":" — computed properties, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"not imperative functions. Each row below is a rule the codegen applies; the helper"},{"type":"text","text":" "},{"type":"text","text":"library ("},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","type":"reference","isActive":true},{"type":"text","text":", …) fills the gaps where a patch has no direct"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI equivalent."}],"type":"paragraph"},{"text":"The four rules","anchor":"The-four-rules","level":2,"type":"heading"},{"rows":[[[{"inlineContent":[{"text":"Origami","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"SwiftUI","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pure value patch (Add, Transition\/interpolate, logic)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"computed property \/ expression"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interaction (Tap, Down\/press, Double Tap, Long Press)"}]}],[{"type":"paragraph","inlineContent":[{"text":"gesture + ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"@GestureState"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"origami.drag"},{"text":" — Drag","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)","type":"codeVoice"},{"type":"text","text":" (helper)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"State\/memory (Switch, Sample and Hold)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@State"},{"type":"text","text":" + update logic"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Animation (Classic Animation, Pop\/Spring)"}]}],[{"type":"paragraph","inlineContent":[{"code":"withAnimation","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".animation(.spring)","type":"codeVoice"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"type":"codeVoice","code":"View"},{"type":"text","text":" body. Origami "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means"},{"type":"text","text":" "},{"type":"text","text":"interpolation (not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier — that’s a different concept)."}],"type":"paragraph"},{"text":"Pure value patch → computed property","anchor":"Pure-value-patch-%E2%86%92-computed-property","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Add"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Transition\/interpolate"},{"text":", and other pure-function patches carry no state.","type":"text"},{"text":" ","type":"text"},{"text":"They fan an input through math and emit an output. In SwiftUI that’s a computed","type":"text"},{"text":" ","type":"text"},{"text":"property (or an inline expression) — no ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":", no side effect.","type":"text"}],"type":"paragraph"},{"text":"Interaction → gesture + `@State`","anchor":"Interaction-%E2%86%92-gesture-+-State","level":3,"type":"heading"},{"inlineContent":[{"text":"Origami’s Interaction patch exposes discrete output ports: ","type":"text"},{"code":"down","type":"codeVoice"},{"text":", ","type":"text"},{"code":"position","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"onTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":". Each maps to a SwiftUI gesture recognizer","type":"text"},{"text":" ","type":"text"},{"text":"whose output lands in ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" or fires a callback. The ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference","isActive":true},{"text":" helper","type":"text"},{"text":" ","type":"text"},{"text":"attaches only the recognizer for each output the caller requests, which keeps","type":"text"},{"text":" ","type":"text"},{"text":"gesture arbitration clean.","type":"text"}],"type":"paragraph"},{"text":"State\/memory → `@State` + update logic","anchor":"Statememory-%E2%86%92-State-+-update-logic","level":3,"type":"heading"},{"inlineContent":[{"code":"Switch","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Sample and Hold","type":"codeVoice"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"code":".onChange","type":"codeVoice"},{"text":", or an assignment inside a ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" block)."}],"type":"paragraph"},{"text":"Animation → `withAnimation` \/ `.animation`","anchor":"Animation-%E2%86%92-withAnimation--animation","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":", and other animation patches drive a value"},{"type":"text","text":" "},{"type":"text","text":"toward a target over time. In SwiftUI, that’s a state change wrapped in"},{"type":"text","text":" "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".animation(_:value:)"},{"type":"text","text":" modifier on the animated property."},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}],"type":"paragraph"},{"text":"Flag, don’t fake","anchor":"Flag-dont-fake","level":2,"type":"heading"},{"inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}],"type":"paragraph"}]}],"sections":[],"seeAlsoSections":[{"title":"Reference","anchor":"Reference","generated":true,"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"]}],"kind":"article","references":{"doc://samatwork.Swami/documentation/Swami/Beats":{"kind":"article","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats","type":"topic","abstract":[{"type":"text","text":"The four-beat discipline that keeps the translator honest: one pattern per branch,"},{"type":"text","text":" "},{"type":"text","text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship"},{"type":"text","text":" "},{"type":"text","text":"only on Reviewer approval plus a human spot-check."}],"title":"Beats","role":"article","url":"\/documentation\/swami\/beats"},"doc://samatwork.Swami/documentation/Swami/Drag":{"title":"Drag","url":"\/documentation\/swami\/drag","kind":"symbol","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Drag"}]},{"type":"text","text":" patch ("},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":")."}],"navigatorTitle":[{"text":"Drag","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drag","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction":{"url":"\/documentation\/swami\/interaction","role":"symbol","type":"topic","kind":"symbol","title":"Interaction","abstract":[{"text":"SwiftUI equivalent of Origami’s ","type":"text"},{"inlineContent":[{"type":"text","text":"Interaction"}],"type":"strong"},{"text":" patch.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}],"navigatorTitle":[{"text":"Interaction","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol","title":"Swami","role":"collection","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami","type":"topic"}}}