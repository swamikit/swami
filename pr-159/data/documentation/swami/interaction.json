,"level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Naming (ADR-0010): helpers are named after the Origami "},{"inlineContent":[{"text":"patch","type":"text"}],"type":"emphasis"},{"type":"text","text":", bare (no prefix) —"},{"type":"text","text":" "},{"type":"text","text":"disambiguate with the module ("},{"code":"OrigamiPatterns.Interaction","type":"codeVoice"},{"type":"text","text":") if it ever collides. This one"},{"type":"text","text":" "},{"type":"text","text":"doesn’t clash with anything in SwiftUI."}],"type":"paragraph"},{"inlineContent":[{"text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"composes off them, matching the graph:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"down"},{"type":"text","text":" — "},{"type":"codeVoice","code":"true"},{"type":"text","text":" while a finger is on the layer,"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"position"},{"text":" — the touch point, in the layer’s coordinate space,","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"onTap"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"onDoubleTap"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"onLongPress"},{"text":" — discrete pulses.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Only the gesture for an output you actually request is attached — so a tap-only layer","type":"text"},{"text":" ","type":"text"},{"text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://samatwork.Swami/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/samatwork.Swami\/s8SendableP"},"doc://samatwork.Swami/docume