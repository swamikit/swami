"kind":"typeIdentifier"}],"title":"onKeyPress(_:phases:action:)","extendedModule":"SwiftUICore","symbolKind":"method","role":"symbol","roleHeading":"Instance Method"},"kind":"symbol","references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/onKeyPress(_:phases:action:)":{"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/onKeyPress(_:phases:action:)","url":"\/documentation\/swami\/interaction_dragview\/onkeypress(_:phases:action:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onKeyPress","kind":"identifier"},{"text":"(","kind":"text"},{"text":"KeyEquivalent","preciseIdentifier":"s:7SwiftUI13KeyEquivalentV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"phases","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"KeyPress","preciseIdentifier":"s:7SwiftUI8KeyPressV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Phases","preciseIdentifier":"s:7SwiftUI8KeyPressV6PhasesV","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"action"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI8KeyPressV","text":"KeyPress"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI8KeyPressV","text":"KeyPress"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI8KeyPressV6ResultO","text":"Result"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"title":"onKeyPress(_:phases:action:)","abstract":[],"role":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"role":"symbol","title":"Interaction_DragView","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"url":"\/documentation\/swami\/interaction_dragview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}]},"doc://samatwork.Swami/documentation/Swami":{"title":"Swami","type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"}}}