:[{"type":"codeVoice","code":"Add"},{"type":"text","text":", "},{"type":"codeVoice","code":"Transition\/interpolate"},{"type":"text","text":", and other pure-function patches carry no state."},{"type":"text","text":" "},{"type":"text","text":"They fan an input through math and emit an output. In SwiftUI that’s a computed"},{"type":"text","text":" "},{"type":"text","text":"property (or an inline expression) — no "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", no side effect."}],"type":"paragraph"},{"anchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`","type":"heading","level":3},{"inlineContent":[{"text":"Origami’s Interaction patch exposes discrete output ports: ","type":"text"},{"type":"codeVoice","code":"down"},{"text":", ","type":"text"},{"type":"codeVoice","code":"position"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"onTap"},{"text":", ","type":"text"},{"type":"codeVoice","code":"onDoubleTap"},{"text":", ","type":"text"},{"type":"codeVoice","code":"onLongPress"},{"text":". Each maps to a SwiftUI gesture recognizer","type":"text"},{"text":" ","type":"text"},{"text":"whose output lands in ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" or fires a callback. The ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference","isActive":true},{"text":" helper","type":"text"},{"text":" ","type":"text"},{"text":"attaches only the recognizer for each output the caller requests, which keeps","type":"text"},{"text":" ","type":"text"},{"text":"gesture arbitration clean.","type":"text"}],"type":"paragraph"},{"text":"State\/memory → `@State` + update logic","anchor":"Statememory-%E2%86%92-State-+-update-logic","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Switch"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Sample and Hold"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"type":"codeVoice","code":".onChange"},{"text":", or an assignment inside a ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" block).","type":"text"}],"type":"paragraph"},{"text":"Animation → `withAnimation` \/ `.animation`","anchor":"Animation-%E2%86%92-withAnimation--animation","level":3,"type":"heading"},{"inlineContent":[{"code":"Classic Animation","type":"codeVoice"},{"type":"text","text":", "},{"code":"Pop Animation","type":"codeVoice"},{"type":"text","text":", and other animation patches drive a value"},{"type":"text","text":" "},{"type":"text","text":"toward a target over time. In SwiftUI, that’s a state change wrapped in"},{"type":"text","text":" "},{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" or an "},{"code":".animation(_:value:)","type":"codeVoice"},{"type":"text","text":" modifier on the animated property."},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}],"type":"paragraph"},{"text":"Flag, don’t fake","anchor":"Flag-dont-fake","level":2,"type":"heading"},{"inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","references":{"doc://samatwork.Swami/documentation/Swami/Beats":{"abstract":[{"type":"text","text":"The four-beat discipline that keeps the translator honest: one pattern per branch,"},{"type":"text","text":" "},{"type":"text","text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship"},{"type":"text","text":" "},{"type":"text","text":"only on Reviewer approval plus a human spot-check."}],"kind":"article","url":"\/documentation\/swami\/beats","role":"article","title":"Beats","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Drag":{"navigatorTitle":[{"text":"Drag","kind":"identifier"}],"url":"\/documentation\/swami\/drag","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drag","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","title":"Drag","kind":"symbol","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"text":"Drag","type":"text"}]},{"type":"text","text":" patch ("},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":")."}]},"doc://samatwork.Swami/documentation/Swami/Interaction":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}],"abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"text":"Interaction","type":"text"}]},{"type":"text","text":" patch."}],"navigatorTitle":[{"text":"Interaction","kind":"identifier"}],"kind":"symbol","title":"Interaction","role":"symbol","url":"\/documentation\/swami\/interaction","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"topic"},"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"title":"Swami","url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"topic","role":"collection","kind":"symbol"}}}