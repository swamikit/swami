xt":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}]},"doc://samatwork.Swami/documentation/Swami":{"title":"Swami","url":"\/documentation\/swami","role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"kind":"symbol","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityRotor(_:entries:entryID:entryLabel:)-lbew":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibilityRotor(_:entries:entryID:entryLabel:)-lbew","title":"accessibilityRotor(_:entries:entryID:entryLabel:)","role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/accessibilityrotor(_:entries:entryid:entrylabel:)-lbew","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityRotor"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"L"},{"kind":"text","text":", "},{"kind":"generic