,"type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"The Origami layer tree becomes the SwiftUI ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" body. Origami ","type":"text"},{"code":"Transition","type":"codeVoice"},{"text":" means","type":"text"},{"text":" ","type":"text"},{"text":"interpolation (not SwiftUI’s ","type":"text"},{"code":".transition()","type":"codeVoice"},{"text":" modifier — that’s a different concept).","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Pure-value-patch-%E2%86%92-computed-property","text":"Pure value patch → computed property","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Add"},{"type":"text","text":", "},{"type":"codeVoice","code":"Transition\/interpolate"},{"type":"text","text":", and other pure-function patches carry no state."},{"type":"text","text":" "},{"type":"text","text":"They fan an input through math and emit an output. In SwiftUI that’s a computed"},{"type":"text","text":" "},{"type":"text","text":"property (or an inline expression) — no "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", no side effect."}],"type":"paragraph"},{"level":3,"anchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`","type":"heading"},{"inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"type":"codeVoice","code":"down"},{"type":"text","text":", "},{"type":"codeVoice","code":"position"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"onTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" or fires a callback. The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction"},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}],"type":"paragraph"},{"level":3,"anchor":"Statememory-%E2%86%92-State-+-update-logic","text":"State\/memory → `@State` + update logic","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Switch"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Sample and Hold"},{"type":"text","text":" remember a value across evaluations. That’s what"},{"type":"text","text":" "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" is for. Codegen emits the state variable plus the update path (a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, a "},{"type":"codeVoice","code":".onChange"},{"type":"text","text":", or an assignment inside a "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" block)."}],"type":"paragraph"},{"level":3,"anchor":"Animation-%E2%86%92-withAnimation--animation","text":"Animation → `withAnimation` \/ `.animation`","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":", and other animation patches drive a value"},{"type":"text","text":" "},{"type":"text","text":"toward a target over time. In SwiftUI, that’s a state change wrapped in"},{"type":"text","text":" "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".animation(_:value:)"},{"type":"text","text":" modifier on the animated property."},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}],"type":"paragraph"},{"level":2,"anchor":"Flag-dont-fake","text":"Flag, don’t fake","type":"heading"},{"inlineContent":[{"type":"text","text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,"},{"type":"text","text":" "},{"type":"text","text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over"},{"type":"text","text":" "},{"type":"text","text":"it. The current list: continuous-time springs, custom JavaScript patches,"},{"type":"text","text":" "},{"type":"text","text":"absolute-position layout."}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"Swami"}],"roleHeading":"Article","role":"article","title":"Origami → SwiftUI mappings"},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"kind":"article","seeAlsoSections":[{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"generated":true}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction":{"url":"\/documentation\/swami\/interaction","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}],"abstract":[{"text":"SwiftUI equivalent of Origami’s ","type":"text"},{"inlineContent":[{"text":"Interaction","type":"text"}],"type":"strong"},{"text":" patch.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","role":"symbol","type":"topic","navigatorTitle":[{"text":"Interaction","kind":"identifier"}],"title":"Interaction"},"doc://samatwork.Swami/documentation/Swami/Beats":{"url":"\/documentation\/swami\/beats","type":"topic","abstract":[{"text":"The four-beat discipline that keeps the translator honest: one pattern per branch,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship"},{"type":"text","text":" "},{"type":"text","text":"only on Reviewer a