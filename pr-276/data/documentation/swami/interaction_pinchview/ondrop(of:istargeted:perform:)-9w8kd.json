bstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"kind":"symbol","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"abstract":[{"text":"Pinch to scale a shape. A ","type":"text"},{"code":"MagnifyGesture","type":"codeVoice"},{"text":" (Origami’s magnification\/pinch input)","type":"text"},{"text":" ","type":"text"},{"text":"drives two ","type":"text"},{"code":"origami.PopSwitch","type":"codeVoice"},{"text":" nodes that flip the shape between its base and an","type":"text"},{"text":" ","type":"text"},{"text":"enlarged state; the switch state feeds a ","type":"text"},{"code":"builtin.point3D","type":"codeVoice"},{"text":" Transform Scale, and","type":"text"},{"text":" ","type":"text"},{"text":"the pop is animated with a spring. At rest a white rounded triangle sits at base","type":"text"},{"text":" ","type":"text"},{"text":"scale, centered on the magenta artboard.","type":"text"}],"kind":"symbol","title":"Interaction_PinchView","url":"\/documentation\/swami\/interaction_pinchview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_PinchView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}],"identifier":"doc:\