":"text","text":"drives two "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" nodes that flip the shape between its base and an"},{"type":"text","text":" "},{"type":"text","text":"enlarged state; the switch state feeds a "},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":" Transform Scale, and"},{"type":"text","text":" "},{"type":"text","text":"the pop is animated with a spring. At rest a white rounded triangle sits at base"},{"type":"text","text":" "},{"type":"text","text":"scale, centered on the magenta artboard."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swami\/interaction_pinchview","title":"Interaction_PinchView","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/dynamicTypeSize(_:)":{"type":"topic","url":"\/documentation\/swami\/interaction_pinchview\/dynamictypesize(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dynamicTypeSize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"DynamicTypeSize","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI15DynamicTypeSizeO"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView\/dynamicTypeSize(_:)","abstract":[],"role":"symbol","title":"dynamicTypeSize(_:)"}}}