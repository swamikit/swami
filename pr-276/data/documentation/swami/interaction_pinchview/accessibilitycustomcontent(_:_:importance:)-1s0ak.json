des that flip the shape between its base and an","type":"text"},{"text":" ","type":"text"},{"text":"enlarged state; the switch state feeds a ","type":"text"},{"code":"builtin.point3D","type":"codeVoice"},{"text":" Transform Scale, and","type":"text"},{"text":" ","type":"text"},{"text":"the pop is animated with a spring. At rest a white rounded triangle sits at base","type":"text"},{"text":" ","type":"text"},{"text":"scale, centered on the magenta artboard.","type":"text"}],"kind":"symbol","title":"Interaction_PinchView","url":"\/documentation\/swami\/interaction_pinchview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_PinchView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","role":"symbol","type":"topic"}}}