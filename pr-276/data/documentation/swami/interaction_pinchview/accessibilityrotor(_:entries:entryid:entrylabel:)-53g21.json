dded example."}],"title":"Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView":{"abstract":[{"text":"Pinch to scale a shape. A ","type":"text"},{"code":"MagnifyGesture","type":"codeVoice"},{"type":"text","text":" (Origami’s magnification\/pinch input)"},{"type":"text","text":" "},{"type":"text","text":"drives two "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" nodes that flip the shape between its base and an"},{"type":"text","text":" "},{"type":"text","text":"enlarged state; the switch state feeds a "},{"type":"codeVoice","code":"builtin.point3D"},{"type":"text","text":" Transform Scale, and"},{"type":"text","text":" "},{"type":"text","text":"the pop is animated with a spring. At rest a white rounded triangle sits at base"},{"type":"text","text":" "},{"type":"text","text":"scale, centered on the magenta artboard."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swami\/interaction_pinchview","title":"Interaction_PinchView","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/accessibilityRotor(_:entries:entryID:entryLabel:)-53g21":{"role":"symbol","url":"\/documentation\/swami\/interaction_pinchview\/accessibilityrotor(_:entries:entryid:entrylabel:)-53g21","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"accessibilityRotor"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"EntryModel"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"ID"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4TextV","text":"Text"},{"kind":"text","text":", "},{"kind":"externalParam","text":"entries"},{"kind":"te