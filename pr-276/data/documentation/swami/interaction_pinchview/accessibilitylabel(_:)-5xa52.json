iangle sits at base","type":"text"},{"text":" ","type":"text"},{"text":"scale, centered on the magenta artboard.","type":"text"}],"kind":"symbol","title":"Interaction_PinchView","url":"\/documentation\/swami\/interaction_pinchview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_PinchView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","role":"symbol","type":"topic"}}}