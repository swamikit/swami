 triangle sits at base"},{"type":"text","text":" "},{"type":"text","text":"scale, centered on the magenta artboard."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_PinchView","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swami\/interaction_pinchview","title":"Interaction_PinchView","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Interaction_PinchView","kind":"identifier"}]}}}