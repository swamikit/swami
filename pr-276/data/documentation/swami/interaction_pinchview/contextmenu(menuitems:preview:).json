","type":"codeVoice"},{"text":" (Origami’s magnification\/pinch input)","type":"text"},{"text":" ","type":"text"},{"text":"drives two ","type":"text"},{"code":"origami.PopSwitch","type":"codeVoice"},{"text":" nodes that flip the shape between its base and an","type":"text"},{"text":" ","type":"text"},{"text":"enlarged state; the switch state feeds a ","type":"text"},{"code":"builtin.point3D","type":"codeVoice"},{"text":" Transform Scale, and","type":"text"},{"text":" ","type":"text"},{"text":"the pop is animated with a spring. At rest a white rounded triangle sits at base","type":"text"},{"text":" ","type":"text"},{"text":"scale, centered on the magenta artboard.","type":"text"}],"kind":"symbol","title":"Interaction_PinchView","url":"\/documentation\/swami\/interaction_pinchview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_PinchView"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_PinchView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_PinchView","role":"symbol","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_PinchView/contextMenu(menuItems:preview:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contextMenu","kind":"identifier"},{"text":"<","kind":"text"},{"text":"M","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"P","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"menuItems","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"M","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"preview","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"P","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swami\/interaction