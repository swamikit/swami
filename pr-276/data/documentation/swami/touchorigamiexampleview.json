nce-Properties"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView\/View-Implementations","doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView\/View-Implementations"],"anchor":"Default-Implementations"}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"kind":"symbol","title":"Interaction_DragView","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"url":"\/documentation\/swami\/interaction_dragview"},"doc://samatwork.Swami/documentation/Swami/TouchOrigamiExampleView/body":{"abstract":[],"title":"body","url":"\/documentation\/swami\/touchorigamiexampleview\/body","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"body"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView\/body"},"doc://samatwork.Swami/do