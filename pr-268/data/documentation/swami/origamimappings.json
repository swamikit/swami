{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Origami’s patch graph and SwiftUI are both reactive dataflow, so the translator","type":"text"},{"text":" ","type":"text"},{"text":"targets SwiftUI’s ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"state graph","type":"text"}]},{"text":" — computed properties, ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":", ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"not imperative functions. Each row below is a rule the codegen applies; the helper","type":"text"},{"text":" ","type":"text"},{"text":"library (","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","type":"reference","isActive":true},{"text":", …) fills the gaps where a patch has no direct","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI equivalent.","type":"text"}]},{"type":"heading","anchor":"The-four-rules","text":"The four rules","level":2},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Origami","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"SwiftUI","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Pure value patch (Add, Transition\/interpolate, logic)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"computed property \/ expression"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interaction (Tap, Down\/press, Double Tap, Long Press)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"gesture + "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"@GestureState"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"origami.drag","type":"codeVoice"},{"type":"text","text":" — Drag"}]}],[{"type":"paragraph","inlineContent":[{"code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)","type":"codeVoice"},{"type":"text","text":" (helper)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"State\/memory (Switch, Sample and Hold)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@State"},{"type":"text","text":" + update logic"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Animation (Classic Animation, Pop\/Spring)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".animation(.spring)"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The Origami layer tree becomes the SwiftUI ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" body. Origami ","type":"text"},{"type":"codeVoice","code":"Transition"},{"text":" means","type":"text"},{"text":" ","type":"text"},{"text":"interpolation (not SwiftUI’s ","type":"text"},{"type":"codeVoice","code":".transition()"},{"text":" modifier — that’s a different concept).","type":"text"}]},{"type":"heading","anchor":"Pure-value-patch-%E2%86%92-computed-property","text":"Pure value patch → computed property","level":3},{"type":"paragraph","inlineContent":[{"code":"Add","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Transition\/interpolate","type":"codeVoice"},{"text":", and other pure-function patches carry no state.","type":"text"},{"text":" ","type":"text"},{"text":"They fan an input through math and emit an output. In SwiftUI that’s a computed","type":"text"},{"text":" ","type":"text"},{"text":"property (or an inline expression) — no ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":", no side effect.","type":"text"}]},{"type":"heading","anchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`","level":3},{"type":"paragraph","inlineContent":[{"text":"Origami’s Interaction patch exposes discrete output ports: ","type":"text"},{"code":"down","type":"codeVoice"},{"text":", ","type":"text"},{"code":"position","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"onTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":". Each maps to a SwiftUI gesture recognizer","type":"text"},{"text":" ","type":"text"},{"text":"whose output lands in ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" or fires a callback. The ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true,"type":"reference"},{"text":" helper","type":"text"},{"text":" ","type":"text"},{"text":"attaches only the recognizer for each output the caller requests, which keeps","type":"text"},{"text":" ","type":"text"},{"text":"gesture arbitration clean.","type":"text"}]},{"type":"heading","anchor":"Statememory-%E2%86%92-State-+-update-logic","text":"State\/memory → `@State` + update logic","level":3},{"type":"paragraph","inlineContent":[{"code":"Switch","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Sample and Hold","type":"codeVoice"},{"type":"text","text":" remember a value across evaluations. That’s what"},{"type":"text","text":" "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" is for. Codegen emits the state variable plus the update path (a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, a "},{"code":".onChange","type":"codeVoice"},{"type":"text","text":", or an assignment inside a "},{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" block)."}]},{"level":3,"anchor":"Animation-%E2%86%92-withAnimation--animation","text":"Animation → `withAnimation` \/ `.animation`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":", and other animation patches drive a value"},{"type":"text","text":" "},{"type":"text","text":"toward a target over time. In SwiftUI, that’s a state change wrapped in"},{"type":"text","text":" "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an "},{"type":"codeVoice","code":".animation(_:value:)"},{"type":"text","text":" modifier on the animated property."},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}]},{"level":2,"anchor":"Flag-dont-fake","text":"Flag, don’t fake","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,"},{"type":"text","text":" "},{"type":"text","text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over"},{"type":"text","text":" "},{"type":"text","text":"it. The current list: continuous-time springs, custom JavaScript patches,"},{"type":"text","text":" "},{"type":"text","text":"absolute-position layout."}]}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Reference","generated":true,"title":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"article","abstract":[{"text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"},"metadata":{"modules":[{"name":"Swami"}],"roleHeading":"Article","title":"Origami → SwiftUI mappings","role":"article"},"references":{"doc://samatwork.Swami/documentation/Swami":{"url":"\/documentation\/swami","kind":"symbol","role":"collection","type":"topic","title":"Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"},"doc://samatwork.Swami/documentation/Swami/Drag":{"abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"text":"Drag","type":"text"}]},{"type":"text","text":" patch ("},{"type":"codeVoice","code":"origami.Drag"},{"text":").","type":"text"}],"url":"\/documentation\/swami\/drag","role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","kind":"symbol","title":"Drag","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Drag"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Drag"}]},"doc://samatwork.Swami/documentation/Swami/Beats":{"role":"article","type":"topic","title":"Beats","abstract":[{"type":"text","text":"The four-beat discipline that keeps the translator honest: one pattern per branch,"},{"type":"text","text":" "},{"type":"text","text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship"},{"type":"text","text":" "},{"type":"text","text":"only on Reviewer approval plus a human spot-check."}],"kind":"article","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats","url":"\/documentation\/swami\/beats"},"doc://samatwork.Swami/documentation/Swami/Interaction":{"title":"Interaction","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","url":"\/documentation\/swami\/interaction","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"inlineContent":[{"type":"text","text":"Interaction"}],"type":"strong"},{"type":"text","text":" patch."}],"navigatorTitle":[{"kind":"identifier","text":"Interaction"}],"kind":"symbol","role":"symbol","type":"topic"}}}