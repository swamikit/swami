":"topic","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","role":"symbol","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Interaction"}]},{"type":"text","text":" patch."}],"title":"Interaction","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}],"navigatorTitle":[{"text":"Interaction","kind":"identifier"}],"url":"\/documentation\/swami\/interaction"},"doc://samatwork.Swami/documentation/Swami/Interaction/ViewModifier-Implementations":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/ViewModifier-Implementations","type":"topic","role":"collectionGroup","abstract":[],"title":"ViewModifier Implementations","kind":"article","url":"\/documentation\/swami\/interaction\/viewmodifier-implementations"},"doc://samatwork.Swami/documentation/Swami/Drag":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drag","kind":"identifier"}],"title":"Drag","navigatorTitle":[{"text":"Drag","kind":"identifier"}],"abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Drag"}]},{"type":"text","text":" patch ("},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":")."}],"role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","url":"\/documentation\/swami\/drag"}}}