{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Preview","level":2,"type":"heading","text":"Preview"},{"inlineContent":[],"type":"paragraph"},{"anchor":"The-patch","level":2,"type":"heading","text":"The patch"},{"inlineContent":[{"type":"text","text":"The swipe is Origami’s momentum-scrolling Drag stack — "},{"type":"codeVoice","code":"builtin.momentumScrolling"},{"type":"text","text":" plus"},{"type":"text","text":" "},{"type":"codeVoice","code":"origami.Velocity"},{"type":"text","text":" and "},{"type":"codeVoice","code":"origami.Slip"},{"type":"text","text":" — which is exactly what the"},{"type":"text","text":" "},{"type":"codeVoice","code":"View\/drag(enable:momentum:bounds:position:translation:velocity:reset:)"},{"type":"text","text":" modifier"},{"type":"text","text":" "},{"type":"text","text":"ports from "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":". Attach it to the photo row with "},{"type":"codeVoice","code":"momentum"},{"type":"text","text":" on and lock"},{"type":"text","text":" "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":" to the horizontal axis ("},{"type":"codeVoice","code":"height: 0"},{"type":"text","text":"), so a swipe pages sideways only:"}],"type":"paragraph"},{"code":["@State private var position: CGSize = .zero","","photoRow","    .drag(","        momentum: true,","        bounds: (min: CGSize(width: -pageWidth, height: 0), max: .zero),","        position: $position","    )"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"That one modifier is the reusable piece: a throw-with-momentum drag constrained to one"},{"type":"text","text":" "},{"type":"text","text":"axis is a swipe."}],"type":"paragraph"},{"anchor":"How-its-built","level":2,"type":"heading","text":"How it’s built"},{"inlineContent":[{"type":"text","text":"The full view lays the two photo layers side by side, offsets the row by the "},{"type":"codeVoice","code":".drag"},{"type":"text","text":" "},{"type":"text","text":"output, and pins the vertical bounds to zero so the paging stays horizontal. Read the"},{"type":"text","text":" "},{"type":"text","text":"source (below) for the whole thing."}],"type":"paragraph"},{"anchor":"Behavior","level":2,"type":"heading","text":"Behavior"},{"items":[{"content":[{"inlineContent":[{"text":"Swipe left or right to page between photos.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Release mid-swipe and the row keeps gliding, then eases onto the nearest page.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Push past the last page and it rubber-bands back inside."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Downloads","level":2,"type":"heading","text":"Downloads"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Xcode sample","type":"text"}]},{"text":" — ","type":"text"},{"identifier":"https:\/\/swamikit.github.io\/swami\/pr-286\/downloads\/Interaction_Swipe.zip","type":"reference","isActive":true},{"text":" — the runnable project (same as the button above).","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Swift source","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Swipe.swift","type":"reference","isActive":true},{"type":"text","text":" — the single source file to read."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Origami source","type":"text"}]},{"type":"text","text":" — "},{"type":"reference","isActive":true,"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Swipe.origami"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"],["