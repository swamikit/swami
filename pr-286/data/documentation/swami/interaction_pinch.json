{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"anchor":"Related-Documentation"},{"title":"Patterns","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Swipe"],"anchor":"Patterns","generated":true}],"metadata":{"modules":[{"name":"Swami"}],"roleHeading":"Sample Code","title":"Interaction — Pinch","images":[{"type":"card","identifier":"Interaction_Pinch.png"}],"role":"sampleCode"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sampleCodeDownload":{"action":{"identifier":"https:\/\/swamikit.github.io\/swami\/pr-286\/downloads\/Interaction_Pinch.zip","type":"reference","overridingTitle":"Download Xcode sample","isActive":true},"kind":"sampleDownload"},"sections":[],"abstract":[{"text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"spring; pinch back in and it pops home."}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_pinch"]}],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Preview","anchor":"Preview"},{"type":"paragraph","inlineContent":[{"identifier":"Interaction_Pinch","type":"image"}]},{"type":"heading","level":2,"text":"The patch","anchor":"The-patch"},{"type":"paragraph","inlineContent":[{"text":"Origami drives this with an ","type":"text"},{"code":"origami.PopSwitch","type":"codeVoice"},{"text":" — a remembered on\/off state — flipped by","type":"text"},{"text":" ","type":"text"},{"text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight","type":"text"},{"text":" ","type":"text"},{"text":"onto native SwiftUI, which is the reusable idea worth taking away. A ","type":"text"},{"code":"MagnifyGesture","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reads the pinch, a ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" flag flips at a threshold, and a ","type":"text"},{"code":".spring","type":"codeVoice"},{"text":" animates the","type":"text"},{"text":" ","type":"text"},{"text":"scale between the two states (see the State\/memory → ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" row in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not"},{"type":"text","text":" "},{"type":"text","text":"a scale that tracks your fingers continuously."}]},{"type":"heading","level":2,"text":"How it’s built","anchor":"How-its-built"},{"type":"paragraph","inlineContent":[{"text":"The full view sits the white rounded triangle on the magenta artboard and adds a live","type":"text"},{"text":" ","type":"text"},{"code":"@GestureState","type":"codeVoice"},{"text":" so the shape follows your fingers mid-pinch before it settles on the","type":"text"},{"text":" ","type":"text"},{"text":"popped state. Read the source (below) for the whole thing.","type":"text"}]},{"type":"heading","level":2,"text":"Behavior","anchor":"Behavior"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pinch out on the shape to grow it; pinch in to shrink it."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Cross the threshold and it snaps to the next size with a spring, rather than"},{"type":"text","text":" "},{"type":"text","text":"tracking your fingers continuously."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The switch remembers its state, so a release between pinches holds the current size."}]}]}]},{"type":"heading","level":2,"text":"Downloads","anchor":"Downloads"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Xcode sample"}]},{"text":" — ","type":"text"},{"identifier":"https:\/\/swamikit.github.io\/swami\/pr-286\/downloads\/Interaction_Pinch.zip","isActive":true,"type":"reference"},{"text":" — the runnable project (same as the button above).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Swift source"}],"type":"strong"},{"text":" — ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift"},{"text":" — the single source file to read.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Origami source"}]},{"type":"text","text":" — "},{"isActive":true,"type":"reference","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami"}],"type":"paragraph"}]}]}]}],"references":{"doc://samatwork.Swami/documentation/Swami":{"title":"Swami","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","kind":"symbol","abstract":[{"t