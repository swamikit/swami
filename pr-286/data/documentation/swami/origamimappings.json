"inlineContent":[{"inlineContent":[{"text":"State and memory","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"Switch"},{"type":"text","text":", "},{"type":"codeVoice","code":"Sample and Hold"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Switch"},{"type":"text","text":" — remember a value"},{"type":"text","text":" "},{"type":"text","text":"between evaluations. That is what "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" is for; the update path is a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, an "},{"type":"codeVoice","code":".onChange"},{"type":"text","text":", or an assignment."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Animation","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":" — drives a value toward a"},{"type":"text","text":" "},{"type":"text","text":"target over time, which is a state change wrapped in "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an"},{"type":"text","text":" "},{"code":".animation(_:value:)","type":"codeVoice"},{"type":"text","text":" modifier."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One naming note: Origami’s "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means "},{"inlineContent":[{"type":"text","text":"interpolation"}],"type":"emphasis"},{"type":"text","text":" (mapping one range"},{"type":"text","text":" "},{"type":"text","text":"onto another), not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier for view insertion and"},{"type":"text","text":" "},{"type":"text","text":"removal."}]},{"type":"heading","text":"When a mapping isn’t exact","anchor":"When-a-mapping-isnt-exact","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some Origami semantics have no direct SwiftUI equivalent — continuous-time springs,"},{"type":"text","text":" "},{"type":"text","text":"custom JavaScript patches, absolute-position layout. Rather than approximate them"},{"type":"text","text":" "},{"type":"text","text":"silently, each translated view marks the gap with an inline "},{"type":"codeVoice","code":"TODO"},{"type":"text","text":" in its source,"},{"type":"text","text":" "},{"type":"text","text":"so the caveat travels with the code. The individual pattern pages link to the"},{"type":"text","text":" "},{"type":"text","text":"source where those notes live."}]}],"kind":"content"}],"kind":"article","references":{"doc://samatwork.Swami/documentation/Swami":{"abstract":[{"type":"text","text":"Origami patterns, rebuilt as SwiftUI you can read — each one a worked example of the"},{"text":" ","type":"text"},{"text":"patches behind it, so you can see how a prototype’s behavior is written and reach for","type":"text"},{"text":" ","type":"text"},{"text":"the same patch on your own layers.","type":"text"}],"type":"topic","url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","role":"collection","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/RoundedTriangle":{"role":"symbol","url":"\/documentation\/swami\/roundedtriangle","abstract":[{"text":"An upward-pointing triangle with uniformly rounded corners.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"RoundedTriangle","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RoundedTriangle","kind":"identifier"}],"title":"RoundedTriangle","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/RoundedTriangle"}}}