":"paragraph"},{"anchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`","type":"heading","level":3},{"inlineContent":[{"text":"Origami’s Interaction patch exposes discrete output ports: ","type":"text"},{"code":"down","type":"codeVoice"},{"text":", ","type":"text"},{"code":"position","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"onTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":". Each maps to a SwiftUI gesture recognizer","type":"text"},{"text":" ","type":"text"},{"text":"whose output lands in ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" or fires a callback. The ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference","isActive":true},{"text":" helper","type":"text"},{"text":" ","type":"text"},{"text":"attaches only the recognizer for each output the caller requests, which keeps","type":"text"},{"text":" ","type":"text"},{"text":"gesture arbitration clean.","type":"text"}],"type":"paragraph"},{"anchor":"Statememory-%E2%86%92-State-+-update-logic","text":"State\/memory → `@State` + update logic","type":"heading","level":3},{"inlineContent":[{"code":"Switch","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Sample and Hold","type":"codeVoice"},{"type":"text","text":" remember a value across evaluations. That’s what"},{"type":"text","text":" "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" is for. Codegen emits the state variable plus the update path (a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, a "},{"code":".onChange","type":"codeVoice"},{"type":"text","text":", or an assignment inside a "},{"type":"codeVoice","code":"withAnimation"},{"text":" block).","type":"text"}],"type":"paragraph"},{"anchor":"Animation-%E2%86%92-withAnimation--animation","text":"Animation → `withAnimation` \/ `.animation`","type":"heading","level":3},{"inlineContent":[{"code":"Classic Animation","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Pop Animation","type":"codeVoice"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" or an ","type":"text"},{"code":".animation(_:value:)","type":"codeVoice"},{"text":" modifier on the animated property.","type":"text"},{"text":" ","type":"text"},{"text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged","type":"text"},{"text":" ","type":"text"},{"text":"by the parser — Swami won’t fake them.","type":"text"}],"type":"paragraph"},{"anchor":"Flag-dont-fake","text":"Flag, don’t fake","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,"},{"type":"text","text":" "},{"type":"text","text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over"},{"type":"text","text":" "},{"type":"text","text":"it. The current list: continuous-time springs, custom JavaScript patches,"},{"type":"text","text":" "},{"type":"text","text":"absolute-position layout."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph.","type":"text"}],"sections":[],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction":{"title":"Interaction","url":"\/documentation\/swami\/interaction","navigatorTitle":[{"text":"Interaction","kind":"identifier"}],"type":"topi