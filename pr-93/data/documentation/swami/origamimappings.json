"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"computed property \/ expression"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Interaction (Tap, Down\/press, Double Tap, Long Press)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"gesture + "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"@GestureState"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"State\/memory (Switch, Sample and Hold)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"@State","type":"codeVoice"},{"text":" + update logic","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Animation (Classic Animation, Pop\/Spring)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".animation(.spring)"}],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"type":"codeVoice","code":"View"},{"type":"text","text":" body. Origami "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means"},{"type":"text","text":" "},{"type":"text","text":"interpolation (not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier — that’s a different concept)."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Pure-value-patch-%E2%86%92-computed-property","text":"Pure value patch → computed property"},{"inlineContent":[{"type":"codeVoice","code":"Add"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Transition\/interpolate"},{"text":", and other pure-function patches carry no state.","type":"text"},{"text":" ","type":"text"},{"text":"They fan an input through math and emit an output. In SwiftUI that’s a computed","type":"text"},{"text":" ","type":"text"},{"text":"property (or an inline expression) — no ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":", no side effect.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`"},{"inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"type":"codeVoice","code":"down"},{"type":"text","text":", "},{"type":"codeVoice","code":"position"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"onTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" or fires a callback. The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction"},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Statememory-%E2%86%92-State-+-update-logic","text":"State\/memory → `@State` + update logic"},{"inlineContent":[{"code":"Switch","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Sample and Hold","type":"codeVoice"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"code":".onChange","type":"codeVoice"},{"text":", or an assignment inside a ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" block).","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Animation-%E2%86%92-withAnimation--animation","text":"Animation → `withAnimation` \/ `.animation`"},{"inlineContent":[{"code":"Classic Animation","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Pop Animation","type":"codeVoice"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" or an ","type":"text"},{"code":".animation(_:value:)","type":"codeVoice"},{"text":" modifier on the animated property.","type":"text"},{"text":" ","type":"text"},{"text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged","type":"text"},{"text":" ","type":"text"},{"text":"by the parser — Swami won’t fake them.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Flag-dont-fake","text":"Flag, don’t fake"},{"inlineContent":[{"type":"text","text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,"},{"type":"text","text":" "},{"type":"text","text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over"},{"type":"text","text":" "},{"type":"text","text":"it. The current list: continuous-time springs, custom JavaScript patches,"},{"type":"text","text":" "},{"type":"text","text":"absolute-position layout."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"seeAlsoSections":[{"title":"Reference","generated":true,"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"anchor":"Reference"}],"sections":[],"kind":"article","references":{"doc://samatwork.Swami/documentation/Swami/Beats":{"type":"topic","url":"\/documentation\/swami\/beats","role":"article","kind":"article","title":"Beats","abstract":[{"text":"The four-beat discipli