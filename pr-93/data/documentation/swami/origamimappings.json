{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Origami’s patch graph and SwiftUI are both reactive dataflow, so the translator","type":"text"},{"text":" ","type":"text"},{"text":"targets SwiftUI’s ","type":"text"},{"inlineContent":[{"type":"text","text":"state graph"}],"type":"emphasis"},{"text":" — computed properties, ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":", ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"not imperative functions. Each row below is a rule the codegen applies; the helper","type":"text"},{"text":" ","type":"text"},{"text":"library (","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","isActive":true,"type":"reference"},{"text":", …) fills the gaps where a patch has no direct","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI equivalent.","type":"text"}]},{"type":"heading","level":2,"text":"The four rules","anchor":"The-four-rules"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pure value patch (Add, Transition\/interpolate, logic)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"computed property \/ expression"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Interaction (Tap, Down\/press, Double Tap, Long Press)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"gesture + ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"@GestureState"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"State\/memory (Switch, Sample and Hold)"}]}],[{"type":"paragraph","inlineContent":[{"code":"@State","type":"codeVoice"},{"type":"text","text":" + update logic"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Animation (Classic Animation, Pop\/Spring)"}]}],[{"type":"paragraph","inlineContent":[{"code":"withAnimation","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".animation(.spring)","type":"codeVoice"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"type":"codeVoice","code":"View"},{"type":"text","text":" body. Origami "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means"},{"type":"text","text":" "},{"type":"text","text":"interpolation (not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier — that’s a different concept)."}]},{"type":"heading","level":3,"text":"Pure value patch → computed property","anchor":"Pure-value-patch-%E2%86%92-computed-property"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Add"},{"type":"text","text":", "},{"type":"codeVoice","code":"Transition\/interpolate"},{"type":"text","text":", and other pure-function patches carry no state."},{"type":"text","text":" "},{"type":"text","text":"They fan an input through math and emit an output. In SwiftUI that’s a computed"},{"type":"text","text":" "},{"type":"text","text":"property (or an inline expression) — no "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", no side effect."}]},{"type":"heading","level":3,"text":"Interaction → gesture + `@State`","anchor":"Interaction-%E2%86%92-gesture-+-State"},{"type":"paragraph","inlineContent":[{"text":"Origami’s Interaction patch exposes discrete output ports: ","type":"text"},{"code":"down","type":"codeVoice"},{"text":", ","type":"text"},{"code":"position","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"onTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":". Each maps to a SwiftUI gesture recognizer","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"whose output lands in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" or fires a callback. The "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","isActive":true},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}]},{"level":3,"text":"State\/memory → `@State` + update logic","anchor":"Statememory-%E2%86%92-State-+-update-logic","type":"heading"},{"inlineContent":[{"code":"Switch","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Sample and Hold","type":"codeVoice"},{"type":"text","text":" remember a value across evaluations. That’s what"},{"type":"text","text":" "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" is for. Codegen emits the state variable plus the update path (a gesture"},{"type":"text","text":" "},{"type":"text","text":"callback, a "},{"code":".onChange","type":"codeVoice"},{"type":"text","text":", or an assignment inside a "},{"type":"codeVoice","code":"withAnimation"},{"text":" block).","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Animation-%E2%86%92-withAnimation--animation","text":"Animation → `withAnimation` \/ `.animation`"},{"inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Pop Animation"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" or an ","type":"text"},{"type":"codeVoice","code":".animation(_:value:)"},{"text":" modifier on the animated property.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged"},{"type":"text","text":" "},{"type":"text","text":"by the parser — Swami won’t fake them."}],"type":"paragraph"},{"type":"heading","anchor":"Flag-dont-fake","text":"Flag, don’t fake","level":2},{"inlineContent":[{"type":"text","text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,"},{"type":"text","text":" "},{"type":"text","text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over"},{"type":"text","text":" "},{"type":"text","text":"it. The current list: continuous-time springs, custom JavaScript patches,"},{"type":"text","text":" "},{"type":"text","text":"absolute-position layout."}],"type":"paragraph"}]}],"metadata":{"title":"Origami → SwiftUI mappings","roleHeading":"Article","modules":[{"name":"Swami"}],"role":"article"},"abstract":[{"text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"kind":"article","variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"},"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"anchor":"Reference","generated":true}],"references":{"doc://samatwork.Swami/documentation/Swami/Beats":{"role":"article","kind":"article","title":"Beats","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats","abstract":[{"type":"text","text":"The four-beat discipline that keeps the translator honest: one pattern per branch,"},{"type":"text","text":" "},{"type":"text","text":"compile-clean before opening a PR, visual gate against Origami’s own render, ship"},{"type":"text","text":" "},{"type":"text","text":"only on Reviewer approval plus a human spot-check."}],"type":"topic","url":"\/documentation\/swami\/beats"},"doc://samatwork.Swami/documentation/Swami":{"kind":"symbol","url":"\/documentation\/swami","title":"Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Drag":{"navigatorTitle":[{"text":"Drag","kind":"identifier"}],"title":"Drag","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drag","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swami\/drag","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"text":"Drag","type":"text"}]},{"type":"text","text":" patch ("},{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":")."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag"},"doc://samatwork.Swami/documentation/Swami/Interaction":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}],"type":"topic","title":"Interaction","role":"symbol","navigatorTitle":[{"text":"Interaction","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","url":"\/documentation\/swami\/interaction","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Interaction"}]},{"text":" patch.","type":"text"}]}}}