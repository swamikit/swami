n’t clash with anything in SwiftUI."}],"type":"paragraph"},{"inlineContent":[{"text":"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"composes off them, matching the graph:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"down"},{"type":"text","text":" — "},{"type":"codeVoice","code":"true"},{"type":"text","text":" while a finger is on the layer,"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"position"},{"type":"text","text":" — the touch point, in the layer’s coordinate space,"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"onTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":" — discrete pulses."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Only the gesture for an output you actually request is attached — so a tap-only layer","type":"text"},{"text":" ","type":"text"},{"text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swami\/interaction"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/body(content:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/ViewModifier-Implementations"],"anchor":"Default-Implementations"}],"references":{"doc://samatwork.Swami/7SwiftUI12ViewModifierP":{"title":"SwiftUICore.ViewModifier","identifier":"doc:\/\/samatwork.Swami\/7SwiftUI12ViewModifierP","type":"unresolvab