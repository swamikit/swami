nchor":"Interaction-%E2%86%92-gesture-+-State","text":"Interaction → gesture + `@State`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s Interaction patch exposes discrete output ports: "},{"code":"down","type":"codeVoice"},{"type":"text","text":", "},{"code":"position","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"onTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onDoubleTap","type":"codeVoice"},{"type":"text","text":", "},{"code":"onLongPress","type":"codeVoice"},{"type":"text","text":". Each maps to a SwiftUI gesture recognizer"},{"type":"text","text":" "},{"type":"text","text":"whose output lands in "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" or fires a callback. The "},{"isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","type":"reference"},{"type":"text","text":" helper"},{"type":"text","text":" "},{"type":"text","text":"attaches only the recognizer for each output the caller requests, which keeps"},{"type":"text","text":" "},{"type":"text","text":"gesture arbitration clean."}]},{"type":"heading","level":3,"anchor":"Statememory-%E2%86%92-State-+-update-logic","text":"State\/memory → `@State` + update logic"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Switch"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Sample and Hold"},{"text":" remember a value across evaluations. That’s what","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" is for. Codegen emits the state variable plus the update path (a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, a ","type":"text"},{"type":"codeVoice","code":".onChange"},{"text":", or an assignment inside a ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" block)."}]},{"type":"heading","level":3,"anchor":"Animation-%E2%86%92-withAnimation--animation","text":"Animation → `withAnimation` \/ `.animation`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Classic Animation"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Pop Animation"},{"text":", and other animation patches drive a value","type":"text"},{"text":" ","type":"text"},{"text":"toward a target over time. In SwiftUI, that’s a state change wrapped in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":" or an ","type":"text"},{"type":"codeVoice","code":".animation(_:value:)"},{"text":" modifier on the animated property.","type":"text"},{"text":" ","type":"text"},{"text":"Continuous-time springs that don’t have a stock SwiftUI equivalent get flagged","type":"text"},{"text":" ","type":"text"},{"text":"by the parser — Swami won’t fake them.","type":"text"}]},{"type":"heading","level":2,"anchor":"Flag-dont-fake","text":"Flag, don’t fake"},{"type":"paragraph","inlineContent":[{"text":"Some Origami semantics don’t have a SwiftUI equivalent. When the parser hits one,","type":"text"},{"text":" ","type":"text"},{"text":"it emits a marker in the IR and codegen surfaces the gap rather than papering over","type":"text"},{"text":" ","type":"text"},{"text":"it. The current list: continuous-time springs, custom JavaScript patches,","type":"text"},{"text":" ","type":"text"},{"text":"absolute-position layout.","type":"text"}]}]}],"metadata":{"title":"Origami → SwiftUI mappings","role":"article","modules":[{"name":"Swami"}],"roleHeading":"Article"},"kind":"article","identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"abstract":[{"text":"How Swami translates the four kinds of Origami patch into SwiftUI’s state graph.","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"anchor":"Reference","title":"Reference"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction":{"abstract":[{"text":"SwiftUI equivalent of Origami’s ","type":"text"},{"inlineContent":[{"type":"text","text":"Interaction"}],"type":"strong"},{"text":" patch.","type":"text"}],"url":"\/documentation\/swami\/interaction","title":"Interaction","navigatorTitle":[{"text":"Interaction","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction"},"doc://samatwork.Swami/documentation/Swami/Drag":{"url":"\/documentation\/swami\/drag","role":"symbol","abstract":[{"type":"text","text":"SwiftUI equivalent of Origami’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Drag"}]},{"type":"text","text":" patch ("},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":")."}],"navigatorTitle":[{"text":"Drag","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag","type":"topic","title":"Drag","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Drag","kind":"identifier"}]},"doc://samatwork.Swami/documentation/Swami":{"type":"topic","role":"collection","title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","kind":"symbol","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"code":".origami","type":"codeVoice"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI 