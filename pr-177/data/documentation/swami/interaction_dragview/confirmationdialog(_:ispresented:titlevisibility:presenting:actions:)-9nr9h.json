","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/confirmationDialog(_:isPresented:titleVisibility:presenting:actions:)-9nr9h","title":"confirmationDialog(_:isPresented:titleVisibility:presenting:actions:)","url":"\/documentation\/swami\/interaction_dragview\/confirmationdialog(_:ispresented:titlevisibility:presenting:actions:)-9nr9h","abstract":[],"kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","kind":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/swami\/interaction_dragview"}}}