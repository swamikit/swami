ied against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}],"role":"collection","kind":"symbol","type":"topic","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"type":"topic","title":"Interaction_DragView","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"url":"\/documentation\/swami\/interaction_dragview","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"type":"codeVoice","code":"origami.Drag"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityChildren(children:)":{"role":"symbol","title":"accessibilityChildren(children:)","url":"\/documentation\/swami\/interaction_dragview\/accessibilitychildren(children:)","abstract":[],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityChildren"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"V"},{"kind":"text","text":">("},{"kind":"externalParam","text":"children"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"V"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind