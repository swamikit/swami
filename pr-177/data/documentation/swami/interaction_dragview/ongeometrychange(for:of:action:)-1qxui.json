tance Method","role":"symbol","title":"onGeometryChange(for:of:action:)"},"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"View.onGeometryChange(for:of:action:)"},{"type":"text","text":"."}],"kind":"symbol","identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/onGeometryChange(for:of:action:)-1qxui","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_dragview\/ongeometrychange(for:of:action:)-1qxui"]}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","type":"topic","url":"\/documentation\/swami\/interaction_dragview","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/onGeometryChange(for:of:action:)-1qxui":{"title":"onGeometryChange(for:of:action:)","type":"topic","abstract":[],"kind":"symbol","url":"\/documentation\/swami\/interaction_dragview\/ongeometrychange(for:of:action:)-1qxui","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView