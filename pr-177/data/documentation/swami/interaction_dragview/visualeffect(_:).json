 named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami","title":"Swami","role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","url":"\/documentation\/swami\/interaction_dragview","navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"kind":"symbol","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"type":"codeVoice","code":"origami.Drag"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"role":"symbol","title":"Interaction_DragView"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/visualEffect(_:)":{"title":"visualEffect(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"visualEffect"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"EmptyVisualEffect","preciseIdentifier":"s:7SwiftUI17EmptyVisualEffectV"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"GeometryProxy","preciseIdentifier":"s:7SwiftUI1