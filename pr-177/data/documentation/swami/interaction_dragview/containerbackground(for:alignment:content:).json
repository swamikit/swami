orms":["iOS"]}]}],"abstract":[{"text":"Inherited from ","type":"text"},{"code":"View.containerBackground(for:alignment:content:)","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/containerBackground(for:alignment:content:)":{"type":"topic","kind":"symbol","role":"symbol","abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/containerbackground(for:alignment:content:)","title":"containerBackground(for:alignment:content:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/containerBackground(for:alignment:content:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"containerBackground","kind":"identifier"},{"text":"<","kind":"text"},{"text":"V","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI28ContainerBackgroundPlacementV","text":"ContainerBackgroundPlacement","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"alignment","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI9AlignmentV","text":"Alignment","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"V","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","kind":"symbol","navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/swami\/interaction_dragview"},"doc://samatwork.Swami/documentation/Swami":{"role":"collection","title":"Swami","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"type":"topic"}}}