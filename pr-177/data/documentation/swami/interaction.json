documentation\/Swami","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"title":"Swami","type":"topic"},"doc://samatwork.Swami/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/samatwork.Swami\/s8SendableP"},"doc://samatwork.Swami/7SwiftUI12ViewModifierP":{"title":"SwiftUICore.ViewModifier","type":"unresolvable","identifier":"doc:\/\/samatwork.Swami\/7SwiftUI12ViewModifierP"},"doc://samatwork.Swami/documentation/Swami/Interaction/ViewModifier-Implementations":{"title":"ViewModifier Implementations","abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/ViewModifier-Implementations","role":"collectionGroup","kind":"article","type":"topic","url":"\/documentation\/swami\/interaction\/viewmodifier-implementations"}}}