:"Exposes the Interaction patch’s output ports as bindings\/callbacks so downstream SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"composes off them, matching the graph:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"down"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" while a finger is on the layer,","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"position"},{"type":"text","text":" — the touch point, in the layer’s coordinate space,"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"onTap","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"onDoubleTap","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"onLongPress","type":"codeVoice"},{"type":"text","text":" — discrete pulses."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Only the gesture for an output you actually request is attached — so a tap-only layer","type":"text"},{"text":" ","type":"text"},{"text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction"]}],"metadata":{"roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"Swami"}],"title":"Interaction","externalID":"s:5Swami11InteractionV","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Interaction"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","interfaceLanguage":"swift"},"references":{"doc://samatwork.Swami/documentation/Swami/Interaction/body(content:)":{"url":"\/documentation\/swami\/interaction\/body(content:)","role":"symbol","identifier":"doc: