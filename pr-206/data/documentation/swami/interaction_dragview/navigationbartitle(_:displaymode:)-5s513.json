text","text":"output "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/navigationBarTitle(_:displayMode:)-5s513":{"abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/navigationBarTitle(_:displayMode:)-5s513","type":"topic","kind":"symbol","deprecated":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"navigationBarTitle"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":", "},{"kind":"externalParam","text":"displayMode"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7SwiftUI17NavigationBarItemV","kind":"typeIdentifier","text":"NavigationBarItem"},{"kind":"text","text":"."},{"preciseIdentifier":"s:7SwiftUI17NavigationBarItemV16TitleDisplayModeO","kind":"typeIdentifier","text":"TitleDisplayMode"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"title":"navigationBarTitle(_:displayMode:)","role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/navigationbartitle(_:displaymode:)-5s513"}}}