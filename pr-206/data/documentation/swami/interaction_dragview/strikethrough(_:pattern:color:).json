/Swami":{"kind":"symbol","title":"Swami","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","role":"collection","abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"url":"\/documentation\/swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"title":"Interaction_DragView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}],"type":"topic","role":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","kind":"symbol","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"url":"\/documentation\/swami\/interaction_dragview"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/strikethrough(_:pattern:color:)":{"title":"strikethrough(_:pattern:color:)","kind":"symbol","type":"topic","abstract":[],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"strikethrough","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"pattern","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Text","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4TextV"},{"text":".","kind":"text"},{"text":"LineStyle","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4TextV9LineStyleV"},{"text":".","kind":"text"},{"text":"Pattern","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4TextV9LineStyleV7PatternV"},{"text":", ","kind":"text"},{"text":"color","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Color","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI5ColorV"},{"text":"?) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/strikethrough(_:pattern:color:)","url":"\/documentation\/swami\/interaction_dragview\/strikethrough(_:pattern:color:)"}}}