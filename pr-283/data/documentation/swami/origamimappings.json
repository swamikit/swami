{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI both describe how values flow and change over"},{"type":"text","text":" "},{"type":"text","text":"time, so the translations map onto SwiftUI’s own tools: computed properties for"},{"type":"text","text":" "},{"type":"text","text":"pure math, gestures and "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for interaction, "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" for motion. Most"},{"type":"text","text":" "},{"type":"text","text":"patches land on a native SwiftUI construct. A few need a helper from the "},{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"library, named after the patch it stands in for.","type":"text"}]},{"type":"heading","anchor":"Patch-%E2%86%92-SwiftUI","text":"Patch → SwiftUI","level":2},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Origami patch","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Pure value patch (Add, interpolate, logic)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"computed property \/ expression (native)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Interaction (Tap, Press, Double Tap, Long Press)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"gesture + ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" via ","type":"text"},{"type":"codeVoice","code":"View\/interaction(down:position:onTap:onDoubleTap:onLongPress:)"},{"text":" (helper)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"origami.Drag"},{"text":" — Drag","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"drag(