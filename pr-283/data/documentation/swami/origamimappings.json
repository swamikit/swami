","code":"Add"},{"type":"text","text":", interpolation, logic — carry no state. They run an"},{"type":"text","text":" "},{"type":"text","text":"input through math and emit a result, which is exactly a computed property or an"},{"type":"text","text":" "},{"type":"text","text":"inline expression."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Interaction","type":"text"}]},{"text":" exposes discrete outputs: ","type":"text"},{"code":"down","type":"codeVoice"},{"text":", ","type":"text"},{"code":"position","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onTap","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":". Each becomes a SwiftUI gesture whose result lands in","type":"text"},{"text":" ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" or fires a callback. The ","type":"text"},{"code":".interaction(…)","type":"codeVoice"},{"text":" modifier attaches only the","type":"text"},{"text":" ","type":"text"},{"text":"recognizers you ask for, so gesture arbitration stays clean.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"State and memory","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"Switch"},{"type":"text","text":", "},{"type":"codeVoice","code":"Sample and Hold"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Switch"},{"type":"text","text":" — remember a value"},{"type":"text","text":" "},{"type":"text","text":"between evaluations. That is what "},{"type":"codeVoice","code":"@State"},{"text":" is for; the update path is a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, an ","type":"text"},{"code":".onChange","type":"codeVoice"},{"text":", or an assignment.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Animation"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":" — drives a value toward a"},{"type":"text","text":" "},{"type":"text","text":"target over time, which is a state change wrapped in "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an"},{"type":"text","text":" "},{"type":"codeVoice","code":".animation(_:value:)"},{"type":"text","text":" modifier."}]},{"type":"paragraph","inlineContent":[{"text":"One naming note: Origami’s ","type":"text"},{"code":"Transition","type":"codeVoice"},{"text":" means ","type":"text"},{"inlineContent":[{"text":"interpolation","type":"text"}],"type":"emphasis"},{"text":" (mapping one range","type":"text"},{"text":" ","type":"text"},{"text":"onto another), not SwiftUI’s ","type":"text"},{"code":".transition()","type":"codeVoice"},{"text":" modifier for view insertion and","type":"text"},{"text":" ","type":"text"},{"text":"removal.","type":"text"}]},{"type":"heading","anchor":"When-a-mapping-isnt-exact","text":"When a mapping isn’t exact","level":2},{"type":"paragraph","inlineContent":[{"text":"Some Origami semantics have no direct SwiftUI equivalent — continuous-time springs,","type":"text"},{"text":" ","type":"text"},{"text":"custom JavaScript patches, absolute-position layout. Rather than approximate them","type":"text"},{"text":" ","type":"text"},{"text":"silently, each translated view marks the gap with an inline ","type":"text"},{"code":"TODO","type":"codeVoice"},{"text":" in its source,","type":"text"},{"text":" ","type":"text"},{"text":"so the caveat travels with the code. The individual pattern pages link to the","type":"text"},{"text":" ","type":"text"},{"text":"source where those notes live.","type":"text"}]}],"kind":"content"}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"What each Origami patch becomes in SwiftUI, so you kno