{"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"type":"codeVoice","code":".origami"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","topicSections":[{"title":"Reference","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","doc:\/\/samatwork.Swami\/documentation\/Swami\/Beats"],"anchor":"Reference"},{"title":"Helpers","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction","doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag"],"anchor":"Helpers"},{"title":"Examples","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/TouchOrigamiExampleView","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"],"anchor":"Examples"},{"title":"Articles","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"generated":true,"anchor":"Articles"},{"title":"Extended Modules","identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/SwiftUICore"],"generated":true,"anchor":"Extended-Modules"}],"metadata":{"role":"collection","externalID":"Swami","symbolKind":"module","title":"Swami","modules":[{"name":"Swami"}],"roleHeading":"Framework"},"