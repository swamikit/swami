type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","role":"collection","kind":"symbol","type":"topic","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityDropPoint(_:description:isEnabled:)-9kkog":{"abstract":[],"type":"topic","title":"accessibilityDropPoint(_:description:isEnabled:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibilityDropPoint(_:description:isEnabled:)-9kkog","role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/accessibilitydroppoint(_:description:isenabled:)-9kkog","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityDropPoint"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI9UnitPointV","text":"UnitPoint"},{"kind":"text","text":", "},{"kind":"externalParam","text":"description"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4TextV","text":"Text"},{"kind":"text","text":", "},{"kind":"externalParam","text":"isEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI15ModifiedContentV","text":"ModifiedContent"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI31AccessibilityAttachmentModifierV","text":"AccessibilityAttachmentModifier"},{"kind":"text","text":">"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"url":"\/documentation\/swami\/interaction_dragview","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"title":"Interaction_DragView","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","kind":"symbol","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}]}}}