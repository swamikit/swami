ion/Swami":{"abstract":[{"type":"text","text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s "},{"code":".origami","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami"},{"type":"text","text":" "},{"type":"text","text":"is also the patch-matched helper library that fills gaps between Origami patches"},{"type":"text","text":" "},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","role":"collection","kind":"symbol","type":"topic","title":"Swami"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/scrollTargetBehavior(_:)":{"role":"symbol","abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/scrolltargetbehavior(_:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/scrollTargetBehavior(_:)","type":"topic","title":"scrollTargetBehavior(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scrollTargetBehavior"},{"kind":"text","text":"("},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI20ScrollTargetBehaviorP","kind":"typeIdentifier","text":"ScrollTargetBehavior"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}]}}}