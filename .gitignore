# --- Meta / third-party assets (kept private, never in this public repo) ---
# Anchored to repo root so this only ignores a top-level `patterns/` scratch
# dir (raw .origami sources dropped in for local testing). Unanchored, this
# also matched `app/Swami/Patterns/` — which IS the deliverable and must be
# committable — and blocked Builder's translate PR from staging its generated
# `<PatternName>.swift` (#85, Builder run 33958828029).
/patterns/
*.origami
*.origami.zip
# generated catalog snapshots derived from the installed Origami Studio app
tool/catalog/
tool/**/catalog_snapshot*/

# --- Local machine / editor state ---
.claude/
.DS_Store
.idea/
.vscode/

# --- Xcode build state ---
app/**/DerivedData/
app/**/build/
app/**/xcuserdata/
app/**/*.xcuserstate

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Test corpus fetched at runtime from origami.design (ADR-0013 Path B) ---
tool/src/parser/.cache/

# --- Swift Package build state ---
tool/harness/.build/
tool/harness/.swiftpm/
tool/harness/Package.resolved
