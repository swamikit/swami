esting position.","type":"text"}],"url":"\/documentation\/swami\/interaction_dragview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/hidden()":{"title":"hidden()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hidden","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/hidden()","role":"symbol","url":"\/documentation\/swami\/interaction_dragview\/hidden()","kind":"symbol","type":"topic","abstract":[]}}}