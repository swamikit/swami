{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"Swami"}],"roleHeading":"Sample Code","role":"sampleCode","title":"Interaction — Pinch","images":[{"identifier":"Interaction_Pinch.png","type":"card"}]},"sections":[],"abstract":[{"text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a","type":"text"},{"text":" ","type":"text"},{"text":"spring; pinch back in and it pops home.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Preview","text":"Preview"},{"type":"paragraph","inlineContent":[{"identifier":"Interaction_Pinch","type":"image"}]},{"type":"heading","level":2,"anchor":"The-patch","text":"The patch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami drives this with an "},{"code":"origami.PopSwitch","type":"codeVoice"},{"type":"text","text":" — a remembered on\/off state — flipped by"},{"type":"text","text":" "},{"type":"text","text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight"},{"type":"text","text":" "},{"type":"text","text":"onto native SwiftUI, which is the reusable idea worth taking away. A "},{"code":"MagnifyGesture","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"reads the pinch, a "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" flag flips at a threshold, and a "},{"code":".spring","type":"codeVoice"},{"type":"text","text":" animates the"},{"type":"text","text":" "},{"type":"text","text":"scale between the two states (see the State\/memory → "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" row in"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","isActive":true},{"type":"text","text":")."}]},{"type":"codeListing","syntax":"swift","code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not"},{"type":"text","text":" "},{"type":"text","text":"a scale that tracks your fingers continuously."}]},{"type":"heading","level":2,"anchor":"How-its-built","text":"How it’s built"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The full view sits the white rounded triangle on the magenta artboard and adds a live"},{"type":"text","text":" "},{"code":"@GestureState","type":"codeVoice"},{"type":"text","text":" so the shape follows your fingers mid-pinch before it settles on the"},{"type":"text","text":" "},{"type":"text","text":"popped state. Read the source (below) for the whole thing."}]},{"type":"heading","level":2,"anchor":"Behavior","text":"Behavior"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pinch out on the shape to grow it; pinch in to shrink it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross the threshold and it snaps to the next size with a spring, rather than"},{"type":"text","text":" "},{"type":"text","text":"tracking your fingers continuously."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The switch remembers its state, so a release between pinches holds the current size."}]}]}]},{"type":"heading","level":2,"anchor":"Downloads","text":"Downloads"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Xcode sample"}]},{"type":"text","text":" — "},{"isActive":true,"type":"reference","identifier":"https:\/\/swamikit.github.io\/swami\/pr-290\/downloads\/Interaction_Pinch.zip"},{"type":"text","text":" — the runnable project (same as the button above)."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Swift source","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift"},{"type":"text","text":" — the single source file to read."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Origami source","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","isActive":true,"type":"reference"}]}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_pinch"]}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch","interfaceLanguage":"swift"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"anchor":"Patterns","title":"Patterns","generated":true}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"type":"reference","identifier":"https:\/\/swamikit.github.io\/swami\/pr-290\/downloads\/Interaction_Pinch.zip","overridingTitle":"Download Xcode sample","isActive":true}},"references":{"Interaction_Pinch.png":{"type":"image","identifier":"Interaction_Pinch.png","variants":[{"url":"\/images\/samatwork.Swami\/Interaction_Pinch.png","traits":["1x","light"]}],"alt":null},"doc://samatwork.Swami/documentation/Swami/OrigamiMappings":{"identifier":"doc:\/