ative)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Animation (Classic Animation, Pop \/ Spring)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"withAnimation","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".animation(.spring)","type":"codeVoice"},{"text":" (native)","type":"text"}]}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"type":"codeVoice","code":"View"},{"type":"text","text":" body."}]},{"level":2,"text":"How the categories map","type":"heading","anchor":"How-the-categories-map"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Pure value patches"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"Add","type":"codeVoice"},{"text":", interpolation, logic — carry no state. They run an","type":"text"},{"text":" ","type":"text"},{"text":"input through math and emit a result, which is exactly a computed property or an","type":"text"},{"text":" ","type":"text"},{"text":"inline expression.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Interaction","type":"text"}]},{"text":" exposes discrete outputs: ","type":"text"},{"code":"down","type":"codeVoice"},{"text":", ","type":"text"},{"code":"position","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onTap","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":". Each becomes a SwiftUI gesture whose result lands in","type":"text"},{"text":" ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" or fires a callback. The ","type":"text"},{"code":".interaction(…)","type":"codeVoice"},{"text":" modifier attaches only the","type":"text"},{"text":" ","type":"text"},{"text":"recognizers you ask for, so gesture arbitration stays clean.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State and memory"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"Switch"},{"type":"text","text":", "},{"type":"codeVoice","code":"Sample and Hold"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Switch"},{"type":"text","text":" — remember a value"},{"type":"text","text":" "},{"type":"text","text":"between evaluations. That is what "},{"type":"codeVoice","code":"@State"},{"text":" is for; the update path is a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, an ","type":"text"},{"code":".onChange","type":"codeVoice"},{"text":", or an assignment.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Animation"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":" — drives a value toward a"},{"type":"text","text":" "},{"type":"text","text":"target over time, which is a state change wrapped in "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an"},{"type":"text","text":" "},{"type":"codeVoice","code":".animation(_:value:)"},{"type":"text","text":" modifier."}]},{"type":"paragraph","inlineContent":[{"text":"One naming note: Origami’s ","type":"text"},{"type":"codeVoice","code":"Transition"},{"text":" means ","type":"text"},{"inlineContent":[{"text":"interpolation","type":"text"}],"type":"emphasis"},{"text":" (mapping one range","type":"text"},{"text":" ","type":"text"},{"text":"onto another), not SwiftUI’s ","type":"text"},{"type":"codeVoice","code":".transition()"},{"text":" modifier for view insertion and","type":"text"},{"text":" ","type":"text"},{"text":"removal.","type":"text"}]},{"level":2,"text":"When a mapping isn’t exact","type":"heading","anchor":"When-a-mapping-isnt-exact"},{"type":"paragraph","inlineContent":[{"text":"Some Origami semantics have no direct SwiftUI equivalent — continuous-time springs,","type":"text"},{"text":" ","type":"text"},{"text":"custom JavaScript patches, absolute-position layout. Rather than approximate them","type":"text"},{"text":" ","type":"text"},{"text":"silently, each translated view marks the gap with an inline ","type":"text"},{"type":"codeVoice","code":"TODO"},{"text":" in its source,","type":"text"},{"text":" ","type":"text"},{"text":"so the caveat travels with the code. The individual pattern pages link to the","type":"text"},{"text":" ","type":"text"},{"text":"source where those notes live.","type":"text"}]}],"kind":"content"}],"references":{"doc://samatwork.Swami/documentation/Swami/RoundedTriangle":{"url":"\/documentation\/swami\/roundedtriangle","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/RoundedTriangle","abstract":[{"text":"An upward-pointing triangle with uniformly rounded corners.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RoundedTriangle","kind":"identifier"}],"navigatorTitle":[{"text":"RoundedTriangle","kind":"identifier"}],"title":"RoundedTriangle"},"doc://samatwork.Swami/documentation/Swami":{"type":"topic","role":"collection","kind":"symbol","url":"\/documentation\/swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","title":"Swami","abstract":[{"text":"Origami patterns, rebuilt as SwiftUI you can read — each one a worked example of the","type":"text"},{"text":" ","type":"text"},{"text":"patches behind it, so you can see how a prototype’s behavior is written and reach for","type":"text"},{"text":" ","type":"text"},{"text":"the same patch on your own layers.","type":"text"}]}}}