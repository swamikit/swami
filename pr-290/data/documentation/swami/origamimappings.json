{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/origamimappings"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"},"metadata":{"role":"article","title":"Origami to SwiftUI reference","modules":[{"name":"Swami"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"abstract":[{"text":"What each Origami patch becomes in SwiftUI, so you know which construct — or which","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","isActive":true},{"text":" helper — to reach for.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI both describe how values flow and change over"},{"type":"text","text":" "},{"type":"text","text":"time, so the translations map onto SwiftUI’s own tools: computed properties for"},{"type":"text","text":" "},{"type":"text","text":"pure math, gestures and "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for interaction, "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" for motion. Most"},{"type":"text","text":" "},{"type":"text","text":"patches land on a native SwiftUI construct. A few need a helper from the "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","isActive":true},{"type":"text","text":" "},{"type":"text","text":"library, named after the patch it stands in for."}]},{"level":2,"text":"Patch → SwiftUI","type":"heading","anchor":"Patch-%E2%86%92-SwiftUI"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Origami patch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"paragraph"}]],[[