{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swami"}],"title":"Origami → SwiftUI reference"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origami’s patch graph and SwiftUI both describe how values flow and change over"},{"type":"text","text":" "},{"type":"text","text":"time, so the translations map onto SwiftUI’s own tools: computed properties for"},{"type":"text","text":" "},{"type":"text","text":"pure math, gestures and "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for interaction, "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" for motion. Most"},{"type":"text","text":" "},{"type":"text","text":"patches land on a native SwiftUI construct. A few need a helper from the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami"},{"type":"text","text":" "},{"type":"text","text":"library, named after the patch it stands in for."}]},{"level":2,"text":"Patch → SwiftUI","type":"heading","anchor":"Patch-%E2%86%92-SwiftUI"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Origami patch","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftUI"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Pure value patch (Add, interpolate, logic)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"computed property \/ expression (native)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Interaction (Tap, Press, Double Tap, Long Press)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"gesture + "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" via "},{"type":"codeVoice","code":"View\/interaction(down:position:onTap:onDoubleTap:onLongPress:)"},{"type":"text","text":" (helper)"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"origami.Drag","type":"codeVoice"},{"type":"text","text":" — Drag"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"drag(enable:momentum:bounds:position:translation:velocity:reset:)"},{"type":"text","text":" (helper)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Magnification \/ Pinch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"MagnifyGesture"},{"text":" (native)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"origami.PopSwitch"},{"text":" — Pop Switch","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"@State"},{"text":" flipped on a threshold, ","type":"text"},{"type":"codeVoice","code":".spring"},{"text":" pop (native)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"builtin.layer.shape"},{"type":"text","text":" — Shape (triangle)"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/RoundedTriangle","isActive":true,"type":"reference"},{"text":" (helper)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"State \/ memory (Switch, Sample and Hold)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"@State","type":"codeVoice"},{"text":" + update logic (native)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Animation (Classic Animation, Pop \/ Spring)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"withAnimation","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":".animation(.spring)","type":"codeVoice"},{"type":"text","text":" (native)"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Origami layer tree becomes the SwiftUI "},{"type":"codeVoice","code":"View"},{"type":"text","text":" body."}]},{"level":2,"type":"heading","text":"How the categories map","anchor":"How-the-categories-map"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Pure value patches","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"Add","type":"codeVoice"},{"text":", interpolation, logic — carry no state. They run an","type":"text"},{"text":" ","type":"text"},{"text":"input through math and emit a result, which is exactly a computed property or an","type":"text"},{"text":" ","type":"text"},{"text":"inline expression.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Interaction"}],"type":"strong"},{"type":"text","text":" exposes discrete outputs: "},{"type":"codeVoice","code":"down"},{"type":"text","text":", "},{"type":"codeVoice","code":"position"},{"type":"text","text":", "},{"type":"codeVoice","code":"onTap"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"onDoubleTap"},{"type":"text","text":", "},{"type":"codeVoice","code":"onLongPress"},{"type":"text","text":". Each becomes a SwiftUI gesture whose result lands in"},{"type":"text","text":" "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" or fires a callback. The "},{"type":"codeVoice","code":".interaction(…)"},{"type":"text","text":" modifier attaches only the"},{"type":"text","text":" "},{"type":"text","text":"recognizers you ask for, so gesture arbitration stays clean."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State and memory"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"Switch"},{"type":"text","text":", "},{"type":"codeVoice","code":"Sample and Hold"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Switch"},{"type":"text","text":" — remember a value"},{"type":"text","text":" "},{"type":"text","text":"between evaluations. That is what "},{"type":"codeVoice","code":"@State"},{"text":" is for; the update path is a gesture","type":"text"},{"text":" ","type":"text"},{"text":"callback, an ","type":"text"},{"code":".onChange","type":"codeVoice"},{"text":", or an assignment.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Animation"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"Classic Animation"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pop Animation"},{"type":"text","text":" — drives a value toward a"},{"type":"text","text":" "},{"type":"text","text":"target over time, which is a state change wrapped in "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":" or an"},{"type":"text","text":" "},{"type":"codeVoice","code":".animation(_:value:)"},{"text":" modifier.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One naming note: Origami’s "},{"type":"codeVoice","code":"Transition"},{"type":"text","text":" means "},{"type":"emphasis","inlineContent":[{"type":"text","text":"interpolation"}]},{"type":"text","text":" (mapping one range"},{"type":"text","text":" "},{"type":"text","text":"onto another), not SwiftUI’s "},{"type":"codeVoice","code":".transition()"},{"type":"text","text":" modifier for view insertion and"},{"type":"text","text":" "},{"type":"text","text":"removal."}]},{"text":"When a mapping isn’t exact","anchor":"When-a-mapping-isnt-exact","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Some Origami semantics have no direct SwiftUI equivalent — continuous-time springs,"},{"type":"text","text":" "},{"type":"text","text":"custom JavaScript patches, absolute-position layout. Rather than approximate them"},{"type":"text","text":" "},{"type":"text","text":"silently, each translated view marks the gap with an inline "},{"type":"codeVoice","code":"TODO"},{"type":"text","text":" in its source,"},{"type":"text","text":" "},{"type":"text","text":"so the caveat travels with the code. The individual pattern pages link to the"},{"type":"text","text":" "},{"type":"text","text":"source where those notes live."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swami\/origamimappings"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"What each Origami patch becomes in SwiftUI, so you know which construct — or which","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"reference"},{"text":" helper — to reach for.","type":"text"}],"sections":[],"references":{"doc://samatwork.Swami/documentation/Swami":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","type":"topic","title":"Swami","kind":"symbol","abstract":[{"text":"Origami patterns, rebuilt as SwiftUI you can read — each one a worked example of the","type":"text"},{"text":" ","type":"text"},{"text":"patches behind it, so you can see how a prototype’s behavior is written and reach for","type":"text"},{"text":" ","type":"text"},{"text":"the same patch on your own layers.","type":"text"}],"role":"collection"},"doc://samatwork.Swami/documentation/Swami/RoundedTriangle":{"abstract":[{"type":"text","text":"An upward-pointing triangle with uniformly rounded corners."}],"type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/RoundedTriangle","url":"\/documentation\/swami\/roundedtriangle","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"RoundedTriangle","kind":"identifier"}],"title":"RoundedTriangle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RoundedTriangle","kind":"identifier"}]}}}