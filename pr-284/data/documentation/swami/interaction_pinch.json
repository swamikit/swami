{"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Preview","type":"heading","anchor":"Preview"},{"inlineContent":[],"type":"paragraph"},{"level":2,"text":"The patch","type":"heading","anchor":"The-patch"},{"inlineContent":[{"type":"text","text":"Origami drives this with an "},{"type":"codeVoice","code":"origami.PopSwitch"},{"type":"text","text":" — a remembered on\/off state — flipped by"},{"type":"text","text":" "},{"type":"text","text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight"},{"type":"text","text":" "},{"type":"text","text":"onto native SwiftUI, which is the reusable idea worth taking away. A "},{"type":"codeVoice","code":"MagnifyGesture"},{"type":"text","text":" "},{"type":"text","text":"reads the pinch, a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" flag flips at a threshold, and a "},{"type":"codeVoice","code":".spring"},{"type":"text","text":" animates the"},{"type":"text","text":" "},{"type":"text","text":"scale between the two states (see the State\/memory → "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" row in"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","isActive":true},{"type":"text","text":")."}],"type":"paragraph"},{"code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not","type":"text"},{"text":" ","type":"text"},{"text":"a scale that tracks your fingers continuously.","type":"text"}],"type":"paragraph"},{"level":2,"text":"How it’s built","type":"heading","anchor":"How-its-built"},{"inlineContent":[{"type":"text","text":"The full view sits the white rounded triangle on the magenta artboard and adds a live"},{"type":"text","text":" "},{"type":"codeVoice","code":"@GestureState"},{"type":"text","text":" so the shape follows your fingers mid-pinch before it settles on the"},{"type":"text","text":" "},{"type":"text","text":"popped state. Read the source (below) for the whole thing."}],"type":"paragraph"},{"level":2,"text":"Behavior","type":"heading","anchor":"Behavior"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pinch out on the shape to grow it; pinch in to shrink it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross the threshold and it snaps to the next size with a spring, rather than"},{"type":"text","text":" "},{"type":"text","text":"tracking your fingers continuously."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The switch remembers its state, so a release between pinches holds the current size."}]}]}],"type":"unorderedList"},{"level":2,"text":"Downloads","type":"heading","anchor":"Downloads"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Swift sample"}]},{"text":" — ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift"},{"text":" — the full source. Read it to see how the pop maps to ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" + a spring; paste it to run it.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Origami source","type":"text"}]},{"text":" — ","type":"text"},{"type":"reference","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","isActive":true},{"text":" — the original prototype (opens in Origami Studio).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch"},"abstract":[{"type":"text","text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a"},{"type":"text","text":" "},{"type":"text","text":"spring; pinch back in and it pops home."}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"isActive":true,"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","overridingTitle":"Open in Origami","type":"reference"}},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_pinch"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"modules":[{"name":"Swami"}],"roleHeading":"Sample Code","role":"sampleCode","title":"Interaction — Pinch"},"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"anchor":"Patterns","title":"Patterns","generated":true}],"references":{"https://origami.design/public/origami_files/patterns/Interaction_Pinch.origami":{"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","type":"download","checksum":null,"url":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami"},"doc://samatwork.Swami/documentation/Swami":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","url":"\/documentation\/swami","type":"topic","title":"Swami","kind":"symbol","abstract":[{"text":"Origami patterns, rebuilt as SwiftUI you can read — each one a worked example of the","type":"text"},{"text":" ","type":"text"},{"text":"patches behind it, so you can see how a prototype’s behavior is written and reach for","type":"text"},{"text":" ","type":"text"},{"text":"the same patch on your own layers.","type":"text"}],"role":"collection"},"https://github.com/swamikit/swami/blob/development/app/Swami/Patterns/Interaction_Pinch.swift":{"titleInlineContent":[{"code":"Interaction_Pinch.swift","type":"codeVoice"}],"url":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","title":"Interaction_Pinch.swift","type":"link","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift"},"doc://samatwork.Swami/documentation/Swami/OrigamiMappings":{"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings","title":"Origami → SwiftUI reference","kind":"article","type":"topic","abstract":[{"type":"text","text":"What each Origami patch becomes in SwiftUI, so you know which construct — or which"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","isActive":true},{"type":"text","text":" helper — to reach for."}],"url":"\/documentation\/swami\/origamimappings","role":"article"},"doc://samatwork.Swami/documentation/Swami/Interaction_Drag":{"title":"Interaction — Drag","url":"\/documentation\/swami\/interaction_drag","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag","role":"sampleCode","abstract":[{"type":"text","text":"A card you can drag anywhere on screen. It carries momentum when you let go and"},{"type":"text","text":" "},{"type":"text","text":"springs back from the edges."}],"type":"topic","kind":"article"}}}