":"text"}]}]},{"content":[{"inlineContent":[{"code":"onTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onDoubleTap","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onLongPress","type":"codeVoice"},{"text":" — discrete pulses.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the gesture for an output you actually request is attached — so a tap-only layer"},{"type":"text","text":" "},{"type":"text","text":"carries only a tap recognizer (no stray drag), which keeps gesture arbitration clean."}]}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction"},"topicSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/body(content:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction\/ViewModifier-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction"}],"title":"Interaction","externalID":"s:5Swami11InteractionV","role":"symbol","modules":[{"name":"Swami"}],"navigatorTitle":[{"kind":"identifier","text":"Interaction"}],"symbolKind":"struct","roleHeading":"Structure"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Drag"],"generated":true,"title":"Helpers","anchor":"Helpers"}],"relationshipsSections":[{"identifiers":["doc:\/\/samatwork.Swami\/s8SendableP","doc:\/\/samatwork.Swami\/7SwiftUI12ViewModifierP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"references":{"doc://samatwork.Swami/documentation/Swami":{"type":"topic","role":"collection","title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","abstract