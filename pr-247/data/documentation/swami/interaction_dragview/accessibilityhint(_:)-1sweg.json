ier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"title":"Interaction_DragView","kind":"symbol","type":"topic","url":"\/documentation\/swami\/interaction_dragview","role":"symbol"}}}