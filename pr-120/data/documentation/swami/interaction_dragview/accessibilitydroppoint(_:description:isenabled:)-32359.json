"kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:Sy","text":"StringProtocol","kind":"typeIdentifier"}],"languages":["swift"]}]}],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"navigatorTitle":[{"kind":"identifier","text":"Interaction_DragView"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","role":"symbol","type":"topic","url":"\/documentation\/swami\/interaction_dragview","abstract":[{"text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable","type":"text"},{"text":" ","type":"text"},{"text":"card responds to touch input via Origami’s ","type":"text"},{"code":"origami.Drag","type":"codeVoice"},{"text":" patch, which wires its","type":"text"},{"text":" ","type":"text"},{"text":"output ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" to the layer’s transform. When released near the center, the","type":"text"},{"text":" ","type":"text"},{"text":"card snaps back to its resting position.","type":"text"}],"title":"Interaction_DragView","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Interaction_DragView"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityDropPoint(_:description:isEnabled:)-32359":{"kind":"symbol","title":"accessibilityDropPoint(_:description:isEnabled:)","abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/accessibilitydroppoint(_:description:isenabled:)-32359","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityDropPoint","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"UnitPoint","preciseIdentifier":"s:7SwiftUI9UnitPointV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"description","kind":"externalParam"}