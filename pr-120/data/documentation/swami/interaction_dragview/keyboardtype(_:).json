per library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","kind":"symbol","title":"Swami","role":"collection"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/keyboardType(_:)":{"role":"symbol","type":"topic","kind":"symbol","title":"keyboardType(_:)","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/keyboardType(_:)","url":"\/documentation\/swami\/interaction_dragview\/keyboardtype(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"keyboardType"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"UIKeyboardType","preciseIdentifier":"c:@E@UIKeyboardType"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"abstract":[]}}}