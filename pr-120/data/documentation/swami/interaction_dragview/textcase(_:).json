deprecated":false,"name":"iPadOS","unavailable":false,"beta":false,"introducedAt":"14.0"},{"deprecated":false,"name":"Mac Catalyst","unavailable":false,"beta":false,"introducedAt":"14.0"},{"deprecated":false,"name":"macOS","unavailable":false,"beta":false,"introducedAt":"11.0"},{"deprecated":false,"name":"tvOS","unavailable":false,"beta":false,"introducedAt":"14.0"},{"deprecated":false,"name":"watchOS","unavailable":false,"beta":false,"introducedAt":"7.0"}],"role":"symbol","extendedModule":"SwiftUICore"},"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"View.textCase(_:)"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami","doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://samatwork.Swami/documentation/Swami":{"role":"collection","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"topic","title":"Swami","url":"\/documentation\/swami","kind":"symbol","abstract":[{"text":"An Origami → SwiftUI translator: a deterministic parser reads Facebook’s ","type":"text"},{"type":"codeVoice","code":".origami"},{"text":" ","type":"text"},{"text":"patch graph into a semantic IR, and a codegen writes that IR out as SwiftUI. Swami","type":"text"},{"text":" ","type":"text"},{"text":"is also the patch-matched helper library that fills gaps between Origami patches","type":"text"},{"text":" ","type":"text"},{"text":"and native SwiftUI — one helper per Origami patch, named after the patch, sized by","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against","type":"text"},{"text":" ","type":"text"},{"text":"Origami’s own render, and shipped as a DocC-embedded example.","type":"text"}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/textCase(_:)":{"abstract":[],"url":"\/documentation\/swami\/interaction_dragview\