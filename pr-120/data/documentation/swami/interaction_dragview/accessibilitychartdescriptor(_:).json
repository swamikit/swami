rified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"url":"\/documentation\/swami\/interaction_dragview","kind":"symbol","title":"Interaction_DragView","type":"topic","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}]},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/accessibilityChartDescriptor(_:)":{"url":"\/documentation\/swami\/interaction_dragview\/accessibilitychartdescriptor(_:)","type":"topic","title":"accessibilityChartDescriptor(_:)","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibilityChartDescriptor"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_D