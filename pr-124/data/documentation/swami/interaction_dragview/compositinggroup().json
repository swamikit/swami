ed by"},{"type":"text","text":" "},{"type":"text","text":"Origami’s patch surface. Every pattern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"topic","role":"collection","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/compositingGroup()":{"type":"topic","url":"\/documentation\/swami\/interaction_dragview\/compositinggroup()","role":"symbol","title":"compositingGroup()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compositingGroup","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"kind":"symbol","abstract":[],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/compositingGroup()"}}}