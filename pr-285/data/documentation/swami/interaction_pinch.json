{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swami\/interaction_pinch"]}],"metadata":{"title":"Interaction — Pinch","modules":[{"name":"Swami"}],"roleHeading":"Sample Code","role":"sampleCode"},"seeAlsoSections":[{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Drag"],"anchor":"Patterns","generated":true,"title":"Patterns"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Preview","text":"Preview"},{"type":"paragraph","inlineContent":[]},{"type":"heading","level":2,"anchor":"The-patch","text":"The patch"},{"type":"paragraph","inlineContent":[{"text":"Origami drives this with an ","type":"text"},{"code":"origami.PopSwitch","type":"codeVoice"},{"text":" — a remembered on\/off state — flipped by","type":"text"},{"text":" ","type":"text"},{"text":"a pinch and fed into a Transform Scale. There’s no helper to reach for: it maps straight","type":"text"},{"text":" ","type":"text"},{"text":"onto native SwiftUI, which is the reusable idea worth taking away. A ","type":"text"},{"code":"MagnifyGesture","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reads the pinch, a ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" flag flips at a threshold, and a ","type":"text"},{"code":".spring","type":"codeVoice"},{"text":" animates the","type":"text"},{"text":" ","type":"text"},{"text":"scale between the two states (see the State\/memory → ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" row in","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/OrigamiMappings"},{"text":").","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@State private var popped = false","","RoundedTriangle(cornerRadius: 20)","    .frame(width: 90, height: 80)","    .scaleEffect(popped ? 2 : 1)","    .animation(.spring(response: 0.35, dampingFraction: 0.7), value: popped)","    .gesture(","        MagnifyGesture().onEnded { value in","            if value.magnification > 1.25 { popped = true }","            else if value.magnification < 0.8 { popped = false }","        }","    )"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pop is the point: a discrete state the gesture toggles, animated with a spring — not"},{"type":"text","text":" "},{"type":"text","text":"a scale that tracks your fingers continuously."}]},{"type":"heading","level":2,"anchor":"How-its-built","text":"How it’s built"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The full view sits the white rounded triangle on the magenta artboard and adds a live"},{"type":"text","text":" "},{"type":"codeVoice","code":"@GestureState"},{"type":"text","text":" so the shape follows your fingers mid-pinch before it settles on the"},{"type":"text","text":" "},{"type":"text","text":"popped state. Read the source (below) for the whole thing."}]},{"type":"heading","level":2,"anchor":"Behavior","text":"Behavior"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Pinch out on the shape to grow it; pinch in to shrink it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross the threshold and it snaps to the next size with a spring, rather than"},{"type":"text","text":" "},{"type":"text","text":"tracking your fingers continuously."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The switch remembers its state, so a release between pinches holds the current size."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Downloads","text":"Downloads"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Xcode sample","type":"text"}]},{"type":"text","text":" — "},{"type":"reference","identifier":"https:\/\/swamikit.github.io\/swami\/pr-285\/downloads\/Interaction_Pinch.zip","isActive":true},{"type":"text","text":" — the runnable project (same as the button above)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Swift source"}]},{"type":"text","text":" — "},{"type":"reference","identifier":"https:\/\/github.com\/swamikit\/swami\/blob\/development\/app\/Swami\/Patterns\/Interaction_Pinch.swift","isActive":true},{"type":"text","text":" — the single source file to read."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Origami source"}]},{"type":"text","text":" — "},{"type":"reference","isActive":true,"identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami"}],"type":"paragraph"}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/samatwork.Swami\/documentation\/Swami"]]},"sections":[],"sampleCodeDownload":{"kind":"sampleDownload","action":{"isActive":true,"overridingTitle":"Download Xcode sample","type":"reference","identifier":"https:\/\/swamikit.github.io\/swami\/pr-285\/downloads\/Interaction_Pinch.zip"}},"kind":"article","identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_Pinch","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Pinch a shape to scale it. Past a threshold it pops to an enlarged size with a"},{"type":"text","text":" "},{"type":"text","text":"spring; pinch back in and it pops home."}],"references":{"https://origami.design/public/origami_files/patterns/Interaction_Pinch.origami":{"type":"link","identifier":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","url":"https:\/\/origami.design\/public\/origami_files\/patterns\/Interaction_Pinch.origami","title":"Interaction_Pinch.origami","titleInlineContent":[{"type":"codeVoice","code":"Inte