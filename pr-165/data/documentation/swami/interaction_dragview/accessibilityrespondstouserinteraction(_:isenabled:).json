le":"SwiftUICore","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityRespondsToUserInteraction","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"isEnabled","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"text":"ModifiedContent","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI15ModifiedContentV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"AccessibilityAttachmentModifier","preciseIdentifier":"s:7SwiftUI31AccessibilityAttachmentModifierV"},{"kind":"text","text":">"}],"platforms":[{"introducedAt":"18.0","unavailable":false,"beta":false,"name":"iOS","deprecated":false},{"introducedAt":"18.0","unavailable":false,"beta":false,"name":"iPadOS","deprecated":false},{"introducedAt":"18.0","unavailable":false,"beta":false,"name":"Mac Catalyst","deprecated":false},{"introducedAt":"15.0","unavailable":false,"beta":false,"name":"macOS","deprecated":false},{"introducedAt":"18.0","unavailable":false,"beta":false,"name":"tvOS","deprecated":false},{"introducedAt":"2.0","unavailable":false,"beta":false,"name":"visionOS","deprecated":false},{"introducedAt":"11.0","unavailable":false,"beta":false,"name":"watchOS","deprecated":false}],"symbolKind":"method","role":"symbol"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/accessibilityRespondsToUserInteraction(_:isEnabled:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card