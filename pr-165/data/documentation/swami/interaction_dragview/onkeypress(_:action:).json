ern that lands is a deliverable, verified against"},{"type":"text","text":" "},{"type":"text","text":"Origami’s own render, and shipped as a DocC-embedded example."}],"role":"collection","url":"\/documentation\/swami","title":"Swami","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami","type":"topic","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView":{"abstract":[{"type":"text","text":"Drags a layer in any direction with momentum and rubber-band bounds. The draggable"},{"type":"text","text":" "},{"type":"text","text":"card responds to touch input via Origami’s "},{"type":"codeVoice","code":"origami.Drag"},{"type":"text","text":" patch, which wires its"},{"type":"text","text":" "},{"type":"text","text":"output "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" to the layer’s transform. When released near the center, the"},{"type":"text","text":" "},{"type":"text","text":"card snaps back to its resting position."}],"role":"symbol","url":"\/documentation\/swami\/interaction_dragview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Interaction_DragView","kind":"identifier"}],"navigatorTitle":[{"text":"Interaction_DragView","kind":"identifier"}],"identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView","title":"Interaction_DragView","type":"topic","kind":"symbol"},"doc://samatwork.Swami/documentation/Swami/Interaction_DragView/onKeyPress(_:action:)":{"abstract":[],"url":"\/documentation\/swami\/interaction_dragview\/onkeypress(_:action:)","title":"onKeyPress(_:action:)","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/samatwork.Swami\/documentation\/Swami\/Interaction_DragView\/onKeyPress(_:action:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onKeyPress","kind":"identifier"},{"text":"(","kind":"text"},{"text":"KeyEquivalent","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI13KeyEquivalentV"},{"